From 67bcba31f45057ea0281c18bfa82f718a551244f Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:02:20 -0500
Subject: [PATCH 1/3] ASoC: qcom: audioreach: send large parameter records out of
 band

The SP and SP VI static cfg blobs are sent as in-band SET_CFGs. A record
whose packet exceeds 2048 bytes, such as the 6.2 kB filter table of
HP's SP tuning, does not fit the ADSP glink intents. Send such a record
alone through q6apm_set_cfg_oob(); records stay in blob order and
smaller ones go out as before.

Factor the sending out of the SP path so other module blobs can use it.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c | 75 +++++++++++++++++++++++--------
 1 file changed, 57 insertions(+), 18 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 4127316b09d1..aa3dd0ab3672 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -2583,6 +2583,12 @@ static int audioreach_sp_vi_send_r0t0(struct q6apm_graph *graph,
 /* Keep each SET_CFG small; a larger single parameter is sent on its own */
 #define AR_SP_CFG_MAX_CHUNK_BYTES	512
 
+/*
+ * Largest in-band SET_CFG packet, headers included. The ADSP glink intents
+ * top out around 2.2 kB; a larger parameter goes through shared memory.
+ */
+#define AR_CFG_INLINE_MAX_PKT_BYTES	2048
+
 static int audioreach_speaker_protection_send_chunk(struct q6apm_graph *graph,
 						    const char *tag,
 						    const void *data, int size,
@@ -2695,13 +2701,58 @@ static u32 audioreach_sp_blob_kernel_pid(const u8 *packed, u32 total)
 	return 0;
 }
 
+/*
+ * Send the records of a blob checked by audioreach_sp_cfg_walk() in blob
+ * order, packed into SET_CFGs of up to AR_SP_CFG_MAX_CHUNK_BYTES; a record
+ * too large on its own goes through shared memory. Records are never split.
+ */
+static int audioreach_cfg_records_send(struct q6apm_graph *graph,
+				       const struct audioreach_module *module,
+				       const char *tag, const u32 *word,
+				       u32 num_words, int total)
+{
+	u32 pos = 0;
+	int rc = 0, chunk = 0;
+
+	u8 *packed __free(kfree) = kmalloc(total, GFP_KERNEL);
+	if (!packed)
+		return -ENOMEM;
+
+	while (pos < num_words && !rc) {
+		const struct apm_module_param_data *pd = (const void *)packed;
+		int bytes = audioreach_sp_cfg_walk(word, num_words, module->instance_id,
+						   pos, &pos, packed,
+						   AR_SP_CFG_MAX_CHUNK_BYTES);
+		if (bytes <= 0)
+			return bytes ? bytes : -EINVAL;
+
+		if (GPR_HDR_SIZE + APM_CMD_HDR_SIZE + bytes <= AR_CFG_INLINE_MAX_PKT_BYTES) {
+			rc = audioreach_speaker_protection_send_chunk(graph, tag, packed,
+								      bytes, chunk++);
+			continue;
+		}
+
+		/* Only a lone record exceeds the chunk size */
+		rc = q6apm_set_cfg_oob(graph->apm, packed, bytes);
+		if (rc)
+			dev_err(graph->dev, "%s cfg blob: param 0x%08x (%u bytes) out of band failed: %d\n",
+				tag, pd->param_id, pd->param_size, rc);
+		else
+			dev_dbg(graph->dev, "%s cfg blob: param 0x%08x (%u bytes) sent out of band\n",
+				tag, pd->param_id, pd->param_size);
+		chunk++;
+	}
+
+	return rc;
+}
+
 static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *graph,
 							 const struct audioreach_module *module,
 							 const char *tag)
 {
-	u32 size, num_words, pos = 0;
+	u32 size, num_words;
 	const u32 *word;
-	int total, rc = 0, chunk = 0;
+	int total;
 
 	if (!module->data || !module->data->size) {
 		dev_err(graph->dev, "%s module 0x%x has no static cfg blob\n",
@@ -2733,13 +2784,12 @@ static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *gra
 		return total;
 	}
 
-	u8 *packed __free(kfree) = kmalloc(total, GFP_KERNEL);
-	if (!packed)
-		return -ENOMEM;
-
 	if (audioreach_sp_isolated()) {
+		u8 *packed __free(kfree) = kmalloc(total, GFP_KERNEL);
 		u32 pid;
 
+		if (!packed)
+			return -ENOMEM;
 		if (audioreach_sp_cfg_walk(word, num_words, module->instance_id, 0,
 					   NULL, packed, U32_MAX) != total)
 			return -EINVAL;
@@ -2751,18 +2801,7 @@ static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *gra
 		}
 	}
 
-	while (pos < num_words && !rc) {
-		int bytes = audioreach_sp_cfg_walk(word, num_words, module->instance_id,
-						   pos, &pos, packed,
-						   AR_SP_CFG_MAX_CHUNK_BYTES);
-		if (bytes <= 0)
-			return bytes ? bytes : -EINVAL;
-
-		rc = audioreach_speaker_protection_send_chunk(graph, tag, packed, bytes,
-							      chunk++);
-	}
-
-	return rc;
+	return audioreach_cfg_records_send(graph, module, tag, word, num_words, total);
 }
 
