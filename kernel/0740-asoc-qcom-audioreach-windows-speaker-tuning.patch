From 149e1b1c586bc06402d525bed3cfa92312cfd6b4 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:02:20 -0500
Subject: [PATCH 2/3] ASoC: qcom: audioreach: send MSPP, SAL and channel mixer
 parameter blobs

Only SP, SP VI and SMECNS modules get their topology cfg blob. The
speaker chain of Windows laptops such as the HP OmniBook Ultra 14 needs
blobs for more modules, so send them for an allowlist, each limited to
its parameters: MSPP v5 (any), SAL (limiter static cfg and threshold),
MFC and the channel mixer (CHMIXER_COEFF, CHMIXER_OUT_CH_CFG).

Records must address the module's own instance and lie within the
blob; a blob outside these rules fails the graph prepare instead of
leaving the module on defaults. Blobs on the MFCs around SP RX, and
while protection or the high-pass is required on any module after SP
RX, are refused.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c | 159 ++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/audioreach.h |  10 ++
 sound/soc/qcom/qdsp6/topology.c   |   1 +
 3 files changed, 170 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index aa3dd0ab3672..ad5c564a4ddb 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -3228,6 +3228,149 @@ static bool audioreach_sg_contains_sp_vi(const struct audioreach_sub_graph *sg)
 	return false;
 }
 
+/* Does @module take SP RX output, through any number of single links? */
+static bool audioreach_downstream_of_sp_rx(const struct audioreach_module *module)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m, *next;
+	int hops;
+
+	if (!module->container || !module->container->sub_graph ||
+	    !module->container->sub_graph->info)
+		return false;
+
+	list_for_each_entry(sg, &module->container->sub_graph->info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				if (m->module_id != MODULE_ID_SPEAKER_PROTECTION)
+					continue;
+				for (next = audioreach_only_successor(m), hops = 0;
+				     next && hops < 16;
+				     next = audioreach_only_successor(next), hops++)
+					if (next == module)
+						return true;
+			}
+
+	return false;
+}
+
+/*
+ * Modules whose topology blob is sent as parameter records, and what each
+ * may set. An MSPP blob is HP's whole configuration of that module.
+ */
+static bool audioreach_blob_param_allowed(u32 module_id, u32 param_id)
+{
+	switch (module_id) {
+	case MODULE_ID_MSPP_V5:
+		return true;
+	case MODULE_ID_SAL:
+		return param_id == PARAM_ID_SAL_LIMITER_STATIC_CFG ||
+		       param_id == PARAM_ID_SAL_LIMITER_CFG;
+	case MODULE_ID_MFC:
+		return param_id == PARAM_ID_CHMIXER_COEFF;
+	case MODULE_ID_CHMIXER:
+		return param_id == PARAM_ID_CHMIXER_COEFF ||
+		       param_id == PARAM_ID_CHMIXER_OUT_CH_CFG;
+	default:
+		return false;
+	}
+}
+
+/*
+ * Send an allowlisted module's blob: records addressing only the module, each
+ * an allowed parameter, in blob order. Anything else fails the graph.
+ */
+static int audioreach_module_blob_cfg(struct q6apm_graph *graph,
+				      const struct audioreach_module *module)
+{
+	u32 size, num_words, pos = 0;
+	const u32 *word;
+	int total;
+
+	if (module->data_invalid) {
+		dev_err(graph->dev, "module 0x%x (0x%08x) cfg blob failed to load from the topology\n",
+			module->instance_id, module->module_id);
+		return -EINVAL;
+	}
+	if (!module->data || !module->data->size)
+		return 0;
+
+	/* SP and the tweeter high-pass must be the last word on the speakers */
+	if (audioreach_sp_isolated() && audioreach_downstream_of_sp_rx(module)) {
+		dev_err(graph->dev, "module 0x%x (0x%08x) after SP RX carries a cfg blob; refusing\n",
+			module->instance_id, module->module_id);
+		return -EPERM;
+	}
+
+	size = le32_to_cpu(module->data->size);
+	word = (const u32 *)module->data->data;
+	num_words = size / sizeof(u32);
+
+	if (size % sizeof(u32) || !num_words || word[0] != module->instance_id) {
+		dev_err(graph->dev, "module 0x%x (0x%08x) cfg blob is not its own parameter records; refusing\n",
+			module->instance_id, module->module_id);
+		return -EINVAL;
+	}
+
+	total = audioreach_sp_cfg_walk(word, num_words, module->instance_id, 0,
+				       NULL, NULL, U32_MAX);
+	if (total <= 0) {
+		dev_err(graph->dev, "module 0x%x (0x%08x) cfg blob is malformed\n",
+			module->instance_id, module->module_id);
+		return -EINVAL;
+	}
+
+	u8 *packed __free(kfree) = kmalloc(total, GFP_KERNEL);
+	if (!packed)
+		return -ENOMEM;
+	if (audioreach_sp_cfg_walk(word, num_words, module->instance_id, 0,
+				   NULL, packed, U32_MAX) != total)
+		return -EINVAL;
+
+	while (pos < total) {
+		const struct apm_module_param_data *pd = (const void *)(packed + pos);
+
+		if (!audioreach_blob_param_allowed(module->module_id, pd->param_id)) {
+			dev_err(graph->dev, "module 0x%x (0x%08x) cfg blob sets param 0x%08x; refusing\n",
+				module->instance_id, module->module_id, pd->param_id);
+			return -EPERM;
+		}
+		pos += APM_MODULE_PARAM_DATA_SIZE + ALIGN(pd->param_size, 8);
+	}
+
+	return audioreach_cfg_records_send(graph, module, "module", word, num_words, total);
+}
+
+/* Does @module feed SP RX (through at most one MSIIR), or take SP RX output? */
+static bool audioreach_mfc_is_sp_rx_neighbour(const struct audioreach_module *module)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	unsigned int pn;
+
+	if (audioreach_feeds_sp_rx(module))
+		return true;
+	if (!module->container || !module->container->sub_graph ||
+	    !module->container->sub_graph->info)
+		return false;
+
+	list_for_each_entry(sg, &module->container->sub_graph->info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				u32 nports = min_t(u32, m->max_op_port, AR_MAX_MOD_LINKS);
+
+				if (m->module_id != MODULE_ID_SPEAKER_PROTECTION)
+					continue;
+				for (pn = 0; pn < nports; pn++)
+					if (m->dst_mod_inst_id[pn] == module->instance_id)
+						return true;
+			}
+
+	return false;
+}
+
 int audioreach_set_media_format(struct q6apm_graph *graph,
 				const struct audioreach_module *module,
 				const struct audioreach_module_config *cfg)
@@ -3285,6 +3428,8 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 		rc = audioreach_sal_set_media_format(graph, module, cfg);
 		if (!rc)
 			rc = audioreach_sal_limiter_enable(graph, module, true);
+		if (!rc)
+			rc = audioreach_module_blob_cfg(graph, module);
 		break;
 	case MODULE_ID_MSIIR: {
 		const struct audioreach_module *next = audioreach_only_successor(module);
@@ -3296,6 +3441,14 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 		break;
 	}
 	case MODULE_ID_MFC:
+		/* The MFCs around SP RX fix the speaker order; no blob may remix them */
+		if (module->data && module->data->size &&
+		    audioreach_mfc_is_sp_rx_neighbour(module)) {
+			dev_err(graph->dev, "SP RX: MFC 0x%x next to SP carries a cfg blob; refusing\n",
+				module->instance_id);
+			rc = -EINVAL;
+			break;
+		}
 		if (audioreach_feeds_sp_rx(module)) {
 			struct audioreach_module_config sp_cfg;
 
@@ -3305,6 +3458,12 @@ int audioreach_set_media_format(struct q6apm_graph *graph,
 			break;
 		}
 		rc = audioreach_mfc_set_media_format(graph, module, cfg);
+		if (!rc)
+			rc = audioreach_module_blob_cfg(graph, module);
+		break;
+	case MODULE_ID_CHMIXER:
+	case MODULE_ID_MSPP_V5:
+		rc = audioreach_module_blob_cfg(graph, module);
 		break;
 	case MODULE_ID_GAPLESS:
 		rc = audioreach_gapless_set_media_format(graph, module, cfg);
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index d80d52b902d3..02c04591be64 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -40,6 +40,8 @@ struct thermal_zone_device;
 #define MODULE_ID_OPUS_DEC		0x07001174
 #define MODULE_ID_AUDIO_IF_SINK		0x0700117C
 #define MODULE_ID_AUDIO_IF_SOURCE	0x0700117D
+#define MODULE_ID_CHMIXER		0x07001013
+#define MODULE_ID_MSPP_V5		0x0701000D
 
 #define APM_CMD_GET_SPF_STATE		0x01001021
 #define APM_CMD_RSP_GET_SPF_STATE	0x02001007
@@ -806,6 +808,12 @@ struct param_id_sal_limiter_enable {
 	uint32_t enable_lim;
 } __packed;
 
+#define PARAM_ID_SAL_LIMITER_STATIC_CFG		0x08001047
+#define PARAM_ID_CHMIXER_COEFF			0x0800101F
+#define PARAM_ID_CHMIXER_OUT_CH_CFG		0x0800103B
+#define PARAM_ID_SAL_LIMITER_CFG		0x08001050
+#define PARAM_ID_MSPP_CFG			0x0800137B
+
 #define PARAM_ID_MFC_OUTPUT_MEDIA_FORMAT	0x08001024
 #define PARAM_ID_EARLY_EOS_DELAY		0x0800114C
 #define EARLY_EOS_DELAY_MS			150
@@ -1074,6 +1082,8 @@ struct audioreach_module {
 	struct audioreach_container *container;
 	struct snd_soc_dapm_widget *widget;
 	struct audioreach_module_priv_data *data;
+	/* The topology had a cfg blob for the module that could not be loaded */
+	bool data_invalid;
 };
 
