+static int audioreach_mspp_volume_set(struct q6apm *apm,
+				      const struct audioreach_module *mspp, u32 q28)
+{
+	struct apm_module_param_data *param_data;
+	struct param_id_mspp_volume *vol;
+	int size = APM_MODULE_PARAM_DATA_SIZE + sizeof(*vol);
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	param_data = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	param_data->module_instance_id = mspp->instance_id;
+	param_data->error_code = 0;
+	param_data->param_id = PARAM_ID_MSPP_VOLUME;
+	param_data->param_size = sizeof(*vol);
+
+	vol = (void *)param_data + APM_MODULE_PARAM_DATA_SIZE;
+	vol->vol_lin_gain_q28 = q28;
+	vol->reserved = 0;
+
+	return q6apm_send_cmd_sync(apm, pkt, 0);
+}
+
+static struct audioreach_graph_info *
+audioreach_module_graph_info(const struct audioreach_module *module)
+{
+	if (!module->container || !module->container->sub_graph)
+		return NULL;
+	return module->container->sub_graph->info;
+}
+
+static unsigned int audioreach_graph_count_modules(const struct audioreach_graph_info *info,
+						   u32 module_id, bool vol_db_only)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	unsigned int n = 0;
+
+	list_for_each_entry(sg, &info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node)
+				if (m->module_id == module_id && (!vol_db_only || m->vol_db))
+					n++;
+
+	return n;
+}
+
+/* VOL_CTRL first, then the same gain to each MSPP: the Windows driver order */
+static int audioreach_vol_db_send(struct q6apm *apm, const struct audioreach_module *vol,
+				  const struct audioreach_graph_info *info, u32 step)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	u32 q28 = ar_vol_db_q28[step];
+	int rc;
+
+	lockdep_assert_held(&apm->vol_lock);
+
+	rc = audioreach_gain_set_vol_ctrl(apm, vol, DIV_ROUND_CLOSEST(q28, 1U << 15));
+	if (rc) {
+		dev_err(apm->dev, "VOL_CTRL 0x%x: gain step %u failed: %d\n",
+			vol->instance_id, step, rc);
+		return rc;
+	}
+
+	/* Without whole tokens a late answer could confirm the wrong write */
+	if (apm->narrow_tokens)
+		return 0;
+
+	list_for_each_entry(sg, &info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				if (m->module_id != MODULE_ID_MSPP_V5)
+					continue;
+				rc = audioreach_mspp_volume_set(apm, m, q28);
+				if (rc) {
+					dev_err(apm->dev, "MSPP 0x%x: volume 0x%08x failed: %d\n",
+						m->instance_id, q28, rc);
+					return rc;
+				}
+			}
+
+	return 0;
+}
+
+static int audioreach_vol_db_send_all(struct q6apm *apm,
+				      const struct audioreach_graph_info *info)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	int rc;
+
+	list_for_each_entry(sg, &info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				if (m->module_id != MODULE_ID_VOL_CTRL || !m->vol_db)
+					continue;
+				rc = audioreach_vol_db_send(apm, m, info, m->vol_step);
+				if (rc)
+					return rc;
+			}
+
+	return 0;
+}
+
+/*
+ * Neither the requested nor the confirmed volume is known to be in place:
+ * mute VOL_CTRL until the next prepare. If the mute fails too, the volume is
+ * faulted and the returned graph (referenced) must be torn down outside
+ * vol_lock.
+ */
+static struct audioreach_graph *
+audioreach_vol_db_lost(struct q6apm *apm, struct audioreach_module *vol,
+		       struct audioreach_graph_info *info)
+{
+	int rc;
+
+	lockdep_assert_held(&apm->vol_lock);
+
+	info->vol_live = false;
+	rc = audioreach_gain_set_vol_ctrl(apm, vol, 0);
+	if (!rc) {
+		dev_err(apm->dev, "VOL_CTRL 0x%x: volume unknown, muted until the next prepare\n",
+			vol->instance_id);
+		return NULL;
+	}
+
+	info->vol_faulted = true;
+	dev_err(apm->dev, "VOL_CTRL 0x%x: volume unknown and mute failed (%d); stopping graph %u\n",
+		vol->instance_id, rc, info->id);
+
+	/* Live under vol_lock, so the instance in the DSP is the one written to */
+	return q6apm_graph_get_live(apm, info->id);
+}
+
+/**
+ * audioreach_vol_db_set() - request a dB volume step
+ * @apm: the APM
+ * @vol: VOL_CTRL module with the dB volume control
+ * @step: requested step
+ *
+ * @vol->vol_step is the confirmed step. While the graph is live, @step is
+ * confirmed only once VOL_CTRL and every MSPP took it; on failure the
+ * confirmed step is resent, then VOL_CTRL is muted, then the graph is torn
+ * down and writes are refused until the next prepare.
+ *
+ * Return: 1 if the confirmed step changed, 0 if not, or a negative error code.
+ */
+int audioreach_vol_db_set(struct q6apm *apm, struct audioreach_module *vol, u32 step)
+{
+	struct audioreach_graph_info *info = audioreach_module_graph_info(vol);
+	struct audioreach_graph *fault = NULL;
+	int rc;
+
+	if (step > AR_VOL_DB_STEPS)
+		return -EINVAL;
+
+	scoped_guard(mutex, &apm->vol_lock) {
+		if (info && info->vol_faulted)
+			return -EIO;
+
+		if (vol->vol_step == step)
+			return 0;
+
+		if (!info || !info->vol_live) {
+			vol->vol_step = step;
+			return 1;
+		}
+
+		rc = audioreach_vol_db_send(apm, vol, info, step);
+		if (!rc) {
+			vol->vol_step = step;
+			return 1;
+		}
+
+		if (audioreach_vol_db_send(apm, vol, info, vol->vol_step))
+			fault = audioreach_vol_db_lost(apm, vol, info);
+		else
+			dev_err(apm->dev, "VOL_CTRL 0x%x: step %u refused, kept step %u\n",
+				vol->instance_id, step, vol->vol_step);
+	}
+
+	if (fault)
+		q6apm_graph_fault(fault, "dB volume");
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(audioreach_vol_db_set);
+
+/* Send the stored dB volume step again, if the graph is open in the DSP */
+int audioreach_vol_db_replay(struct q6apm *apm, struct audioreach_module *vol)
+{
+	struct audioreach_graph_info *info = audioreach_module_graph_info(vol);
+	struct audioreach_graph *fault = NULL;
+	int rc;
+
+	scoped_guard(mutex, &apm->vol_lock) {
+		if (!info || !info->vol_live)
+			return 0;
+
+		rc = audioreach_vol_db_send(apm, vol, info, vol->vol_step);
+		if (rc)
+			fault = audioreach_vol_db_lost(apm, vol, info);
+	}
+
+	if (fault)
+		q6apm_graph_fault(fault, "dB volume");
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(audioreach_vol_db_replay);
+
+/* At graph prepare, after every module is configured: send the stored volume */
+int audioreach_vol_db_graph_apply(struct q6apm_graph *graph)
+{
+	struct audioreach_graph_info *info = graph->info;
+	struct q6apm *apm = graph->apm;
+	unsigned int n;
+	int rc;
+
+	guard(mutex)(&apm->vol_lock);
+
+	n = audioreach_graph_count_modules(info, MODULE_ID_VOL_CTRL, true);
+	if (!n)
+		return 0;
+	/* MSPP takes one volume */
+	if (n > 1 && audioreach_graph_count_modules(info, MODULE_ID_MSPP_V5, false)) {
+		dev_err(graph->dev, "graph %d: %u dB volume controls in a graph with MSPP; refusing\n",
+			info->id, n);
+		return -EINVAL;
+	}
+
+	info->vol_live = false;
+	rc = audioreach_vol_db_send_all(apm, info);
+	if (!rc) {
+		info->vol_live = true;
+		info->vol_faulted = false;
+	}
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(audioreach_vol_db_graph_apply);
+
+void audioreach_vol_db_graph_closed(struct q6apm *apm, struct audioreach_graph_info *info)
+{
+	guard(mutex)(&apm->vol_lock);
+	info->vol_live = false;
+}
+EXPORT_SYMBOL_GPL(audioreach_vol_db_graph_closed);
