From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:02:20 -0500
Subject: [PATCH] ASoC: qcom: x1e80100: drive every SP speaker on the WSA RX
 back end

The WSA RX back end takes the front end's channel count, so a stereo
stream left the codec DMA and the SP graph with two channels for four
speakers.

With speaker protection required, pin the back end to the SP speaker
count and map its slots for it, so stereo is split onto the speaker
lanes in the DSP, as on Windows. Add audioreach_sp_num_speakers().

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c |  7 +++++++
 sound/soc/qcom/qdsp6/audioreach.h |  1 +
 sound/soc/qcom/x1e80100.c         | 12 +++++++++++-
 3 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 4d714169e837..2f14ae333cef 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -1834,6 +1834,13 @@ int audioreach_sp_register_speaker_map(struct thermal_zone_device * const *tzs,
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_register_speaker_map);
 
+/* The number of speakers in the registered speaker map (0 before it is set) */
+unsigned int audioreach_sp_num_speakers(void)
+{
+	return sp_speaker_map.num;
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_num_speakers);
+
 /* SP runs only on @num speakers registered in lane order */
 static bool audioreach_sp_speakers_match(unsigned int num)
 {
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 023c120754ea..3eb1f8760e04 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -1183,6 +1183,7 @@ int audioreach_get_sp_vi_t0(long *vals, unsigned int count);
 void audioreach_sp_set_required(bool required);
 void audioreach_sp_set_r0t0_from_uefi(bool enable, u32 r0_min_uohm, u32 r0_max_uohm);
 bool audioreach_sp_required(void);
+unsigned int audioreach_sp_num_speakers(void);
 void audioreach_sp_set_hpf_speakers(u32 speakers);
 int audioreach_sp_session_begin(struct q6apm_graph *graph);
 int audioreach_sp_session_end(struct q6apm_graph *graph, int rc);
diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index 6bdc65a7b8b1..cefac8b97ad5 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -241,6 +241,13 @@ static int x1e80100_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 
 	rate->min = rate->max = 48000;
 	switch (cpu_dai->id) {
+	case WSA_CODEC_DMA_RX_0:
+		/* SP drives every speaker; the DSP spreads stereo onto them */
+		if (audioreach_sp_required() && audioreach_sp_num_speakers()) {
+			channels->min = audioreach_sp_num_speakers();
+			channels->max = audioreach_sp_num_speakers();
+		}
+		break;
 	case TX_CODEC_DMA_TX_0:
 	case TX_CODEC_DMA_TX_1:
 	case TX_CODEC_DMA_TX_2:
@@ -328,7 +335,10 @@ static int x1e80100_snd_prepare(struct snd_pcm_substream *substream)
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
-	unsigned int channels = substream->runtime->channels;
+	/* The back end shares the front end's runtime; SP pins this link's channels */
+	unsigned int channels = (cpu_dai->id == WSA_CODEC_DMA_RX_0 && audioreach_sp_required() &&
+				 audioreach_sp_num_speakers()) ?
+				audioreach_sp_num_speakers() : substream->runtime->channels;
 	unsigned int rx_slot[4];
 	int ret;
 
