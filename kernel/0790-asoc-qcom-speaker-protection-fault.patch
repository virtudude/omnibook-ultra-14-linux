From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Fri, 13 Nov 2026 09:17:47 -0500
Subject: [PATCH 1/2] ASoC: qcom: audioreach: latch a speaker protection fault

A failed dB volume write leaves VOL_CTRL and MSPP at unknown, possibly
mismatched gains while the graph keeps playing, and nothing outside the
DSP stops the amplifiers.

Raise a protection fault there: bump a fault generation and call a
notifier chain so the machine driver switches the amplifiers off and
stops the streams without the DSP. The fault stays pending until the
driver reports that done, or is cleared at once if no handler takes
it. A fault during a WSA RX graph's setup fails
it, and while SP is required the WSA RX graph cannot start with a fault
pending, or unless its last setup configured both SP modules with no
fault since. Failing the CPU DAI trigger keeps the link's codec DAIs
muted.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c       | 105 +++++++++++++++++++++++-
 sound/soc/qcom/qdsp6/audioreach.h       |  11 +++
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c |   6 ++
 3 files changed, 119 insertions(+), 3 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 05e000bb7024..c0f5059d77b2 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -4,6 +4,7 @@
 #include <linux/efi.h>
 #include <linux/kernel.h>
 #include <linux/mutex.h>
+#include <linux/notifier.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/apr.h>
 #include <linux/thermal.h>
@@ -68,6 +69,14 @@ static bool sp_required;
 /* Speakers (speaker map order) whose SP RX input must be high-passed */
 static u32 sp_hpf_speakers;
 
+/* Protects sp_fault_gen and sp_fault_pending */
+static DEFINE_MUTEX(sp_fault_lock);
+/* Bumped by every protection fault */
+static unsigned int sp_fault_gen;
+/* The machine driver has not yet switched the speakers off */
+static bool sp_fault_pending;
+static BLOCKING_NOTIFIER_HEAD(sp_fault_chain);
+
 /* SubGraph Config */
 struct apm_sub_graph_data {
 	struct apm_sub_graph_cfg sub_graph_cfg;
@@ -1640,8 +1649,8 @@ static int audioreach_vol_db_send(struct q6apm *apm, const struct audioreach_mod
  *
  * While the graph is open in the DSP, the step is sent to VOL_CTRL and every
  * MSPP of the graph and kept only if all took it. A failed write leaves the
- * gains unknown: the graph takes no more writes until its next setup, which
- * sends the kept step again.
+ * gains unknown: it raises a protection fault, and the graph takes no more
+ * writes until its next setup, which sends the kept step again.
  *
  * Return: 1 if the step changed, 0 if not, or a negative error code.
  */
@@ -1665,6 +1674,9 @@ int audioreach_vol_db_set(struct q6apm *apm, struct audioreach_module *vol, u32
 		info->vol_live = false;
 	}
 
+	/* The speakers may play at mismatched gains: off until a new setup */
+	audioreach_sp_fault(apm->dev, "dB volume");
+
 	return rc;
 }
 EXPORT_SYMBOL_GPL(audioreach_vol_db_set);
@@ -1930,8 +1942,10 @@ static int audioreach_sp_check_graph(struct q6apm_graph *graph);
  */
 int audioreach_sp_session_begin(struct q6apm_graph *graph)
 {
-	int rc = audioreach_sp_check_graph(graph);
+	int rc;
 
+	graph->sp.protected = false;
+	rc = audioreach_sp_check_graph(graph);
 	if (rc)
 		return rc;
 
@@ -1939,11 +1953,88 @@ int audioreach_sp_session_begin(struct q6apm_graph *graph)
 		.active = true,
 		.mode = READ_ONCE(sp_operation_mode),
 	};
+	scoped_guard(mutex, &sp_fault_lock)
+		graph->sp.fault_gen = sp_fault_gen;
 
 	return 0;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_begin);
 
+/**
+ * audioreach_sp_fault() - a live graph failed, the speakers are unprotected
+ * @dev: device for the log
+ * @what: what failed
+ *
+ * The DSP state is unknown, so no WSA RX graph set up before now counts as
+ * protected, and the fault notifier chain is called, for the machine driver
+ * to switch the amplifiers off and stop the streams, then call
+ * audioreach_sp_fault_done(). Until then the WSA RX graph cannot start.
+ * Process context.
+ */
+void audioreach_sp_fault(struct device *dev, const char *what)
+{
+	unsigned int gen;
+
+	scoped_guard(mutex, &sp_fault_lock) {
+		gen = ++sp_fault_gen;
+		sp_fault_pending = true;
+	}
+
+	dev_err(dev, "SP: protection fault (%s): speakers off until a checked WSA RX graph is set up\n",
+		what);
+	if (blocking_notifier_call_chain(&sp_fault_chain, 0, NULL) == NOTIFY_DONE)
+		audioreach_sp_fault_done(gen);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_fault);
+
+/* Is a fault pending? @gen gets the latest one's generation */
+bool audioreach_sp_fault_pending(unsigned int *gen)
+{
+	guard(mutex)(&sp_fault_lock);
+
+	*gen = sp_fault_gen;
+	return sp_fault_pending;
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_fault_pending);
+
+/* The speakers are off after fault @gen; a newer fault stays pending */
+void audioreach_sp_fault_done(unsigned int gen)
+{
+	guard(mutex)(&sp_fault_lock);
+
+	if (gen == sp_fault_gen)
+		sp_fault_pending = false;
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_fault_done);
+
+int audioreach_sp_register_fault_notifier(struct notifier_block *nb)
+{
+	return blocking_notifier_chain_register(&sp_fault_chain, nb);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_register_fault_notifier);
+
+void audioreach_sp_unregister_fault_notifier(struct notifier_block *nb)
+{
+	blocking_notifier_chain_unregister(&sp_fault_chain, nb);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_unregister_fault_notifier);
+
+/**
+ * audioreach_sp_rx_may_start() - may the WSA RX graph start?
+ * @graph: the graph
+ *
+ * With speaker protection required, only if its last setup configured both
+ * SP modules and no protection fault came since.
+ */
+bool audioreach_sp_rx_may_start(struct q6apm_graph *graph)
+{
+	guard(mutex)(&sp_fault_lock);
+
+	return !READ_ONCE(sp_required) ||
+	       (graph->sp.protected && graph->sp.fault_gen == sp_fault_gen && !sp_fault_pending);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_rx_may_start);
+
 /**
  * audioreach_sp_session_end() - finish the SP setup of a WSA RX graph
  * @graph: the graph
@@ -1972,6 +2063,14 @@ int audioreach_sp_session_end(struct q6apm_graph *graph, int rc)
 		dev_err(dev, "SP: speaker protection is required and this graph has no SP RX/VI; refusing\n");
 		return -EPERM;
 	}
+
+	guard(mutex)(&sp_fault_lock);
+	if (sp_fault_gen != sp->fault_gen) {
+		dev_err(dev, "SP: protection fault during setup; refusing\n");
+		return -EPERM;
+	}
+	sp->protected = sp->rx_ok;
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_end);
