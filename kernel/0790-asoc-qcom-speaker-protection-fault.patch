From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 23:20:56 -0500
Subject: [PATCH 2/2] ASoC: qcom: x1e80100: switch the speakers off on a protection
 fault

After a speaker protection fault the DSP state is unknown, so it cannot
be trusted to silence the speakers, and the prepared SoundWire V/I
ports keep the amplifiers' V/I guards satisfied.

With SP required, handle the fault notifier from a work item: mute
every speaker amplifier DAI, then, under the card's PCM mutex, stop the
PCM front ends feeding the WSA RX back end with an XRUN and mute again
under the back end's stream lock, which also silences a compressed
front end and any start that passed its check just before the fault,
and report the fault handled. The PCM
mutex keeps a recovering prepare from running before the last mute.
The amplifiers come back only through a WSA RX prepare that passes the
protection checks.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/x1e80100.c | 139 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 137 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index 9163c9563cfb..62e1016cd9bf 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -7,11 +7,13 @@
 #include <linux/platform_device.h>
 #include <linux/soundwire/sdw.h>
 #include <linux/thermal.h>
+#include <linux/workqueue.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include <sound/jack.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
+#include <sound/soc-dpcm.h>
 
 #include "common.h"
 #include "qdsp6/audioreach.h"
@@ -40,6 +42,11 @@ struct x1e80100_snd_data {
 	struct x1e80100_sp_link sp;
 	/* The speakers run at their DT operating point */
 	bool op_point;
+	/* Speaker protection faults: amplifiers off, streams stopped */
+	struct snd_soc_pcm_runtime *sp_rtd;
+	struct notifier_block sp_fault_nb;
+	struct work_struct sp_fault_work;
+	bool sp_fault_registered;
 };
 
 /*
@@ -126,11 +133,136 @@ static int x1e80100_register_sp_speakers(struct snd_soc_pcm_runtime *rtd)
 	return audioreach_sp_register_speaker_map(tzs, names, num, lane_order);
 }
 
+/*
+ * Switch every speaker amplifier's PA off through its DAI mute, which needs
+ * no DSP. A V/I guarded WSA884x reads the PA enable back and fails if it is
+ * still set, and retries the PA off write until it succeeds.
+ */
+static int x1e80100_sp_amps_off(struct x1e80100_snd_data *data)
+{
+	struct snd_soc_pcm_runtime *rtd = data->sp_rtd;
+	struct snd_soc_dai *dai;
+	unsigned int k;
+	int i, ret, err = 0;
+
+	for_each_rtd_codec_dais(rtd, i, dai) {
+		if (!snd_soc_dai_get_pcm_stream(dai, SNDRV_PCM_STREAM_PLAYBACK)->channels_min)
+			continue;
+		for (k = 0; k < data->sp.num_amps; k++)
+			if (dai->component == data->sp.amp[k])
+				break;
+		if (k == data->sp.num_amps)
+			continue;
+
+		ret = snd_soc_dai_digital_mute(dai, 1, SNDRV_PCM_STREAM_PLAYBACK);
+		if (ret) {
+			dev_err(rtd->dev, "SP fault: %s PA off not confirmed: %d\n",
+				dai->component->name_prefix ?: dev_name(dai->dev), ret);
+			err = ret;
+		}
+	}
+
+	return err;
+}
+
+static void x1e80100_sp_fault_work(struct work_struct *work)
+{
+	struct x1e80100_snd_data *data = container_of(work, struct x1e80100_snd_data,
+						      sp_fault_work);
+	struct snd_soc_pcm_runtime *rtd = data->sp_rtd;
+	struct snd_pcm_substream *be = snd_soc_dpcm_get_substream(rtd, SNDRV_PCM_STREAM_PLAYBACK);
+	struct snd_soc_dpcm *dpcm;
+	unsigned int gen;
+	int ret;
+
+	/* Handled by an earlier run, and maybe recovered since */
+	if (!audioreach_sp_fault_pending(&gen))
+		return;
+
+	/* The amplifiers first: a stream lock may be held across a DSP command */
+	x1e80100_sp_amps_off(data);
+
+	/* Held to the end, so that no recovering prepare runs before the last mute */
+	snd_soc_dpcm_mutex_lock(rtd);
+	for_each_dpcm_fe(rtd, SNDRV_PCM_STREAM_PLAYBACK, dpcm)
+		snd_pcm_stop_xrun(snd_soc_dpcm_get_substream(dpcm->fe,
+							     SNDRV_PCM_STREAM_PLAYBACK));
+
+	/*
+	 * Again, behind any BE start that passed its check before the fault,
+	 * whatever its front end (a compressed one is not stopped above). Only
+	 * a nonatomic front end can start this BE, which makes it nonatomic.
+	 */
+	if (be->pcm->nonatomic) {
+		guard(pcm_stream_lock_irq)(be);
+		ret = x1e80100_sp_amps_off(data);
+	} else {
+		ret = x1e80100_sp_amps_off(data);
+	}
+	audioreach_sp_fault_done(gen);
+	snd_soc_dpcm_mutex_unlock(rtd);
+
+	if (!ret)
+		dev_warn(rtd->dev, "SP fault: speaker PAs off, streams stopped\n");
+}
+
+static int x1e80100_sp_fault_notify(struct notifier_block *nb, unsigned long action,
+				    void *unused)
+{
+	struct x1e80100_snd_data *data = container_of(nb, struct x1e80100_snd_data,
+						      sp_fault_nb);
+
+	queue_work(system_highpri_wq, &data->sp_fault_work);
+
+	return NOTIFY_OK;
+}
+
+static int x1e80100_sp_fault_register(struct snd_soc_card *card)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	unsigned int k;
+	int ret;
+
+	if (data->sp_fault_registered || !data->sp_rtd || !data->sp.num_amps ||
+	    !audioreach_sp_required())
+		return 0;
+
+	for (k = 0; k < data->sp.num_amps; k++)
+		if (!of_property_read_bool(data->sp.amp[k]->dev->of_node, "qcom,vi-guard"))
+			dev_warn(card->dev, "%s has no V/I guard: its PA off on a protection fault is not read back\n",
+				 dev_name(data->sp.amp[k]->dev));
+
+	data->sp_fault_nb.notifier_call = x1e80100_sp_fault_notify;
+	ret = audioreach_sp_register_fault_notifier(&data->sp_fault_nb);
+	if (ret)
+		return ret;
+	data->sp_fault_registered = true;
+
+	return 0;
+}
+
+static void x1e80100_sp_fault_unregister(struct x1e80100_snd_data *data)
+{
+	unsigned int gen;
+
+	if (!data->sp_fault_registered)
+		return;
+
+	audioreach_sp_unregister_fault_notifier(&data->sp_fault_nb);
+	cancel_work_sync(&data->sp_fault_work);
+	/* Torn down with the card, which powered the speakers down */
+	if (audioreach_sp_fault_pending(&gen))
+		audioreach_sp_fault_done(gen);
+	data->sp_fault_registered = false;
+}
+
 static void x1e80100_snd_exit(struct snd_soc_pcm_runtime *rtd)
 {
 	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
 
 	if (snd_soc_rtd_to_cpu(rtd, 0)->id == WSA_CODEC_DMA_RX_0) {
+		x1e80100_sp_fault_unregister(data);
+		data->sp_rtd = NULL;
 		audioreach_sp_register_speaker_map(NULL, NULL, 0, false);
 		audioreach_sp_set_hpf_speakers(0);
 		audioreach_sp_set_full_scale(NULL, 0);
@@ -325,8 +457,9 @@ static int x1e80100_snd_late_probe(struct snd_soc_card *card)
 	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
 	int ret;
 
-	if (!data->op_point)
-		return 0;
+	ret = x1e80100_sp_fault_register(card);
+	if (ret || !data->op_point)
+		return ret;
 
 	/* The DAPM mux controls only exist once the widgets do */
 	ret = snd_soc_dapm_new_widgets(card);
@@ -359,6 +492,7 @@ static int x1e80100_snd_init(struct snd_soc_pcm_runtime *rtd)
 		ret = x1e80100_register_sp_speakers(rtd);
 		if (ret)
 			return ret;
+		data->sp_rtd = rtd;
 		data->op_point = x1e80100_op_wanted(data);
 		fallthrough;
 	case WSA_CODEC_DMA_RX_1:
@@ -614,6 +748,7 @@ static int x1e80100_platform_probe(struct platform_device *pdev)
 	if (!data)
 		return -ENOMEM;
 
+	INIT_WORK(&data->sp_fault_work, x1e80100_sp_fault_work);
 	card->owner = THIS_MODULE;
 	card->dev = dev;
 	dev_set_drvdata(dev, card);
