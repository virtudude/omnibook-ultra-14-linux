From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Thu, 12 Nov 2026 11:22:12 -0500
Subject: [PATCH] usb: dwc3: tell xhci-plat when the core was reinitialised on
 resume

With wakeup disabled, a host-mode system suspend exits the core and
resume reinitialises it, so the xHCI state may be lost. xhci-plat
restores the saved state regardless, and the xHCI can resume with
stale ring pointers. On Qualcomm Glymur that faults on the SMMU and the
host controller is declared dead, taking the webcam behind the
USB2-only controller with it.

Set xhci-plat's power_lost flag when dwc3 reinitialised the core, as
cdns3 does, so xhci_resume() reinitialises the xHCI, and clear it when
the core stayed powered. Unlike XHCI_RESET_ON_RESUME, this costs
nothing on resumes that keep the state and leaves runtime PM alone.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/usb/dwc3/core.c |  2 ++
 drivers/usb/dwc3/core.h |  3 +++
 drivers/usb/dwc3/host.c | 21 ++++++++++++++++++---
 3 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index 372737f4750b..a750ff3f651c 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -2639,8 +2639,10 @@ static int dwc3_resume_common(struct dwc3 *dwc, pm_message_t msg)
 			if (ret)
 				return ret;
 			dwc3_set_prtcap(dwc, DWC3_GCTL_PRTCAP_HOST, true);
+			dwc3_host_set_power_lost(dwc, true);
 			break;
 		}
+		dwc3_host_set_power_lost(dwc, false);
 		/* Restore GUSB2PHYCFG bits that were modified in suspend */
 		for (i = 0; i < dwc->num_usb2_ports; i++) {
 			reg = dwc3_readl(dwc, DWC3_GUSB2PHYCFG(i));
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index f3dabb37f806..fae2ee72644e 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1677,11 +1677,14 @@ static inline void dwc3_pre_run_stop(struct dwc3 *dwc, bool is_on)
 #if IS_ENABLED(CONFIG_USB_DWC3_HOST) || IS_ENABLED(CONFIG_USB_DWC3_DUAL_ROLE)
 int dwc3_host_init(struct dwc3 *dwc);
 void dwc3_host_exit(struct dwc3 *dwc);
+void dwc3_host_set_power_lost(struct dwc3 *dwc, bool lost);
 #else
 static inline int dwc3_host_init(struct dwc3 *dwc)
 { return 0; }
 static inline void dwc3_host_exit(struct dwc3 *dwc)
 { }
+static inline void dwc3_host_set_power_lost(struct dwc3 *dwc, bool lost)
+{ }
 #endif
 
 #if IS_ENABLED(CONFIG_USB_DWC3_GADGET) || IS_ENABLED(CONFIG_USB_DWC3_DUAL_ROLE)
diff --git a/drivers/usb/dwc3/host.c b/drivers/usb/dwc3/host.c
index c5674161b2b0..a7c87e0c2fbc 100644
--- a/drivers/usb/dwc3/host.c
+++ b/drivers/usb/dwc3/host.c
@@ -14,9 +14,7 @@
 #include <linux/usb/hcd.h>
 #include <linux/bitfield.h>
 
-#include "../host/xhci-port.h"
-#include "../host/xhci-ext-caps.h"
-#include "../host/xhci-caps.h"
+#include "../host/xhci.h"
 #include "../host/xhci-plat.h"
 #include "core.h"
 
@@ -233,3 +231,20 @@ void dwc3_host_exit(struct dwc3 *dwc)
 	dwc->xhci = NULL;
 }
 EXPORT_SYMBOL_GPL(dwc3_host_exit);
+
+/*
+ * Tell xhci-plat whether the xHCI state survived system suspend. When dwc3
+ * reinitialised the core on resume, the xHCI registers are back at their
+ * reset values and must not be restored from the saved state.
+ */
+void dwc3_host_set_power_lost(struct dwc3 *dwc, bool lost)
+{
+	struct usb_hcd *hcd;
+
+	if (!dwc->xhci)
+		return;
+
+	hcd = platform_get_drvdata(dwc->xhci);
+	if (hcd)
+		hcd_to_xhci_priv(hcd)->power_lost = lost;
+}
