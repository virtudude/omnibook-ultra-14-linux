# HP OmniBook Ultra 14-kg0xxx (Glymur, board 8F03).
# Merge on top of a distro arm64 config or defconfig:
#   scripts/kconfig/merge_config.sh -m .config omnibook.config && make olddefconfig

# SoC: clocks, pinctrl, interconnect, power domains
CONFIG_ARCH_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_CLK_GLYMUR_GCC=y
CONFIG_CLK_GLYMUR_TCSRCC=y
CONFIG_CLK_GLYMUR_DISPCC=m
CONFIG_CLK_GLYMUR_GPUCC=m
CONFIG_CLK_GLYMUR_VIDEOCC=m
CONFIG_PINCTRL_GLYMUR=y
CONFIG_PINCTRL_LPASS_LPI=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_GLYMUR=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y

# CPU frequency over SCMI. The CPUCP mailbox must be a module: built in,
# it resets the board at random.
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_TRANSPORT_MAILBOX=y
CONFIG_ARM_SCMI_CPUFREQ=m
CONFIG_QCOM_CPUCP_MBOX=m

# UEFI variables through QSEECOM (also the speaker calibration)
CONFIG_QCOM_SCM=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_QSEECOM_UEFISECAPP=y
CONFIG_EFIVAR_FS=y

# Battery, charger, USB-C, RTC
CONFIG_QCOM_PMIC_GLINK=m
CONFIG_BATTERY_QCOM_BATTMGR=m
CONFIG_RTC_DRV_QCOM_TAD=m
CONFIG_TYPEC_UCSI=m
CONFIG_UCSI_PMIC_GLINK=m

# SoC power telemetry
CONFIG_POWERCAP=y
CONFIG_QCOM_SPEL=y

# USB and PCIe
CONFIG_USB_DWC3_QCOM=m
CONFIG_PHY_QCOM_M31_EUSB=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=m
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_QMP_USB=m
CONFIG_PHY_QCOM_QMP_PCIE=m
CONFIG_PCIE_QCOM=y
CONFIG_PCI_PWRCTRL_PWRSEQ=m

# Crypto engine. Without a driver for its node, the interconnects never
# reach sync_state and keep their boot votes.
CONFIG_CRYPTO_DEV_QCE=m

# GPU and display
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DP=y
CONFIG_PHY_QCOM_EDP=m
CONFIG_DRM_PANEL_SAMSUNG_ATNA33XC20=m

# Video decode (iris). The firmware is authenticated through an SHM bridge.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE=y

# Wi-Fi and Bluetooth (WCN7850)
CONFIG_ATH12K=m
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=m
CONFIG_BT_HCIUART_QCA=y

# Keyboard and touchpad
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_HID_OF=m
CONFIG_HID_MULTITOUCH=m

# Embedded controller: fan speed, EC thermistors, keyboard backlight, mute LEDs, hotkeys
CONFIG_EC_HP_OMNIBOOK=m

# Audio: ADSP, AudioReach, SoundWire, WSA884x amplifiers, LPASS macros
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_FASTRPC=m
CONFIG_QCOM_APR=m
CONFIG_SOUNDWIRE=m
CONFIG_SOUNDWIRE_QCOM=m
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_X1E80100=m
CONFIG_SND_SOC_WSA884X=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_TOPOLOGY=y
CONFIG_THERMAL_OF=y
