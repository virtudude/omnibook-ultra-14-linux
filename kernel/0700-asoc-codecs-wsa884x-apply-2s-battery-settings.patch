From 2ec7830c861a1ddcdaf1841067331f273db22ef7 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Mon, 9 Nov 2026 19:30:54 -0500
Subject: [PATCH] ASoC: codecs: wsa884x: apply 2S battery settings when the amp
 reports 2S

The driver programs Qualcomm's 1S battery settings on every board, but
VPHX_SYS_EN_STATUS reports the amplifier's battery stacking, and on 2S
laptops (Surface Pro 11, HP OmniBook Ultra 14) it reads 0x2.

Read it at init and, for 2S, apply what Qualcomm's downstream driver
does for CONFIG_2S: its reg_init_2S DAC VCM and class-H values, OCP
LOWVBAT_ITH_EN cleared, a 0x11 PBR boost current limit, the PBR
thresholds of its G_21_DB/2S/8 Ohm column and the VPHX_SYS_EN bits of
ANA_WO_CTL_0. 1S boards are unchanged; an unknown status keeps 1S with
a warning, and a failed read or write fails the amplifier init.

Based on Jens Glathe's Surface Pro 11 change, without its 4 Ohm load
settings.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/codecs/wsa884x.c | 127 ++++++++++++++++++++++++++++++++++---
 1 file changed, 117 insertions(+), 10 deletions(-)

diff --git a/sound/soc/codecs/wsa884x.c b/sound/soc/codecs/wsa884x.c
index 38c428c9a0aa..7deaa4833351 100644
--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -159,6 +159,7 @@
 #define WSA884X_BBM_CTL			(WSA884X_ANA_SPK_TOP_BASE + 0x28)
 #define WSA884X_TOP_MISC1		(WSA884X_ANA_SPK_TOP_BASE + 0x29)
 #define WSA884X_DAC_VCM_CTRL_REG7	(WSA884X_ANA_SPK_TOP_BASE + 0x2a)
+#define WSA884X_DAC_VCM_CTRL_REG7_FINAL_OVERRIDE_MASK	0x02
 #define WSA884X_TOP_BIAS_REG5		(WSA884X_ANA_SPK_TOP_BASE + 0x2b)
 #define WSA884X_DRV_LF_MISC_CTL2	(WSA884X_ANA_SPK_TOP_BASE + 0x2c)
 #define WSA884X_SPK_TOP_SPARE_TUNE_2	(WSA884X_ANA_SPK_TOP_BASE + 0x2d)
@@ -441,7 +442,9 @@
 #define WSA884X_CLSH_CTL_0_INPUT_EN_SHIFT		1
 #define WSA884X_CLSH_CTL_0_CLSH_EN_SHIFT		0
 #define WSA884X_CLSH_CTL_1		(WSA884X_DIG_CTRL0_BASE + 0xd1)
+#define WSA884X_CLSH_CTL_1_SLR_MAX_MASK			0xf0
 #define WSA884X_CLSH_V_HD_PA		(WSA884X_DIG_CTRL0_BASE + 0xd2)
+#define WSA884X_CLSH_V_HD_PA_V_HD_PA_MASK		0x1f
 #define WSA884X_CLSH_V_PA_MIN		(WSA884X_DIG_CTRL0_BASE + 0xd3)
 #define WSA884X_CLSH_OVRD_VAL		(WSA884X_DIG_CTRL0_BASE + 0xd4)
 #define WSA884X_CLSH_HARD_MAX		(WSA884X_DIG_CTRL0_BASE + 0xd5)
@@ -472,6 +475,8 @@
 #define WSA884X_DIG_CTRL1_BASE		(WSA884X_BASE + 0x0500)
 #define WSA884X_DIG_CTRL1_PAGE		(WSA884X_DIG_CTRL1_BASE + 0x00)
 #define WSA884X_VPHX_SYS_EN_STATUS	(WSA884X_DIG_CTRL1_BASE + 0x01)
+#define WSA884X_VPHX_SYS_EN_STATUS_1S	0x1
+#define WSA884X_VPHX_SYS_EN_STATUS_2S	0x2
 #define WSA884X_ANA_WO_CTL_0		(WSA884X_DIG_CTRL1_BASE + 0x04)
 #define WSA884X_ANA_WO_CTL_0_MODE_SHIFT		0
 #define WSA884X_ANA_WO_CTL_0_VPHX_SYS_EN_MASK			0xc0
@@ -767,6 +772,8 @@ struct wsa884x_priv {
 	struct mutex vi_guard_lock;
 	struct delayed_work vi_guard_work;
 	struct dentry *debugfs;
+	/* Battery stacking reported by VPHX_SYS_EN_STATUS */
+	unsigned int supply_cfg;
 };
 
 #define WSA884X_VI_GUARD_PERIOD_MS	20
@@ -1414,10 +1421,6 @@ static const struct reg_sequence wsa884x_reg_init[] = {
 			     FIELD_PREP_CONST(WSA884X_BOP2_PROG_BOP2_HYST_MASK, 0x6) },
 	{ WSA884X_REF_CTRL, (0xd2 & ~WSA884X_REF_CTRL_BG_RDY_SEL_MASK) |
 			    FIELD_PREP_CONST(WSA884X_REF_CTRL_BG_RDY_SEL_MASK, 0x1) },
-	/*
-	 * Downstream suggests for batteries different than 1-Stacked (1S):
-	 * { WSA884X_TOP_CTRL1, 0xd3 & ~WSA884X_TOP_CTRL1_OCP_LOWVBAT_ITH_EN_MASK },
-	 */
 	{ WSA884X_STB_CTRL1, (0x42 & ~WSA884X_STB_CTRL1_SLOPE_COMP_CURRENT_MASK) |
 			     FIELD_PREP_CONST(WSA884X_STB_CTRL1_SLOPE_COMP_CURRENT_MASK, 0xd) },
 	{ WSA884X_CURRENT_LIMIT, (0x54 & ~WSA884X_CURRENT_LIMIT_CURRENT_LIMIT_MASK) |
@@ -1483,6 +1486,93 @@ static const struct reg_sequence wsa884x_reg_init[] = {
 	{ WSA884X_OTP_REG_40, FIELD_PREP_CONST(WSA884X_OTP_REG_40_ISENSE_RESCAL_MASK, 0x8) },
 };
 
+/*
+ * Qualcomm downstream settings for a 2S battery, on top of wsa884x_reg_init[];
+ * the 8 Ohm load and G_21_DB system gain stay as they are.
+ */
+static const struct reg_sequence wsa884x_reg_init_2s[] = {
+	{ WSA884X_DAC_VCM_CTRL_REG2, 0x06 },
+	{ WSA884X_DAC_VCM_CTRL_REG3, 0x14 },
+	{ WSA884X_DAC_VCM_CTRL_REG4, 0x19 },
+	{ WSA884X_DAC_VCM_CTRL_REG5, 0x1b },
+	{ WSA884X_DAC_VCM_CTRL_REG6, 0x1c },
+	/* PBR thresholds for G_21_DB system gain, battery 2S, rload 8 Ohms */
+	{ WSA884X_CLSH_VTH1, WSA884X_VTH_TO_REG(1098), },
+	{ WSA884X_CLSH_VTH2, WSA884X_VTH_TO_REG(1161), },
+	{ WSA884X_CLSH_VTH3, WSA884X_VTH_TO_REG(1224), },
+	{ WSA884X_CLSH_VTH4, WSA884X_VTH_TO_REG(1278), },
+	{ WSA884X_CLSH_VTH5, WSA884X_VTH_TO_REG(1341), },
+	{ WSA884X_CLSH_VTH6, WSA884X_VTH_TO_REG(1380), },
+	{ WSA884X_CLSH_VTH7, WSA884X_VTH_TO_REG(1420), },
+	{ WSA884X_CLSH_VTH8, WSA884X_VTH_TO_REG(1482), },
+	{ WSA884X_CLSH_VTH9, WSA884X_VTH_TO_REG(1522), },
+	{ WSA884X_CLSH_VTH10, WSA884X_VTH_TO_REG(1600), },
+	{ WSA884X_CLSH_VTH11, WSA884X_VTH_TO_REG(1686), },
+	{ WSA884X_CLSH_VTH12, WSA884X_VTH_TO_REG(1765), },
+	{ WSA884X_CLSH_VTH13, WSA884X_VTH_TO_REG(1843), },
+	{ WSA884X_CLSH_VTH14, WSA884X_VTH_TO_REG(1922), },
+	{ WSA884X_CLSH_VTH15, WSA884X_VTH_TO_REG(2000), },
+};
+
+static int wsa884x_apply_supply_config(struct wsa884x_priv *wsa884x)
+{
+	struct regmap *regmap = wsa884x->regmap;
+	int ret;
+
+	if (wsa884x->supply_cfg != WSA884X_VPHX_SYS_EN_STATUS_2S)
+		return 0;
+
+	ret = regmap_multi_reg_write(regmap, wsa884x_reg_init_2s,
+				     ARRAY_SIZE(wsa884x_reg_init_2s));
+	if (!ret)
+		ret = regmap_update_bits(regmap, WSA884X_DAC_VCM_CTRL_REG7,
+					 WSA884X_DAC_VCM_CTRL_REG7_FINAL_OVERRIDE_MASK,
+					 WSA884X_DAC_VCM_CTRL_REG7_FINAL_OVERRIDE_MASK);
+	if (!ret)
+		ret = regmap_update_bits(regmap, WSA884X_CLSH_CTL_1,
+					 WSA884X_CLSH_CTL_1_SLR_MAX_MASK,
+					 FIELD_PREP(WSA884X_CLSH_CTL_1_SLR_MAX_MASK, 0x2));
+	if (!ret)
+		ret = regmap_update_bits(regmap, WSA884X_CLSH_V_HD_PA,
+					 WSA884X_CLSH_V_HD_PA_V_HD_PA_MASK,
+					 FIELD_PREP(WSA884X_CLSH_V_HD_PA_V_HD_PA_MASK, 0x13));
+	if (!ret)
+		ret = regmap_update_bits(regmap, WSA884X_TOP_CTRL1,
+					 WSA884X_TOP_CTRL1_OCP_LOWVBAT_ITH_EN_MASK, 0);
+	if (ret)
+		dev_err(wsa884x->dev, "failed to apply 2S battery settings: %d\n", ret);
+
+	return ret;
+}
+
+static int wsa884x_read_supply_config(struct wsa884x_priv *wsa884x)
+{
+	unsigned int val;
+	int ret;
+
+	ret = regmap_read(wsa884x->regmap, WSA884X_VPHX_SYS_EN_STATUS, &val);
+	if (ret) {
+		dev_err(wsa884x->dev, "cannot read VPHX_SYS_EN_STATUS: %d\n", ret);
+		return ret;
+	}
+
+	if (val != WSA884X_VPHX_SYS_EN_STATUS_1S &&
+	    val != WSA884X_VPHX_SYS_EN_STATUS_2S) {
+		dev_warn(wsa884x->dev,
+			 "VPHX_SYS_EN_STATUS %#x is neither 1S nor 2S, keeping the 1S settings\n",
+			 val);
+		val = WSA884X_VPHX_SYS_EN_STATUS_1S;
+	}
+
+	if (val != wsa884x->supply_cfg)
+		dev_info(wsa884x->dev, "battery configuration %s\n",
+			 val == WSA884X_VPHX_SYS_EN_STATUS_2S ? "2S" : "1S");
+
+	wsa884x->supply_cfg = val;
+
+	return 0;
+}
+
 static void wsa884x_set_gain_parameters(struct wsa884x_priv *wsa884x)
 {
 	struct regmap *regmap = wsa884x->regmap;
@@ -1535,18 +1625,28 @@ static void wsa884x_set_gain_parameters(struct wsa884x_priv *wsa884x)
 	}
 }
 
-static void wsa884x_init(struct wsa884x_priv *wsa884x)
+static int wsa884x_init(struct wsa884x_priv *wsa884x)
 {
 	unsigned int wo_ctl_0;
 	unsigned int variant = 0;
+	int ret;
 
 	if (!regmap_read(wsa884x->regmap, WSA884X_OTP_REG_0, &variant))
 		variant = variant & WSA884X_OTP_REG_0_ID_MASK;
 
+	ret = wsa884x_read_supply_config(wsa884x);
+	if (ret)
+		return ret;
+
 	regmap_multi_reg_write(wsa884x->regmap, wsa884x_reg_init,
 			       ARRAY_SIZE(wsa884x_reg_init));
+	ret = wsa884x_apply_supply_config(wsa884x);
+	if (ret)
+		return ret;
 
 	wo_ctl_0 = 0xc;
+	if (wsa884x->supply_cfg == WSA884X_VPHX_SYS_EN_STATUS_2S)
+		wo_ctl_0 |= WSA884X_ANA_WO_CTL_0_VPHX_SYS_EN_MASK;
 	wo_ctl_0 |= FIELD_PREP(WSA884X_ANA_WO_CTL_0_DAC_CM_CLAMP_EN_MASK,
 			       WSA884X_ANA_WO_CTL_0_DAC_CM_CLAMP_EN_MODE_SPEAKER);
 	/* Assume that compander is enabled by default unless it is haptics sku */
@@ -1556,11 +1656,17 @@ static void wsa884x_init(struct wsa884x_priv *wsa884x)
 	else
 		wo_ctl_0 |= FIELD_PREP(WSA884X_ANA_WO_CTL_0_PA_AUX_GAIN_MASK,
 				       WSA884X_ANA_WO_CTL_0_PA_AUX_0_DB);
-	regmap_write(wsa884x->regmap, WSA884X_ANA_WO_CTL_0, wo_ctl_0);
+	ret = regmap_write(wsa884x->regmap, WSA884X_ANA_WO_CTL_0, wo_ctl_0);
+	if (ret) {
+		dev_err(wsa884x->dev, "failed to write ANA_WO_CTL_0: %d\n", ret);
+		return ret;
+	}
 
 	wsa884x_set_gain_parameters(wsa884x);
 
 	wsa884x->hw_init = true;
+
+	return 0;
 }
 
 static int wsa884x_update_status(struct sdw_slave *slave,
@@ -1601,9 +1707,7 @@ static int wsa884x_update_status(struct sdw_slave *slave,
 		return ret;
 	}
 
-	wsa884x_init(wsa884x);
-
-	return 0;
+	return wsa884x_init(wsa884x);
 }
 
 /* Write the PA off to the hardware, not only to the register cache */
@@ -1844,7 +1948,10 @@ static void wsa884x_spkr_post_pmu(struct snd_soc_component *component,
 
 	if (wsa884x->port_enable[WSA884X_PORT_PBR]) {
 		curr_ovrd_en = 0x0;
-		curr_limit = 0x15;
+		if (wsa884x->supply_cfg == WSA884X_VPHX_SYS_EN_STATUS_2S)
+			curr_limit = 0x11;
+		else
+			curr_limit = 0x15;
 	} else {
 		curr_ovrd_en = 0x1;
 		if (wsa884x->dev_mode == WSA884X_RECEIVER)
