From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 23:11:41 -0500
Subject: [PATCH] media: iris: release the PAS metadata after authentication

qcom_mdt_pas_load() keeps the firmware metadata in the PAS context
until qcom_pas_metadata_release(), and
qcom_pas_prepare_and_auth_reset() does not free it, so every iris
firmware load leaked it.

Release it once authentication has been attempted and on the load error
paths, as qcom_q6v5_pas does; an iommu_map() failure now takes the
error path too.

This fixes "media: iris: Enable Secure PAS support with IOMMU managed
by Linux" (20260917-glymur-v11-2-e0c8bc914742@oss.qualcomm.com).

Assisted-by: Claude:claude-opus-5-5
---
 drivers/media/platform/qcom/iris/iris_firmware.c | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/qcom/iris/iris_firmware.c b/drivers/media/platform/qcom/iris/iris_firmware.c
index f54d5cacd1e7..f748e9fae115 100644
--- a/drivers/media/platform/qcom/iris/iris_firmware.c
+++ b/drivers/media/platform/qcom/iris/iris_firmware.c
@@ -216,12 +216,12 @@ static int iris_load_fw_to_memory(struct iris_core *core)
 	core->pas_ctx->use_tzmem = !!core->fw_dev;
 	ret = qcom_mdt_pas_load(core->pas_ctx, firmware, fw_name, NULL);
 	if (ret)
-		goto err_release_fw;
+		goto err_release_metadata;
 
 	mem_virt = memremap(mem_phys, res_size, MEMREMAP_WC);
 	if (!mem_virt) {
 		ret = -ENOMEM;
-		goto err_release_fw;
+		goto err_release_metadata;
 	}
 
 	iris_detect_firmware(core, fw_name, mem_virt, res_size, desc);
@@ -232,13 +232,21 @@ static int iris_load_fw_to_memory(struct iris_core *core)
 		domain = iommu_get_domain_for_dev(fw_dev);
 		if (!domain) {
 			ret = -ENODEV;
-			goto err_release_fw;
+			goto err_release_metadata;
 		}
 
 		ret = iommu_map(domain, IRIS_FIRMWARE_START_ADDR, mem_phys, res_size,
 				IOMMU_READ | IOMMU_WRITE | IOMMU_PRIV, GFP_KERNEL);
+		if (ret)
+			goto err_release_metadata;
 	}
 
+	release_firmware(firmware);
+
+	return 0;
+
+err_release_metadata:
+	qcom_pas_metadata_release(core->pas_ctx);
 err_release_fw:
 	release_firmware(firmware);
 
@@ -269,6 +277,7 @@ int iris_fw_load(struct iris_core *core)
 	}
 
 	ret = qcom_pas_prepare_and_auth_reset(core->pas_ctx);
+	qcom_pas_metadata_release(core->pas_ctx);
 	if (ret)  {
 		dev_err(core->dev, "auth and reset failed: %d\n", ret);
 		goto err_unmap;
