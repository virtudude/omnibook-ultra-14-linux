From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 19:37:32 -0500
Subject: [PATCH] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: enable
 iris

Enable iris with the video firmware from the Windows driver package
(video-firmware 3.6), which is signed for production devices;
qcom/vpu/vpu36_p4_s7.mbn in linux-firmware is test-signed and only
loads on the CRD.

Linux runs at EL2 on this laptop, so describe the firmware stream (SID
0x19e2) for Linux to manage, as on the CRD.

Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts  | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index 92a38ff77266..fbbf1d9b940d 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -541,6 +541,16 @@ touchscreen@10 {
 	};
 };
 
+&iris {
+	firmware-name = "qcom/glymur/hp/omnibook-ultra-14-kg0xxx/qcvss8480.mbn";
+
+	status = "okay";
+
+	video-firmware {
+		iommus = <&apps_smmu 0x19e2 0x0>;
+	};
+};
+
 &lpass_vamacro {
 	vdd-micb-supply = <&vreg_l1b_e0_1p8>;
 
