+
 	if (mode == PARAM_ID_SP_VI_OP_MODE_CALIBRATION) {
 		audioreach_arm_vi_calibration(graph->dev, num_speakers);
 
@@ -2781,10 +2830,86 @@ static int audioreach_speaker_protection_static_cfg(struct q6apm_graph *graph,
 	return audioreach_speaker_protection_send_static_cfg(graph, module, "SP");
 }
 
-static int audioreach_speaker_protection_vi_static_cfg(struct q6apm_graph *graph,
-						       const struct audioreach_module *module)
+#define PARAM_ID_SP_TH_VI_DYNAMIC_CFG_V5	0x08001535
+/* 0x08001535: per speaker, after the count: 32 bytes, v_full_sc_q10 at 16 */
+#define AR_SP_VI_TH_SPK_SIZE			32
+#define AR_SP_VI_TH_VFS_OFFSET			16
+
+/*
+ * At the speaker operating point the SP VI blob must carry one thermal model
+ * record for the operating point's speakers, each full scale (Q10 volts)
+ * within 1 % of the delivered one, so the model expects the pilot tone at the
+ * level the amplifiers produce.
