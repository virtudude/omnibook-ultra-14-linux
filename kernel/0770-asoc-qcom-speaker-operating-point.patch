From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:08:53 -0500
Subject: [PATCH 1/3] ASoC: codecs: wsa884x: cap PA Volume at the board's operating
 point

The safe gain is per amplifier (woofers and tweeters differ), but
snd_soc_limit_volume() sets the limit in the static control template
all wsa884x instances share.

Read the PA gain ceiling from DT and give each amplifier its own PA
Volume control with the ceiling as platform_max, lowering the reset
gain to it at component probe. A gain that is not a PA Volume step
fails the probe; without the property nothing changes.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/codecs/wsa884x.c | 98 ++++++++++++++++++++++++++++++++------
 1 file changed, 84 insertions(+), 14 deletions(-)

diff --git a/sound/soc/codecs/wsa884x.c b/sound/soc/codecs/wsa884x.c
index 3d4d920b4092..4a397b1a2b17 100644
--- a/sound/soc/codecs/wsa884x.c
+++ b/sound/soc/codecs/wsa884x.c
@@ -772,6 +772,9 @@ struct wsa884x_priv {
 	struct delayed_work vi_off_work;
 	/* Battery stacking reported by VPHX_SYS_EN_STATUS */
 	unsigned int supply_cfg;
+	/* This amplifier's PA Volume control, and its ceiling from the DT */
+	struct soc_mixer_control pa_mc;
+	int pa_max;
 };
 
 #define WSA884X_VI_OFF_RETRY_MS	20
@@ -1894,13 +1897,60 @@ static int wsa884x_set_swr_port(struct snd_kcontrol *kcontrol,
 	return 1;
 }
 
+/*
+ * The CSR gain field is inverted: control 31 is code 0 (G_21_DB), and code c
+ * is documented as 21 - 1.5 * c dB. As on wsa883x, codes 14..31 (controls
+ * 0..17) measure the same on WSA8845: a -3 dB floor.
+ */
+static const SNDRV_CTL_TLVD_DECLARE_DB_RANGE(pa_gain,
+	0, 17, TLV_DB_SCALE_ITEM(-300, 0, 0),
+	18, 31, TLV_DB_SCALE_ITEM(150, 150, 0),
+);
+
+#define WSA884X_PA_VOLUME_MAX	0x1f
+#define WSA884X_PA_VOLUME_FLOOR	17
+
+static const struct snd_kcontrol_new wsa884x_pa_volume =
+	SOC_SINGLE_RANGE_TLV("PA Volume", WSA884X_DRE_CTL_1,
+			     WSA884X_DRE_CTL_1_CSR_GAIN_SHIFT,
+			     0x0, WSA884X_PA_VOLUME_MAX, 1, pa_gain);
+
+/*
+ * A per-amplifier copy, so each amplifier has its own ceiling: a limit on the
+ * shared template would apply to every amplifier. The reset gain (code 2) is
+ * lowered to the ceiling before the control exists.
+ */
+static int wsa884x_add_pa_volume(struct snd_soc_component *comp,
+				 struct wsa884x_priv *wsa884x)
+{
+	struct snd_kcontrol_new kc = wsa884x_pa_volume;
+	unsigned int code;
+	int ret;
+
+	wsa884x->pa_mc = *(struct soc_mixer_control *)wsa884x_pa_volume.private_value;
+	wsa884x->pa_mc.platform_max = wsa884x->pa_max;
+	kc.private_value = (unsigned long)&wsa884x->pa_mc;
+
+	code = snd_soc_component_read_field(comp, WSA884X_DRE_CTL_1,
+					    WSA884X_DRE_CTL_1_CSR_GAIN_MASK);
+	if (WSA884X_PA_VOLUME_MAX - (int)code > wsa884x->pa_max) {
+		ret = snd_soc_component_write_field(comp, WSA884X_DRE_CTL_1,
+						    WSA884X_DRE_CTL_1_CSR_GAIN_MASK,
+						    WSA884X_PA_VOLUME_MAX - wsa884x->pa_max);
+		if (ret < 0)
+			return ret;
+	}
+
+	return snd_soc_add_component_controls(comp, &kc, 1);
+}
+
 static int wsa884x_codec_probe(struct snd_soc_component *comp)
 {
 	struct wsa884x_priv *wsa884x = snd_soc_component_get_drvdata(comp);
 
 	snd_soc_component_init_regmap(comp, wsa884x->regmap);
 
-	return 0;
+	return wsa884x_add_pa_volume(comp, wsa884x);
 }
 
 static void wsa884x_spkr_post_pmu(struct snd_soc_component *component,
@@ -1981,20 +2031,7 @@ static const struct snd_soc_dapm_widget wsa884x_dapm_widgets[] = {
 	SND_SOC_DAPM_SPK("SPKR", wsa884x_spkr_event),
 };
 
-/*
- * The CSR gain field is inverted: control 31 is code 0 (G_21_DB), and code c
- * is documented as 21 - 1.5 * c dB. As on wsa883x, codes 14..31 (controls
- * 0..17) measure the same on WSA8845: a -3 dB floor.
- */
-static const SNDRV_CTL_TLVD_DECLARE_DB_RANGE(pa_gain,
-	0, 17, TLV_DB_SCALE_ITEM(-300, 0, 0),
-	18, 31, TLV_DB_SCALE_ITEM(150, 150, 0),
-);
-
 static const struct snd_kcontrol_new wsa884x_snd_controls[] = {
-	SOC_SINGLE_RANGE_TLV("PA Volume", WSA884X_DRE_CTL_1,
-			     WSA884X_DRE_CTL_1_CSR_GAIN_SHIFT,
-			     0x0, 0x1f, 1, pa_gain),
 	SOC_ENUM_EXT("WSA MODE", wsa884x_dev_mode_enum,
 		     wsa884x_dev_mode_get, wsa884x_dev_mode_put),
 	SOC_SINGLE_EXT("DAC Switch", WSA884X_PORT_DAC, 0, 1, 0,
@@ -2420,6 +2457,35 @@ static int wsa884x_get_reset(struct device *dev, struct wsa884x_priv *wsa884x)
 	return 0;
 }
 
+/* Optional DT PA gain ceiling (mdB, PA Volume scale) */
+static int wsa884x_parse_operating_point(struct wsa884x_priv *wsa884x)
+{
+	struct device_node *np = wsa884x->dev->of_node;
+	s32 mdb;
+
+	wsa884x->pa_max = WSA884X_PA_VOLUME_MAX;
+	if (!of_property_present(np, "qcom,pa-gain-max-millidecibel"))
+		return 0;
+
+	if (of_property_read_s32(np, "qcom,pa-gain-max-millidecibel", &mdb))
+		return dev_err_probe(wsa884x->dev, -EINVAL,
+				     "unreadable qcom,pa-gain-max-millidecibel\n");
+
+	/* The PA Volume TLV: -3 dB at the floor, then +1.5 dB per control */
+	if (mdb == -3000)
+		wsa884x->pa_max = WSA884X_PA_VOLUME_FLOOR;
+	else if (mdb >= 1500 && mdb <= 21000 && !(mdb % 1500))
+		wsa884x->pa_max = WSA884X_PA_VOLUME_FLOOR + mdb / 1500;
+	else
+		return dev_err_probe(wsa884x->dev, -EINVAL,
+				     "qcom,pa-gain-max-millidecibel %d is not a PA Volume step\n",
+				     mdb);
+
+	dev_info(wsa884x->dev, "PA gain ceiling %d mdB (PA Volume %d)\n", mdb, wsa884x->pa_max);
+
+	return 0;
+}
+
 static int wsa884x_probe(struct sdw_slave *pdev,
 			 const struct sdw_device_id *id)
 {
@@ -2483,6 +2549,10 @@ static int wsa884x_probe(struct sdw_slave *pdev,
 	INIT_DELAYED_WORK(&wsa884x->vi_off_work, wsa884x_vi_off_work);
 	wsa884x->vi_guard = of_property_read_bool(dev->of_node, "qcom,vi-guard");
 
+	ret = wsa884x_parse_operating_point(wsa884x);
+	if (ret)
+		return ret;
+
 	wsa884x_reset_deassert(wsa884x);
 	ret = devm_add_action_or_reset(dev, wsa884x_reset_powerdown, wsa884x);
 	if (ret)
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Fri, 13 Nov 2026 09:13:09 -0500
Subject: [PATCH 2/3] ASoC: qcom: audioreach: check the SP VI full scale against
 the amplifiers

The SP VI thermal model takes the terminal voltage that 0 dBFS produces
per speaker (v_full_sc in thermal record 0x08001535). If it is wrong,
the coil temperature is misjudged and the thermal limiter acts late or
never; it depends on the gains the machine driver runs, which the
topology cannot know.

Add audioreach_sp_set_full_scale(). While a full scale is set, the SP
VI blob must carry exactly one thermal record for that many speakers,
each full scale within 1 %, or the graph is refused before playback.
Calibration runs, which use other levels, and R0/T0 control writes are
refused.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c | 150 ++++++++++++++++++++++++++++--
 sound/soc/qcom/qdsp6/audioreach.h |   1 +
 2 files changed, 142 insertions(+), 9 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index 2f14ae333cef..ae855fe342df 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -1878,6 +1878,39 @@ void audioreach_sp_set_hpf_speakers(u32 speakers)
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_set_hpf_speakers);
 
+/*
+ * Delivered full scale per SP speaker (peak uV at the terminals for 0 dBFS)
+ * at the machine driver's operating point. The SP VI thermal model must
+ * assume the same, or it misjudges coil temperature; calibration runs at
+ * other levels, so it is refused while this is set.
+ */
+static struct {
+	u32 uv[MAX_SP_VI_SPEAKERS];
+	unsigned int num;
+} sp_full_scale;
+static DEFINE_MUTEX(sp_full_scale_lock);
+
+/**
+ * audioreach_sp_set_full_scale() - set the speakers' delivered full scale
+ * @uv: full scale per SP speaker, in microvolts, speaker order
+ * @num: number of speakers, 0 to clear
+ */
+void audioreach_sp_set_full_scale(const u32 *uv, unsigned int num)
+{
+	guard(mutex)(&sp_full_scale_lock);
+
+	sp_full_scale.num = min_t(unsigned int, num, MAX_SP_VI_SPEAKERS);
+	memcpy(sp_full_scale.uv, uv, sp_full_scale.num * sizeof(*uv));
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_set_full_scale);
+
+static bool audioreach_sp_full_scale_set(void)
+{
+	guard(mutex)(&sp_full_scale_lock);
+
+	return sp_full_scale.num;
+}
+
 /* Raw cfg blobs may only address their own module */
 static bool audioreach_sp_isolated(void)
 {
@@ -2052,6 +2085,10 @@ static int __audioreach_set_sp_vi_r0t0(struct device *dev, const long *vals,
 
 int audioreach_set_sp_vi_r0t0(struct device *dev, const long *vals, unsigned int count)
 {
+	/* The operating point runs on the factory calibration only */
+	if (audioreach_sp_full_scale_set())
+		return -EPERM;
+
 	return __audioreach_set_sp_vi_r0t0(dev, vals, count, false);
 }
 
@@ -2291,7 +2328,14 @@ EXPORT_SYMBOL_GPL(audioreach_vi_calibration_abort);
 static int audioreach_speaker_protection(struct q6apm_graph *graph,
 					 const struct audioreach_module *module)
 {
-	return audioreach_send_u32_param(graph, module, PARAM_ID_SP_OP_MODE, graph->sp.mode);
+	u32 mode = graph->sp.mode;
+
+	if (audioreach_sp_full_scale_set() && mode != PARAM_ID_SP_VI_OP_MODE_NORMAL) {
+		dev_err(graph->dev, "SP RX: only Normal mode at the speaker operating point; refusing\n");
+		return -EPERM;
+	}
+
+	return audioreach_send_u32_param(graph, module, PARAM_ID_SP_OP_MODE, mode);
 }
 
 static int audioreach_register_events(struct q6apm_graph *graph,
@@ -2414,6 +2458,11 @@ static int audioreach_speaker_protection_vi(struct q6apm_graph *graph,
 		return -EINVAL;
 	}
 
+	if (audioreach_sp_full_scale_set() && mode != PARAM_ID_SP_VI_OP_MODE_NORMAL) {
+		dev_err(graph->dev, "SP VI: only Normal mode at the speaker operating point; refusing\n");
