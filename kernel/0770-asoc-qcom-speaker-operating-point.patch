@@ -185,6 +214,281 @@ static int x1e80100_limit_speaker_volumes(struct snd_soc_card *card)
 	return 0;
 }
 
+/*
+ * Speaker operating point: with speaker protection required and every
+ * amplifier V/I guarded with a DT PA gain ceiling and full scale, the card
+ * pins the path the full scale was measured on (AIF1 on INP0 only, no mix,
+ * sidetone, compander or soft clip, 0 dB digital, speaker mode, COMP on, PA
+ * at its ceiling). The pins are set before the card registers, read-only
+ * from then on and rechecked at every WSA RX0 prepare.
+ */
+#define X1E80100_DIGITAL_0DB		84
+#define X1E80100_PIN_AMP_PA		-1
+
+struct x1e80100_pin_ctl {
+	const char *fmt;	/* %s: macro or amplifier prefix */
+	bool amp;
+	int value;
+};
+
+static const struct x1e80100_pin_ctl x1e80100_pin_ctls[] = {
+	{ "%s WSA_RX0 INP0", false, 1 }, { "%s WSA_RX0 INP1", false, 0 },
+	{ "%s WSA_RX0 INP2", false, 0 }, { "%s WSA_RX0 MIX INP", false, 0 },
+	{ "%s WSA_RX0 INT0 SIDETONE MIX", false, 0 },
+	{ "%s WSA_RX1 INP0", false, 2 }, { "%s WSA_RX1 INP1", false, 0 },
+	{ "%s WSA_RX1 INP2", false, 0 }, { "%s WSA_RX1 MIX INP", false, 0 },
+	{ "%s WSA RX0 MUX", false, 1 }, { "%s WSA RX1 MUX", false, 1 },	/* AIF1_PB */
+	{ "%s WSA_COMP1 Switch", false, 0 }, { "%s WSA_COMP2 Switch", false, 0 },
+	{ "%s WSA_Softclip0 Enable", false, 0 }, { "%s WSA_Softclip1 Enable", false, 0 },
+	{ "%s WSA_RX0 Digital Volume", false, X1E80100_DIGITAL_0DB },
+	{ "%s WSA_RX1 Digital Volume", false, X1E80100_DIGITAL_0DB },
+	{ "%s PA Volume", true, X1E80100_PIN_AMP_PA },
+	{ "%s WSA MODE", true, 0 }, { "%s COMP Switch", true, 1 },
+};
+
+#define X1E80100_MAX_PINS \
+	(ARRAY_SIZE(x1e80100_pin_ctls) * MAX(MAX_SP_VI_SPEAKERS, X1E80100_MAX_WSA_MACROS))
+
+struct x1e80100_pin {
+	struct snd_kcontrol *kctl;
+	unsigned int access;
+	int want;
+	char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+};
+
+/* Why the operating point cannot be used, or NULL; @fs gets the full scales */
+static const char *x1e80100_op_check(struct snd_soc_card *card, u32 *fs, bool *any)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	const char *why = NULL;
+	unsigned int k;
+
+	*any = false;
+	for (k = 0; k < data->sp.num_amps; k++) {
+		struct device_node *np = data->sp.amp[k]->dev->of_node;
+
+		if (of_property_present(np, "qcom,pa-gain-max-millidecibel") ||
+		    of_property_present(np, "qcom,speaker-full-scale-microvolt"))
+			*any = true;
+		if (why)
+			continue;
+		if (!data->sp.amp[k]->name_prefix)
+			why = "an amplifier has no name prefix";
+		else if (!of_property_present(np, "qcom,pa-gain-max-millidecibel") ||
+			 of_property_read_u32(np, "qcom,speaker-full-scale-microvolt", &fs[k]))
+			why = "an amplifier has no operating point";
+		else if (!fs[k] || fs[k] >= 64000000)
+			why = "a full scale is out of range";
+		else if (!of_property_read_bool(np, "qcom,vi-guard"))
+			why = "an amplifier has no V/I guard";
+	}
+
+	if (!*any || why)
+		return why;
+	if (!audioreach_sp_required())
+		return "speaker protection is not required";
+	if (!data->sp.num_macros)
+		return "no WSA macro on the speaker link";
+
+	return NULL;
+}
+
+static int x1e80100_pin_resolve(struct snd_soc_card *card, struct x1e80100_pin *pins,
+				unsigned int *num)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_ctl_elem_info *info __free(kfree) = kzalloc(sizeof(*info), GFP_KERNEL);
+	unsigned int i, j, n, k = 0;
+
+	if (!info)
+		return -ENOMEM;
+
+	for (i = 0; i < ARRAY_SIZE(x1e80100_pin_ctls); i++) {
+		const struct x1e80100_pin_ctl *c = &x1e80100_pin_ctls[i];
+
+		n = c->amp ? data->sp.num_amps : data->sp.num_macros;
+		for (j = 0; j < n; j++) {
+			struct x1e80100_pin *p = &pins[k];
+
+			if (k == X1E80100_MAX_PINS)
+				return -E2BIG;
+			snprintf(p->name, sizeof(p->name), c->fmt,
+				 c->amp ? data->sp.amp[j]->name_prefix : data->sp.macro[j]);
+			p->kctl = snd_soc_card_get_kcontrol(card, p->name);
+			if (!p->kctl) {
+				dev_err(card->dev, "operating point: no control '%s'\n", p->name);
+				return -ENOENT;
+			}
+			p->access = p->kctl->vd[0].access;
+			p->want = c->value;
+			if (c->value == X1E80100_PIN_AMP_PA) {
+				/* The amplifier caps PA Volume at its operating point */
+				memset(info, 0, sizeof(*info));
+				if (p->kctl->info(p->kctl, info))
+					return -EIO;
+				p->want = info->value.integer.max;
+			}
+			k++;
+		}
+	}
+	*num = k;
+
+	return 0;
+}
+
+static int x1e80100_pin_value(struct device *dev, struct x1e80100_pin *p, bool set)
+{
+	struct snd_ctl_elem_info *info __free(kfree) = kzalloc(sizeof(*info), GFP_KERNEL);
+	struct snd_ctl_elem_value *val __free(kfree) = kzalloc(sizeof(*val), GFP_KERNEL);
+	bool en;
+	long got;
+
+	if (!info || !val)
+		return -ENOMEM;
+	if (p->kctl->info(p->kctl, info))
+		return -EIO;
+	en = info->type == SNDRV_CTL_ELEM_TYPE_ENUMERATED;
+	if (set) {
+		if (en)
+			val->value.enumerated.item[0] = p->want;
+		else
+			val->value.integer.value[0] = p->want;
+		if (p->kctl->put(p->kctl, val) < 0) {
+			dev_err(dev, "operating point: cannot set '%s'\n", p->name);
+			return -EPERM;
+		}
+		memset(val, 0, sizeof(*val));
+	}
+	if (p->kctl->get(p->kctl, val)) {
+		dev_err(dev, "operating point: cannot read '%s'\n", p->name);
+		return -EPERM;
+	}
+	got = en ? val->value.enumerated.item[0] : val->value.integer.value[0];
+	if (got != p->want) {
+		dev_err(dev, "operating point: '%s' is %ld, needs %d\n", p->name, got, p->want);
+		return -EPERM;
+	}
+
+	return 0;
+}
+
+static int x1e80100_check_operating_point(struct snd_soc_pcm_runtime *rtd)
+{
+	struct x1e80100_pin *pins __free(kfree) =
+		kcalloc(X1E80100_MAX_PINS, sizeof(*pins), GFP_KERNEL);
+	unsigned int i, num;
+	int ret;
+
+	if (!pins)
+		return -ENOMEM;
+	ret = x1e80100_pin_resolve(rtd->card, pins, &num);
+	for (i = 0; !ret && i < num; i++)
+		ret = x1e80100_pin_value(rtd->dev, &pins[i], false);
+	if (ret)
+		dev_err(rtd->dev, "speaker operating point changed; refusing\n");
+
+	return ret ? -EPERM : 0;
+}
+
+/* The default limits sit below the pinned gains */
+static int x1e80100_raise_limits(struct snd_soc_card *card)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < data->sp.num_macros * 2; i++) {
+		snprintf(name, sizeof(name), "%s WSA_RX%u Digital Volume",
+			 data->sp.macro[i / 2], i % 2);
+		ret = snd_soc_limit_volume(card, name, X1E80100_DIGITAL_0DB);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < data->sp.num_amps; i++) {
+		struct snd_kcontrol *kctl;
+		struct soc_mixer_control *mc;
+
+		snprintf(name, sizeof(name), "%s PA Volume", data->sp.amp[i]->name_prefix);
+		kctl = snd_soc_card_get_kcontrol(card, name);
+		if (!kctl)
+			return -ENOENT;
+		mc = (struct soc_mixer_control *)kctl->private_value;
+		ret = snd_soc_limit_volume(card, name, mc->max - mc->min);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int x1e80100_op_get(struct snd_kcontrol *kctl, struct snd_ctl_elem_value *uval)
+{
+	uval->value.integer.value[0] = 1;
+	return 0;
+}
+
+/* Present only at the operating point: tells UCM the pinned gains are fixed */
+static const struct snd_kcontrol_new x1e80100_op_ctl = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "Speaker Operating Point Switch",
+	.access = SNDRV_CTL_ELEM_ACCESS_READ,
+	.info = snd_ctl_boolean_mono_info,
+	.get = x1e80100_op_get,
+};
+
+static int x1e80100_snd_late_probe(struct snd_soc_card *card)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct x1e80100_pin *pins __free(kfree) = NULL;
+	u32 fs[MAX_SP_VI_SPEAKERS] = {};
+	unsigned int i, num = 0;
+	const char *why;
+	bool any;
+	int ret;
+
+	data->op_active = false;
+	audioreach_sp_set_full_scale(NULL, 0);
+
+	why = x1e80100_op_check(card, fs, &any);
+	if (!any)
+		return 0;
+	if (why) {
+		dev_err(card->dev, "speaker operating point not used (%s); default limits\n", why);
+		return 0;
+	}
+
+	pins = kcalloc(X1E80100_MAX_PINS, sizeof(*pins), GFP_KERNEL);
+	if (!pins)
+		return -ENOMEM;
+
+	/* The DAPM mux controls only exist once the widgets do */
+	ret = snd_soc_dapm_new_widgets(card);
+	if (!ret)
+		ret = x1e80100_raise_limits(card);
+	if (!ret)
+		ret = x1e80100_pin_resolve(card, pins, &num);
+	for (i = 0; !ret && i < num; i++)
+		ret = x1e80100_pin_value(card->dev, &pins[i], true);
+	for (i = 0; !ret && i < num; i++)
+		pins[i].kctl->vd[0].access &= ~SNDRV_CTL_ELEM_ACCESS_WRITE;
+	if (!ret)
+		ret = snd_soc_add_card_controls(card, &x1e80100_op_ctl, 1);
+	if (!ret) {
+		audioreach_sp_set_full_scale(fs, data->sp.num_amps);
+		data->op_active = true;
+		dev_info(card->dev, "speakers at their operating point: gains and routing fixed\n");
+		return 0;
+	}
+
+	for (i = 0; i < num; i++)
+		pins[i].kctl->vd[0].access = pins[i].access;
+	dev_err(card->dev, "speaker operating point not used (cannot fix its controls: %d); default limits\n",
+		ret);
+
+	return x1e80100_limit_speaker_volumes(card);
+}
+
 static int x1e80100_snd_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
@@ -381,6 +685,11 @@ static int x1e80100_snd_prepare(struct snd_pcm_substream *substream)
 			if (ret)
 				return ret;
 		}
+		if (data->op_active) {
+			ret = x1e80100_check_operating_point(rtd);
+			if (ret)
+				return ret;
+		}
 		ret = x1e80100_snd_hw_map_channels(rx_slot, channels);
 		if (ret)
 			return ret;
@@ -519,6 +828,7 @@ static int x1e80100_platform_probe(struct platform_device *pdev)
 
 	card->driver_name = of_device_get_match_data(dev);
 	x1e80100_add_be_ops(card);
+	card->late_probe = x1e80100_snd_late_probe;
 	audioreach_sp_set_required(of_property_read_bool(dev->of_node,
 							 "qcom,speaker-protection-required"));
 	if (of_property_read_bool(dev->of_node, "qcom,uefi-speaker-calibration")) {
