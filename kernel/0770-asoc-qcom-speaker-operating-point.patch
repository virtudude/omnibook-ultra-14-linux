+/*
+ * Speaker operating point: with speaker protection required and every
+ * amplifier V/I guarded with a DT PA gain ceiling and full scale, the card
+ * runs the path the full scale was measured on (AIF1 on INP0 only, no mix,
+ * sidetone, compander or soft clip, 0 dB digital, speaker mode, COMP on, PA
+ * at the ceiling the amplifier enforces). The controls are set before the
+ * card registers and are read-only from then on.
+ */
+#define X1E80100_DIGITAL_0DB		84
+#define X1E80100_PIN_AMP_PA		-1
+
+struct x1e80100_pin_ctl {
+	const char *fmt;	/* %s: macro or amplifier prefix */
+	bool amp;
+	int value;
+};
+
+static const struct x1e80100_pin_ctl x1e80100_pin_ctls[] = {
+	{ "%s WSA_RX0 INP0", false, 1 }, { "%s WSA_RX0 INP1", false, 0 },
+	{ "%s WSA_RX0 INP2", false, 0 }, { "%s WSA_RX0 MIX INP", false, 0 },
+	{ "%s WSA_RX0 INT0 SIDETONE MIX", false, 0 },
+	{ "%s WSA_RX1 INP0", false, 2 }, { "%s WSA_RX1 INP1", false, 0 },
+	{ "%s WSA_RX1 INP2", false, 0 }, { "%s WSA_RX1 MIX INP", false, 0 },
+	{ "%s WSA RX0 MUX", false, 1 }, { "%s WSA RX1 MUX", false, 1 },	/* AIF1_PB */
+	{ "%s WSA_COMP1 Switch", false, 0 }, { "%s WSA_COMP2 Switch", false, 0 },
+	{ "%s WSA_Softclip0 Enable", false, 0 }, { "%s WSA_Softclip1 Enable", false, 0 },
+	{ "%s WSA_RX0 Digital Volume", false, X1E80100_DIGITAL_0DB },
+	{ "%s WSA_RX1 Digital Volume", false, X1E80100_DIGITAL_0DB },
+	{ "%s PA Volume", true, X1E80100_PIN_AMP_PA },
+	{ "%s WSA MODE", true, 0 }, { "%s COMP Switch", true, 1 },
+};
+
+/* Every SP amplifier has an operating point and the V/I guard, and SP is required */
+static bool x1e80100_op_wanted(struct x1e80100_snd_data *data)
+{
+	unsigned int k;
+
+	if (!audioreach_sp_required() || !data->sp.num_amps || !data->sp.num_macros)
+		return false;
+
+	for (k = 0; k < data->sp.num_amps; k++) {
+		struct device_node *np = data->sp.amp[k]->dev->of_node;
+
+		if (!data->sp.amp[k]->name_prefix ||
+		    !of_property_read_bool(np, "qcom,vi-guard") ||
+		    !of_property_present(np, "qcom,pa-gain-max-millidecibel") ||
+		    of_property_read_u32(np, "qcom,speaker-full-scale-microvolt",
+					 &data->sp.full_scale[k]))
+			return false;
+	}
+
+	return true;
+}
+
+/* Set a control, read it back and make it read-only */
+static int x1e80100_pin(struct snd_soc_card *card, const char *fmt, const char *prefix,
+			int want)
+{
+	struct snd_ctl_elem_info *info __free(kfree) = kzalloc(sizeof(*info), GFP_KERNEL);
+	struct snd_ctl_elem_value *val __free(kfree) = kzalloc(sizeof(*val), GFP_KERNEL);
+	char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+	struct snd_kcontrol *kctl;
+	bool en;
+	long got;
+
+	if (!info || !val)
+		return -ENOMEM;
+
+	snprintf(name, sizeof(name), fmt, prefix);
+	kctl = snd_soc_card_get_kcontrol(card, name);
+	if (!kctl || kctl->info(kctl, info)) {
+		dev_err(card->dev, "operating point: no control '%s'\n", name);
+		return -ENOENT;
+	}
+	/* The amplifier caps PA Volume at its operating point */
+	if (want == X1E80100_PIN_AMP_PA)
+		want = info->value.integer.max;
+
+	en = info->type == SNDRV_CTL_ELEM_TYPE_ENUMERATED;
+	if (en)
+		val->value.enumerated.item[0] = want;
+	else
+		val->value.integer.value[0] = want;
+	if (kctl->put(kctl, val) < 0)
+		goto err;
+	memset(val, 0, sizeof(*val));
+	if (kctl->get(kctl, val))
+		goto err;
+	got = en ? val->value.enumerated.item[0] : val->value.integer.value[0];
+	if (got != want)
+		goto err;
+
+	kctl->vd[0].access &= ~SNDRV_CTL_ELEM_ACCESS_WRITE;
+	return 0;
+err:
+	dev_err(card->dev, "operating point: cannot set '%s' to %d\n", name, want);
+	return -EIO;
+}
+
+static int x1e80100_pin_operating_point(struct snd_soc_card *card)
+{
+	struct x1e80100_snd_data *data = snd_soc_card_get_drvdata(card);
+	unsigned int i, j;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(x1e80100_pin_ctls); i++) {
+		const struct x1e80100_pin_ctl *c = &x1e80100_pin_ctls[i];
+		unsigned int n = c->amp ? data->sp.num_amps : data->sp.num_macros;
+
+		for (j = 0; j < n; j++) {
+			const char *prefix = c->amp ? data->sp.amp[j]->name_prefix :
+						      data->sp.macro[j];
+
+			ret = x1e80100_pin(card, c->fmt, prefix, c->value);
+			if (ret)
+				return ret;
+		}
+	}
+
+	return 0;
+}
+
+static int x1e80100_op_get(struct snd_kcontrol *kctl, struct snd_ctl_elem_value *uval)
+{
+	uval->value.integer.value[0] = 1;
+	return 0;
+}
