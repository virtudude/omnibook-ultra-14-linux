+	/* Amplifiers in speaker (lane) order */
+	struct snd_soc_component *amp[MAX_SP_VI_SPEAKERS];
+	unsigned int num_amps;
+	const char *macro[X1E80100_MAX_WSA_MACROS];
+	unsigned int num_macros;
+	/* Delivered full scale per amplifier at the operating point, uV */
+	u32 full_scale[MAX_SP_VI_SPEAKERS];
+};
+
