 	if (snd_soc_rtd_to_cpu(rtd, 0)->id == WSA_CODEC_DMA_RX_0) {
 		audioreach_sp_register_speaker_map(NULL, NULL, NULL, 0);
 		audioreach_sp_set_hpf_speakers(0);
