From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Mon, 9 Nov 2026 19:21:04 -0500
Subject: [PATCH 1/2] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: add
 speaker VI feedback

As on glymur-crd, put the V/I sense DAIs of the four WSA8845 speakers,
the SoundWire VI ports and the WSA/WSA2 macro VI capture DAIs on the
WSA Playback link, and give the speakers '#sound-dai-cells = <1>'.

The amplifiers on the WSA bus drive the woofers and those on WSA2 the
tweeters, as their V/I sensed coil resistance and HP's factory R0
show, so name and route them that way: the second on WSA is
WooferRight and the first on WSA2 TweeterLeft.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/glymur-hp-omnibook-ultra-kg0xxx.dts  | 36 +++++++++++--------
 1 file changed, 21 insertions(+), 15 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index fec7c87d36f3..71ab81fd3026 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -222,8 +222,8 @@ sound {
 		model = "GLYMUR-HP-OmniBook-Ultra-14-kg0xxx";
 
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
-				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
-				"WooferRight IN", "WSA2 WSA_SPK1 OUT",
+				"WooferRight IN", "WSA WSA_SPK2 OUT",
+				"TweeterLeft IN", "WSA2 WSA_SPK1 OUT",
 				"TweeterRight IN", "WSA2 WSA_SPK2 OUT",
 				"VA DMIC0", "vdd-micb",
 				"VA DMIC1", "vdd-micb";
@@ -248,10 +248,16 @@ wsa-dai-link {
 			link-name = "WSA Playback";
 
 			codec {
-				sound-dai = <&left_woofer>, <&left_tweeter>,
+				sound-dai = <&left_woofer 0>, <&right_woofer 0>,
 					    <&swr0 0>, <&lpass_wsamacro 0>,
-					    <&right_woofer>, <&right_tweeter>,
-					    <&swr3 0>, <&lpass_wsa2macro 0>;
+					    <&left_woofer 1>, <&right_woofer 1>,
+					    <&swr0 12>, <&swr0 13>,
+					    <&lpass_wsamacro 2>,
+					    <&left_tweeter 0>, <&right_tweeter 0>,
+					    <&swr3 0>, <&lpass_wsa2macro 0>,
+					    <&left_tweeter 1>, <&right_tweeter 1>,
+					    <&swr3 12>, <&swr3 13>,
+					    <&lpass_wsa2macro 2>;
 			};
 
 			cpu {
@@ -722,20 +728,20 @@ left_woofer: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferLeft";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
 	};
 
-	/* WSA8845, left tweeter */
-	left_tweeter: speaker@0,1 {
+	/* WSA8845, right woofer: the second amp on the WSA macro bus */
+	right_woofer: speaker@0,1 {
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
-		sound-name-prefix = "TweeterLeft";
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "WooferRight";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
@@ -745,13 +751,13 @@ left_tweeter: speaker@0,1 {
 &swr3 {
 	status = "okay";
 
-	/* WSA8845, right woofer */
-	right_woofer: speaker@0,0 {
+	/* WSA8845, left tweeter: the first amp on the WSA2 macro bus */
+	left_tweeter: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
-		sound-name-prefix = "WooferRight";
+		#sound-dai-cells = <1>;
+		sound-name-prefix = "TweeterLeft";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
@@ -762,7 +768,7 @@ right_tweeter: speaker@0,1 {
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterRight";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Tue, 10 Nov 2026 23:15:24 -0500
Subject: [PATCH 2/2] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: require
 speaker protection
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Describe the speaker protection setup of the four WSA8845 speakers:
codec DMA lanes 0, 2, 1, 3 in link order, required protection with the
V/I guard on every amplifier, the tweeter high-pass, and the factory
R0/T0 from UEFI with an accepted R0 range of 5..10 ohm (factory values
are 7.0..8.2 ohm).

Each amplifier's operating point is a +12 dB PA gain ceiling (PA
Volume 25) and the peak terminal voltage measured for 0 dBFS at that
gain: 5.449 V (WooferLeft), 5.686 V (TweeterLeft), 5.511 V
(WooferRight) and 5.429 V (TweeterRight).

With thermal targets of 90 °C for the woofers and 80 °C for the
tweeters, the tweeter coils peaked at 82.3 °C after a hot restart and
held 78-79 °C through 10.5 minutes of sustained playback.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/glymur-hp-omnibook-ultra-kg0xxx.dts  | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index 71ab81fd3026..92a38ff77266 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -221,6 +221,16 @@ sound {
 		compatible = "qcom,glymur-sndcard";
 		model = "GLYMUR-HP-OmniBook-Ultra-14-kg0xxx";
 
+		/*
+		 * Lanes alternate between the WSA and WSA2 macros, so lane
+		 * order is WooferLeft, TweeterLeft, WooferRight, TweeterRight.
+		 */
+		qcom,wsa-speaker-lanes = <0 2 1 3>;
+		qcom,speaker-protection-required;
+		qcom,uefi-speaker-calibration;
+		/* Factory R0 is 7.0..8.2 ohms on these speakers (HP Rtyp 6.8..7.8) */
+		qcom,speaker-r0-range-micro-ohms = <5000000 10000000>;
+
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
 				"WooferRight IN", "WSA WSA_SPK2 OUT",
 				"TweeterLeft IN", "WSA2 WSA_SPK1 OUT",
@@ -730,6 +740,9 @@ left_woofer: speaker@0,0 {
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferLeft";
+		qcom,vi-guard;
+		qcom,pa-gain-max-millidecibel = <12000>;
+		qcom,speaker-full-scale-microvolt = <5449000>;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
@@ -742,6 +755,9 @@ right_woofer: speaker@0,1 {
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferRight";
+		qcom,vi-guard;
+		qcom,pa-gain-max-millidecibel = <12000>;
+		qcom,speaker-full-scale-microvolt = <5511000>;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
@@ -758,6 +774,10 @@ left_tweeter: speaker@0,0 {
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterLeft";
+		qcom,vi-guard;
+		qcom,tweeter;
+		qcom,pa-gain-max-millidecibel = <12000>;
+		qcom,speaker-full-scale-microvolt = <5686000>;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
@@ -770,6 +790,10 @@ right_tweeter: speaker@0,1 {
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterRight";
+		qcom,vi-guard;
+		qcom,tweeter;
+		qcom,pa-gain-max-millidecibel = <12000>;
+		qcom,speaker-full-scale-microvolt = <5429000>;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
