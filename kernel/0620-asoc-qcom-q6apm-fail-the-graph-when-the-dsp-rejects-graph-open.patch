From 736197ee9a4880b0f04e5b48a10136b6da7d984f Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Mon, 9 Nov 2026 20:02:27 -0500
Subject: [PATCH] ASoC: qcom: q6apm: fail the graph when the DSP rejects
 GRAPH_OPEN

q6apm_get_audioreach_graph() sends APM_CMD_GRAPH_OPEN and returns the
graph whatever the DSP answered, so a failed open (a module that cannot
be created or rejects its configuration) only surfaces later as a
confusing failure of another command, or not at all.

Check the result. On failure, close what the DSP may have opened, drop
the graph and return the error.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/q6apm.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 35daf763287c..131bc08423c7 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -40,11 +40,13 @@ int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 					NULL, &apm->wait, pkt, rsp_opcode);
 }
 
+static void q6apm_put_audioreach_graph(struct kref *ref);
+
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
 {
 	struct audioreach_graph_info *info;
 	struct audioreach_graph *graph;
-	int id;
+	int id, ret;
 
 	mutex_lock(&apm->lock);
 	graph = idr_find(&apm->graph_idr, graph_id);
@@ -89,7 +91,13 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 
 	kref_init(&graph->refcount);
 
-	q6apm_send_cmd_sync(apm, graph->graph, 0);
+	ret = q6apm_send_cmd_sync(apm, graph->graph, 0);
+	if (ret) {
+		dev_err(apm->dev, "Graph %u open failed: %d\n", graph_id, ret);
+		/* Closes whatever the DSP did open, then frees the graph */
+		kref_put(&graph->refcount, q6apm_put_audioreach_graph);
+		return ERR_PTR(ret);
+	}
 
 	return graph;
 }
