+/*
+ * A graph whose GRAPH_CLOSE was not acknowledged may still run in the DSP:
+ * keep its id refused until a later close succeeds or the APM goes away.
+ */
+static void q6apm_graph_mark_wedged(struct audioreach_graph *graph, int rc)
+{
+	struct q6apm *apm = graph->apm;
+
+	mutex_lock(&apm->lock);
+	graph->dead = true;
+	graph->wedged = true;
+	mutex_unlock(&apm->lock);
+
+	dev_err(apm->dev, "graph %u: DSP did not acknowledge GRAPH_CLOSE (%d); refusing it until it does or the DSP restarts\n",
+		graph->id, rc);
+}
+
+static void q6apm_graph_free(struct audioreach_graph *graph)
+{
+	kfree(graph->graph);
+	kfree(graph);
+}
