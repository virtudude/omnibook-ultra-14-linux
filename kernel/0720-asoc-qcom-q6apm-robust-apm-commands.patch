+/**
+ * q6apm_late_result() - consume the late answer to a command that timed out
+ * @apm: the APM
+ * @token: the command's token as sent
+ * @opcode: the command's opcode
+ * @status: set to the DSP's status if it answered
+ *
+ * Return: true if the DSP answered the command after it timed out.
+ */
+static bool q6apm_late_result(struct q6apm *apm, u32 token, u32 opcode, u32 *status)
+{
+	struct q6apm_late *late;
+
+	guard(spinlock_irqsave)(&apm->txn_lock);
+
+	for (late = apm->late; late < apm->late + APM_LATE_RECORDS; late++) {
+		if (token && late->token == token && late->opcode == opcode && late->answered) {
+			*status = late->status;
+			late->token = 0;
+			return true;
+		}
+	}
+
+	return false;
+}
