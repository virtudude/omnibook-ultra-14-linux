+/* Out-of-band SET_CFG memory is mapped through the q6apm-dai device's IOMMU */
+int q6apm_register_cfg_dma_dev(struct device *dev, long long sid)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+
+	if (!apm)
+		return -ENODEV;
+
+	guard(mutex)(&apm->cfg_lock);
+	/* Any q6apm-dai device sits behind the same IOMMU */
+	if (apm->cfg_dma_dev)
+		return 0;
+	apm->cfg_dma_dev = dev;
+	apm->cfg_dma_sid = sid;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6apm_register_cfg_dma_dev);
+
+/*
+ * Stays on q6apm_cfg_bufs until the DSP refused its map or acknowledged its
+ * unmap. If the outcome is unknown it stays quarantined, holding its device,
+ * until a later unmap succeeds or the DSP is down. Removing the APM does not
+ * prove the DSP stopped using it, so the list outlives the APM.
+ */
+struct q6apm_cfg_buf {
+	struct list_head node;
+	struct device *dev;
+	void *cpu;
+	dma_addr_t dma;
+	u32 size;
+	u32 map_token;
+	/* DSP map handle, 0 while unknown */
+	u32 handle;
+	/* DSP session that mapped it */
+	u32 gen;
+	/* Owned by a q6apm_set_cfg_oob() in progress */
+	bool busy;
+};
+
+static LIST_HEAD(q6apm_cfg_bufs);
+/* Held to add, remove or walk entries in process context */
+static DEFINE_MUTEX(q6apm_cfg_bufs_mutex);
+/* Also held to change the list, and the entries' handle and busy */
+static DEFINE_SPINLOCK(q6apm_cfg_bufs_lock);
+static u32 q6apm_cfg_gen;
+
+/* Without @dma_unmap the DSP is down and the device may be gone */
+static void q6apm_cfg_buf_release(struct q6apm_cfg_buf *cb, bool dma_unmap)
+{
+	lockdep_assert_held(&q6apm_cfg_bufs_mutex);
+
+	scoped_guard(spinlock_irqsave, &q6apm_cfg_bufs_lock)
+		list_del(&cb->node);
+
+	if (dma_unmap)
+		dma_unmap_single(cb->dev, cb->dma, cb->size, DMA_BIDIRECTIONAL);
+	free_pages_exact(cb->cpu, cb->size);
+	put_device(cb->dev);
+	kfree(cb);
+}
+
+static void q6apm_cfg_buf_quarantine(struct q6apm_cfg_buf *cb)
+{
+	guard(spinlock_irqsave)(&q6apm_cfg_bufs_lock);
+
+	cb->busy = false;
+}
+
+void q6apm_unregister_cfg_dma_dev(struct device *dev)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+
+	if (!apm)
+		return;
+
+	guard(mutex)(&apm->cfg_lock);
+	if (apm->cfg_dma_dev == dev)
+		apm->cfg_dma_dev = NULL;
+}
+EXPORT_SYMBOL_GPL(q6apm_unregister_cfg_dma_dev);
+
+static int q6apm_ssr_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct q6apm_cfg_buf *cb, *tmp;
+
+	if (event != QCOM_SSR_AFTER_SHUTDOWN)
+		return NOTIFY_DONE;
+
+	guard(mutex)(&q6apm_cfg_bufs_mutex);
+	list_for_each_entry_safe(cb, tmp, &q6apm_cfg_bufs, node) {
+		if (cb->busy)
+			continue;
+		pr_info("q6apm: SET_CFG: DSP down, releasing quarantined %u bytes\n", cb->size);
+		q6apm_cfg_buf_release(cb, false);
+	}
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block q6apm_ssr_nb = {
+	.notifier_call = q6apm_ssr_notify,
+};
+
+#define APM_CFG_OOB_MAX_BYTES	SZ_1M
+
+static u32 q6apm_cfg_next_token(struct q6apm *apm)
+{
+	return APM_MMAP_TOKEN_MAP_TYPE_CFG | (++apm->cfg_seq & APM_MMAP_TOKEN_GID_MASK);
+}
+
+static int q6apm_cfg_map(struct q6apm *apm, struct q6apm_cfg_buf *cb, u64 dsp_addr)
+{
+	struct apm_shared_map_region_payload *mregion;
+	struct apm_cmd_shared_mem_map_regions *cmd;
+	u32 handle;
+	int rc;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_pkt(sizeof(*cmd) + sizeof(*mregion),
+					 APM_CMD_SHARED_MEM_MAP_REGIONS, cb->map_token,
+					 GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_pool_id = APM_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	mregion = (void *)cmd + sizeof(*cmd);
+	mregion->shm_addr_lsw = lower_32_bits(dsp_addr);
+	mregion->shm_addr_msw = upper_32_bits(dsp_addr);
+	mregion->mem_size_bytes = cb->size;
+
+	/* The token as sent, sequence number included, finds a late answer */
+	rc = __q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_SHARED_MEM_MAP_REGIONS, &handle,
+				   &cb->map_token);
+	if (rc)
+		return rc;
+
+	scoped_guard(spinlock_irqsave, &q6apm_cfg_bufs_lock)
+		WRITE_ONCE(cb->handle, handle);
+
+	return 0;
+}
+
+static int q6apm_cfg_unmap(struct q6apm *apm, u32 handle)
+{
+	struct apm_cmd_shared_mem_unmap_regions *cmd;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_pkt(sizeof(*cmd), APM_CMD_SHARED_MEM_UNMAP_REGIONS,
+					 q6apm_cfg_next_token(apm), GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_map_handle = handle;
+
+	return q6apm_send_cmd_sync(apm, pkt, 0);
+}
+
+static int q6apm_cfg_set(struct q6apm *apm, u64 dsp_addr, u32 handle, u32 size)
+{
+	struct apm_cmd_header *hdr;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(0, APM_CMD_SET_CFG, q6apm_cfg_next_token(apm));
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	hdr = (void *)pkt + GPR_HDR_SIZE;
+	hdr->payload_address_lsw = lower_32_bits(dsp_addr);
+	hdr->payload_address_msw = upper_32_bits(dsp_addr);
+	hdr->mem_map_handle = handle;
+	hdr->payload_size = size;
+
+	return q6apm_send_cmd_sync(apm, pkt, 0);
+}
+
+/* Stops at the first failed unmap */
+static void q6apm_cfg_release_quarantined(struct q6apm *apm)
+{
+	struct q6apm_cfg_buf *cb, *tmp;
+
+	lockdep_assert_held(&apm->cfg_lock);
+
+	guard(mutex)(&q6apm_cfg_bufs_mutex);
+	list_for_each_entry_safe(cb, tmp, &q6apm_cfg_bufs, node) {
+		u32 handle = READ_ONCE(cb->handle);
+
+		/* A handle from an earlier DSP session means nothing to this one */
+		if (!handle || cb->busy || cb->gen != apm->cfg_gen)
+			continue;
+		if (q6apm_cfg_unmap(apm, handle))
+			return;
+		dev_info(apm->dev, "SET_CFG: released quarantined buffer, handle 0x%x\n",
+			 handle);
+		q6apm_cfg_buf_release(cb, true);
+	}
+}
+
+/*
+ * Report each record the DSP marked failed in @shm. Returns the number of
+ * failed records, or -EINVAL if @records is not a whole number of records.
+ */
+static int q6apm_cfg_check_records(struct device *dev, const u8 *records,
+				   const u8 *shm, u32 size)
+{
+	u32 pos = 0;
+	int failed = 0;
+
+	while (pos < size) {
+		const struct apm_module_param_data *pd = (const void *)(records + pos);
+		u32 err, step;
+
+		if (size - pos < APM_MODULE_PARAM_DATA_SIZE ||
+		    pd->param_size > size - pos - APM_MODULE_PARAM_DATA_SIZE)
+			return -EINVAL;
+
+		err = READ_ONCE(((const struct apm_module_param_data *)(shm + pos))->error_code);
+		if (err) {
+			dev_err(dev, "SET_CFG: module 0x%x param 0x%08x (%u bytes) failed: 0x%x\n",
+				pd->module_instance_id, pd->param_id, pd->param_size, err);
+			failed++;
+		}
+
+		step = APM_MODULE_PARAM_DATA_SIZE + ALIGN(pd->param_size, 8);
+		if (step > size - pos)
+			return -EINVAL;
+		pos += step;
+	}
+
+	return failed;
+}
+
+/**
+ * q6apm_set_cfg_oob() - send APM_CMD_SET_CFG records through shared memory
+ * @apm: the APM
+ * @records: SET_CFG parameter records, laid out as for an in-band SET_CFG
+ * @size: bytes of @records
+ *
+ * For parameters too large for a GPR packet. The buffer is mapped only for
+ * this command. After a timeout or failed unmap it is quarantined until a
+ * later unmap succeeds or the DSP is down.
+ *
+ * Return: 0 if the DSP accepted every record, a negative error code otherwise.
+ */
+int q6apm_set_cfg_oob(struct q6apm *apm, const void *records, u32 size)
+{
+	struct device *dev = apm->dev;
+	struct q6apm_cfg_buf *cb;
+	struct device *dma_dev;
+	u64 dsp_addr;
+	int rc, failed;
+
+	if (!size || size > APM_CFG_OOB_MAX_BYTES || !IS_ALIGNED(size, 8))
+		return -EINVAL;
+	if (apm->narrow_tokens)
+		return -EOPNOTSUPP;
+
+	guard(mutex)(&apm->cfg_lock);
+
+	dma_dev = apm->cfg_dma_dev;
+	if (!dma_dev) {
+		dev_err(dev, "SET_CFG: no DSP-visible memory for %u bytes of parameters\n", size);
+		return -ENODEV;
+	}
+
+	q6apm_cfg_release_quarantined(apm);
+
+	cb = kzalloc_obj(*cb);
+	if (!cb)
+		return -ENOMEM;
+
+	cb->size = ALIGN(size, SZ_4K);
+	cb->gen = apm->cfg_gen;
+	cb->busy = true;
+	/* Own pages, so they can be freed after the DSP and device are gone */
+	cb->cpu = alloc_pages_exact(cb->size, GFP_KERNEL);
+	if (!cb->cpu) {
+		kfree(cb);
+		return -ENOMEM;
+	}
+	memcpy(cb->cpu, records, size);
+	memset(cb->cpu + size, 0, cb->size - size);
+
+	cb->dma = dma_map_single(dma_dev, cb->cpu, cb->size, DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dma_dev, cb->dma)) {
+		free_pages_exact(cb->cpu, cb->size);
+		kfree(cb);
+		return -ENOMEM;
+	}
+
+	/* The 4K pool maps whole pages; the payload at offset 0 is 32-byte aligned */
+	if (!IS_ALIGNED(cb->dma, SZ_4K)) {
+		dma_unmap_single(dma_dev, cb->dma, cb->size, DMA_BIDIRECTIONAL);
+		free_pages_exact(cb->cpu, cb->size);
+		kfree(cb);
+		return -EINVAL;
+	}
+	cb->dev = get_device(dma_dev);
+
+	dsp_addr = cb->dma;
+	if (apm->cfg_dma_sid >= 0)
+		dsp_addr |= (u64)apm->cfg_dma_sid << 32;
+
+	cb->map_token = q6apm_cfg_next_token(apm);
+	scoped_guard(mutex, &q6apm_cfg_bufs_mutex) {
+		guard(spinlock_irqsave)(&q6apm_cfg_bufs_lock);
+		list_add_tail(&cb->node, &q6apm_cfg_bufs);
+	}
+
+	rc = q6apm_cfg_map(apm, cb, dsp_addr);
+	if (rc == -ETIMEDOUT || (!rc && !cb->handle)) {
+		dev_err(dev, "SET_CFG: map of %u bytes at %pad uncertain (%d), quarantined\n",
+			cb->size, &cb->dma, rc);
+		q6apm_cfg_buf_quarantine(cb);
+		return rc ?: -EIO;
+	}
+	if (rc) {
+		/* Not sent, or answered with an error: nothing is mapped */
+		dev_err(dev, "SET_CFG: map of %u bytes failed: %d\n", cb->size, rc);
+		scoped_guard(mutex, &q6apm_cfg_bufs_mutex)
+			q6apm_cfg_buf_release(cb, true);
+		return rc;
+	}
+
+	rc = q6apm_cfg_set(apm, dsp_addr, cb->handle, size);
+	dma_sync_single_for_cpu(dma_dev, cb->dma, cb->size, DMA_BIDIRECTIONAL);
+	if (rc != -ETIMEDOUT) {
+		failed = q6apm_cfg_check_records(dev, records, cb->cpu, size);
+		if (failed < 0)
+			rc = failed;
+		else if (failed && !rc)
+			rc = -EIO;
+	}
+	if (rc)
+		dev_err(dev, "SET_CFG of %u bytes out of band failed: %d\n", size, rc);
+
+	if (q6apm_cfg_unmap(apm, cb->handle)) {
+		dev_err(dev, "SET_CFG: unmap of handle 0x%x failed, %u bytes at %pad quarantined\n",
+			cb->handle, cb->size, &cb->dma);
+		q6apm_cfg_buf_quarantine(cb);
+		return rc ?: -EIO;
+	}
+
+	scoped_guard(mutex, &q6apm_cfg_bufs_mutex)
+		q6apm_cfg_buf_release(cb, true);
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6apm_set_cfg_oob);
