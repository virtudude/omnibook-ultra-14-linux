+/*
+ * A wedged graph is gone if its timed-out GRAPH_CLOSE was acknowledged late,
+ * or if closing it again succeeds or fails with a DSP error, which the DSP
+ * gives for a graph it no longer has. Should the graph still exist, the next
+ * GRAPH_OPEN fails, so an unknown graph is never reused. Only another timeout
+ * keeps it wedged.
+ */
+static int q6apm_reclaim_close(struct q6apm *apm, struct audioreach_graph *graph)
+{
+	u32 status;
+	int rc;
+
+	if (q6apm_late_result(apm, graph->close_token, APM_CMD_GRAPH_CLOSE, &status)) {
+		if (!status) {
+			dev_info(apm->dev, "graph %u: the DSP acknowledged its GRAPH_CLOSE late\n",
+				 graph->id);
+			return 0;
+		}
+		dev_warn(apm->dev, "graph %u: late GRAPH_CLOSE answer with status %u\n",
+			 graph->id, status);
+	}
+
+	rc = audioreach_graph_close_cmd(graph);
+	if (rc == -EINVAL) {
+		dev_info(apm->dev, "graph %u: the DSP refuses its GRAPH_CLOSE, so has no such graph\n",
+			 graph->id);
+		return 0;
+	}
+
+	return rc;
+}
+
+static int q6apm_reclaim_wedged_graph(struct q6apm *apm, struct audioreach_graph *graph)
+{
+	int rc;
+
+	mutex_lock(&apm->lock);
+	if (kref_read(&graph->refcount) || graph->reclaiming) {
+		mutex_unlock(&apm->lock);
+		dev_err(apm->dev, "graph %u: still open in the DSP after a failure; refusing it\n",
+			graph->id);
+		return -EIO;
+	}
+	graph->reclaiming = true;
+	mutex_unlock(&apm->lock);
+
+	rc = q6apm_reclaim_close(apm, graph);
+
+	mutex_lock(&apm->lock);
+	graph->reclaiming = false;
+	if (!rc)
+		idr_remove(&apm->graph_idr, graph->id);
+	mutex_unlock(&apm->lock);
+
+	if (rc) {
+		dev_err(apm->dev, "graph %u: GRAPH_CLOSE failed again (%d); refusing it until the DSP restarts\n",
+			graph->id, rc);
+		return -EIO;
+	}
+
+	dev_info(apm->dev, "graph %u: closed in the DSP, reopening it\n", graph->id);
+	q6apm_graph_free(graph);
+
+	return 0;
 }
 
