+/* A late answer to an out-of-band map that timed out: note its handle */
+static void q6apm_cfg_late_map(struct q6apm *apm, u32 token, u32 handle)
+{
+	struct q6apm_cfg_buf *cb;
+
+	guard(spinlock_irqsave)(&q6apm_cfg_bufs_lock);
+
+	list_for_each_entry(cb, &q6apm_cfg_bufs, node) {
+		if (cb->gen == apm->cfg_gen && cb->map_token == token && !cb->handle) {
+			WRITE_ONCE(cb->handle, handle);
+			dev_warn(apm->dev, "SET_CFG: late map of quarantined %pad, handle 0x%x\n",
+				 &cb->dma, handle);
+			return;
+		}
+	}
+
+	dev_err(apm->dev, "SET_CFG: map response for no buffer, token 0x%x, handle 0x%x\n",
+		token, handle);
+}
