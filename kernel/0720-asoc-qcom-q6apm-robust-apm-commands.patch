From c88f9c0f050a007cfca4fe505c06d1dd25f41548 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:02:19 -0500
Subject: [PATCH 1/3] ASoC: qcom: q6apm: match APM responses to their command

q6apm_send_cmd_sync() completes on any response with the expected
opcode and reads one shared apm->result. A late answer to a command that
timed out can thus complete the next command with that opcode: an old
UNMAP ack can let a buffer be freed while the DSP still maps it, and a
late GRAPH_CLOSE ack can complete another graph's close.

Track the command in flight (token, opcode, response opcode) under a
spinlock and complete it, and update the map handles, only on a
response that carries its token and answers its opcode; log and drop
the rest. Give every synchronous command a unique
token: the low 18 bits keep the graph id and map flags, the rest a
sequence number. Remember the last 16 timed-out commands so a late
answer can be recognised. Probe checks that the DSP echoes all 32 token
bits and sets narrow_tokens otherwise. Drop the unused cmd_lock.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/q6apm.c | 332 +++++++++++++++++++++++++++--------
 sound/soc/qcom/qdsp6/q6apm.h |  42 ++++-
 2 files changed, 301 insertions(+), 73 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index c1cdfe860f4d..22759c062ba7 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -29,15 +29,154 @@ struct apm_graph_mgmt_cmd {
 
 static struct q6apm *g_apm;
 
-int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
-			uint32_t rsp_opcode)
+static bool q6apm_txn_done(struct q6apm *apm)
+{
+	guard(spinlock_irqsave)(&apm->txn_lock);
+
+	return apm->txn.done;
+}
+
+static bool q6apm_txn_match(struct q6apm *apm, u32 token, u32 opcode)
+{
+	const struct q6apm_txn *txn = &apm->txn;
+
+	lockdep_assert_held(&apm->txn_lock);
+
+	return txn->active && !txn->done && txn->token == token &&
+	       (opcode == txn->opcode || (txn->rsp_opcode && opcode == txn->rsp_opcode));
+}
+
+static void q6apm_txn_finish(struct q6apm *apm, u32 status, u32 value)
+{
+	lockdep_assert_held(&apm->txn_lock);
+
+	apm->txn.status = status;
+	apm->txn.value = value;
+	apm->txn.done = true;
+}
+
+/* Record a timed-out command so that its late answer can be recognised */
+static void q6apm_late_add(struct q6apm *apm)
+{
+	struct q6apm_late *late = &apm->late[apm->late_next];
+
+	lockdep_assert_held(&apm->txn_lock);
+
+	late->token = apm->txn.token;
+	late->opcode = apm->txn.opcode;
+	late->status = 0;
+	late->answered = false;
+	apm->late_next = (apm->late_next + 1) % APM_LATE_RECORDS;
+}
+
+static bool q6apm_late_answer(struct q6apm *apm, u32 token, u32 opcode, u32 status)
+{
+	struct q6apm_late *late;
+
+	lockdep_assert_held(&apm->txn_lock);
+
+	for (late = apm->late; late < apm->late + APM_LATE_RECORDS; late++) {
+		if (!late->token || late->token != token || late->opcode != opcode ||
+		    late->answered)
+			continue;
+		late->answered = true;
+		late->status = status;
+		dev_warn(apm->dev, "late answer to [%x], token 0x%x: status %u\n",
+			 opcode, token, status);
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * Drop late records with the same sequence number, so that the new command's
+ * answer cannot be taken for theirs.
+ */
+static u32 q6apm_next_seq(struct q6apm *apm)
+{
+	u32 seq_mask = APM_TOKEN_ID_MASK ^ U32_MAX;
+	struct q6apm_late *late;
+	u32 seq;
+
+	lockdep_assert_held(&apm->lock);
+
+	apm->txn_seq = (apm->txn_seq + 1) & (seq_mask >> APM_TOKEN_SEQ_SHIFT) ?: 1;
+	seq = apm->txn_seq << APM_TOKEN_SEQ_SHIFT;
+
+	guard(spinlock_irqsave)(&apm->txn_lock);
+	for (late = apm->late; late < apm->late + APM_LATE_RECORDS; late++)
+		if ((late->token & seq_mask) == seq)
+			late->token = 0;
+
+	return seq;
+}
+
+/*
+ * Send @pkt and wait for the answer with its token and opcode (or
+ * @rsp_opcode). A sequence number is added to the caller's token bits so
+ * that no other command's answer completes this one; @sent gets the token.
+ * @value gets the map handle or GET_SPF_STATE state from the response.
+ */
+static int __q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
+				 u32 rsp_opcode, u32 *value, u32 *sent)
 {
 	gpr_device_t *gdev = apm->gdev;
+	struct q6apm_txn *txn = &apm->txn;
+	u32 status = 0, val = 0;
+	bool done;
+	int rc;
 
 	pkt->hdr.dest_domain = audioreach_gpr_dest_domain(gdev);
 
-	return audioreach_send_cmd_sync(&gdev->dev, gdev, &apm->result, &apm->lock,
-					NULL, &apm->wait, pkt, rsp_opcode);
+	guard(mutex)(&apm->lock);
+
+	pkt->hdr.token = (pkt->hdr.token & APM_TOKEN_ID_MASK) | q6apm_next_seq(apm);
+	if (sent)
+		*sent = pkt->hdr.token;
+
+	scoped_guard(spinlock_irqsave, &apm->txn_lock) {
+		memset(txn, 0, sizeof(*txn));
+		txn->token = pkt->hdr.token;
+		txn->opcode = pkt->hdr.opcode;
+		txn->rsp_opcode = rsp_opcode;
+		txn->active = true;
+	}
+
+	rc = gpr_send_pkt(gdev, pkt);
+	if (rc >= 0)
+		wait_event_timeout(apm->wait, q6apm_txn_done(apm), 5 * HZ);
+
+	scoped_guard(spinlock_irqsave, &apm->txn_lock) {
+		done = txn->done;
+		status = txn->status;
+		val = txn->value;
+		if (rc >= 0 && !done)
+			q6apm_late_add(apm);
+		txn->active = false;
+	}
+
+	if (rc < 0)
+		return rc;
+	if (!done) {
+		dev_err(apm->dev, "CMD timeout for [%x] opcode, token 0x%x\n",
+			pkt->hdr.opcode, pkt->hdr.token);
+		return -ETIMEDOUT;
+	}
+	if (status) {
+		dev_err(apm->dev, "DSP returned error[%x] %x\n", pkt->hdr.opcode, status);
+		return -EINVAL;
+	}
+	if (value)
+		*value = val;
+
+	return 0;
+}
+
+int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
+			uint32_t rsp_opcode)
+{
+	return __q6apm_send_cmd_sync(apm, pkt, rsp_opcode, NULL, NULL);
 }
 
