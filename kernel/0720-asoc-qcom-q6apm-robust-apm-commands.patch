+/* Out-of-band SET_CFG memory is mapped through the q6apm-dai device's IOMMU */
+int q6apm_register_cfg_dma_dev(struct device *dev, long long sid)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+
+	if (!apm)
+		return -ENODEV;
+
+	guard(mutex)(&apm->cfg_lock);
+	/* Any q6apm-dai device sits behind the same IOMMU */
+	if (apm->cfg_dma_dev)
+		return 0;
+	apm->cfg_dma_dev = dev;
+	apm->cfg_dma_sid = sid;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(q6apm_register_cfg_dma_dev);
+
+void q6apm_unregister_cfg_dma_dev(struct device *dev)
+{
+	struct q6apm *apm = dev_get_drvdata(dev->parent);
+
+	if (!apm)
+		return;
+
+	guard(mutex)(&apm->cfg_lock);
+	if (apm->cfg_dma_dev == dev)
+		apm->cfg_dma_dev = NULL;
+}
+EXPORT_SYMBOL_GPL(q6apm_unregister_cfg_dma_dev);
+
+#define APM_CFG_OOB_MAX_BYTES	SZ_1M
+
+static int q6apm_cfg_map(struct q6apm *apm, u64 dsp_addr, u32 size, u32 *handle)
+{
+	struct apm_shared_map_region_payload *mregion;
+	struct apm_cmd_shared_mem_map_regions *cmd;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_pkt(sizeof(*cmd) + sizeof(*mregion),
+					 APM_CMD_SHARED_MEM_MAP_REGIONS,
+					 APM_MMAP_TOKEN_MAP_TYPE_CFG, GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_pool_id = APM_MEMORY_MAP_SHMEM8_4K_POOL;
+	cmd->num_regions = 1;
+	cmd->property_flag = 0;
+
+	mregion = (void *)cmd + sizeof(*cmd);
+	mregion->shm_addr_lsw = lower_32_bits(dsp_addr);
+	mregion->shm_addr_msw = upper_32_bits(dsp_addr);
+	mregion->mem_size_bytes = size;
+
+	return __q6apm_send_cmd_sync(apm, pkt, APM_CMD_RSP_SHARED_MEM_MAP_REGIONS, handle);
+}
+
+static int q6apm_cfg_unmap(struct q6apm *apm, u32 handle)
+{
+	struct apm_cmd_shared_mem_unmap_regions *cmd;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_pkt(sizeof(*cmd), APM_CMD_SHARED_MEM_UNMAP_REGIONS,
+					 APM_MMAP_TOKEN_MAP_TYPE_CFG, GPR_APM_MODULE_IID);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cmd = (void *)pkt + GPR_HDR_SIZE;
+	cmd->mem_map_handle = handle;
+
+	return q6apm_send_cmd_sync(apm, pkt, 0);
+}
+
+static int q6apm_cfg_set(struct q6apm *apm, u64 dsp_addr, u32 handle, u32 size)
+{
+	struct apm_cmd_header *hdr;
+
+	struct gpr_pkt *pkt __free(kfree) =
+		audioreach_alloc_apm_cmd_pkt(0, APM_CMD_SET_CFG, APM_MMAP_TOKEN_MAP_TYPE_CFG);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	hdr = (void *)pkt + GPR_HDR_SIZE;
+	hdr->payload_address_lsw = lower_32_bits(dsp_addr);
+	hdr->payload_address_msw = upper_32_bits(dsp_addr);
+	hdr->mem_map_handle = handle;
+	hdr->payload_size = size;
+
+	return q6apm_send_cmd_sync(apm, pkt, 0);
+}
+
+/*
+ * Report each record the DSP marked failed in @shm. Returns the number of
+ * failed records, or -EINVAL if @records is not a whole number of records.
+ */
+static int q6apm_cfg_check_records(struct device *dev, const u8 *records,
+				   const u8 *shm, u32 size)
+{
+	u32 pos = 0;
+	int failed = 0;
+
+	while (pos < size) {
+		const struct apm_module_param_data *pd = (const void *)(records + pos);
+		u32 err, step;
+
+		if (size - pos < APM_MODULE_PARAM_DATA_SIZE ||
+		    pd->param_size > size - pos - APM_MODULE_PARAM_DATA_SIZE)
+			return -EINVAL;
+
+		err = READ_ONCE(((const struct apm_module_param_data *)(shm + pos))->error_code);
+		if (err) {
+			dev_err(dev, "SET_CFG: module 0x%x param 0x%08x (%u bytes) failed: 0x%x\n",
+				pd->module_instance_id, pd->param_id, pd->param_size, err);
+			failed++;
+		}
+
+		step = APM_MODULE_PARAM_DATA_SIZE + ALIGN(pd->param_size, 8);
+		if (step > size - pos)
+			return -EINVAL;
+		pos += step;
+	}
+
+	return failed;
+}
+
+/**
+ * q6apm_set_cfg_oob() - send APM_CMD_SET_CFG records through shared memory
+ * @apm: the APM
+ * @records: SET_CFG parameter records, laid out as for an in-band SET_CFG
+ * @size: bytes of @records
+ *
+ * For parameters too large for a GPR packet. The buffer is mapped only for
+ * this command. If the DSP may still map it, after a map timeout or a failed
+ * unmap, it is never freed.
+ *
+ * Return: 0 if the DSP accepted every record, a negative error code otherwise.
+ */
+int q6apm_set_cfg_oob(struct q6apm *apm, const void *records, u32 size)
+{
+	struct device *dev = apm->dev;
+	u32 buf_size, handle = 0;
+	struct device *dma_dev;
+	dma_addr_t dma;
+	u64 dsp_addr;
+	int rc, failed;
+	void *cpu;
+
+	if (!size || size > APM_CFG_OOB_MAX_BYTES || !IS_ALIGNED(size, 8))
+		return -EINVAL;
+
+	guard(mutex)(&apm->cfg_lock);
+
+	dma_dev = apm->cfg_dma_dev;
+	if (!dma_dev) {
+		dev_err(dev, "SET_CFG: no DSP-visible memory for %u bytes of parameters\n", size);
+		return -ENODEV;
+	}
+
+	buf_size = ALIGN(size, SZ_4K);
+	cpu = alloc_pages_exact(buf_size, GFP_KERNEL);
+	if (!cpu)
+		return -ENOMEM;
+	memcpy(cpu, records, size);
+	memset(cpu + size, 0, buf_size - size);
+
+	dma = dma_map_single(dma_dev, cpu, buf_size, DMA_BIDIRECTIONAL);
+	if (dma_mapping_error(dma_dev, dma)) {
+		free_pages_exact(cpu, buf_size);
+		return -ENOMEM;
+	}
+
+	/* The 4K pool maps whole pages; the payload at offset 0 is 32-byte aligned */
+	if (!IS_ALIGNED(dma, SZ_4K)) {
+		rc = -EINVAL;
+		goto free;
+	}
+
+	dsp_addr = dma;
+	if (apm->cfg_dma_sid >= 0)
+		dsp_addr |= (u64)apm->cfg_dma_sid << 32;
+
+	rc = q6apm_cfg_map(apm, dsp_addr, buf_size, &handle);
+	if (rc == -ETIMEDOUT || (!rc && !handle)) {
+		dev_err(dev, "SET_CFG: map of %u bytes at %pad uncertain (%d), leaking it\n",
+			buf_size, &dma, rc);
+		return rc ?: -EIO;
+	}
+	if (rc) {
+		/* Not sent, or answered with an error: nothing is mapped */
+		dev_err(dev, "SET_CFG: map of %u bytes failed: %d\n", buf_size, rc);
+		goto free;
+	}
+
+	rc = q6apm_cfg_set(apm, dsp_addr, handle, size);
+	dma_sync_single_for_cpu(dma_dev, dma, buf_size, DMA_BIDIRECTIONAL);
+	if (rc != -ETIMEDOUT) {
+		failed = q6apm_cfg_check_records(dev, records, cpu, size);
+		if (failed < 0)
+			rc = failed;
+		else if (failed && !rc)
+			rc = -EIO;
+	}
+	if (rc)
+		dev_err(dev, "SET_CFG of %u bytes out of band failed: %d\n", size, rc);
+
+	if (q6apm_cfg_unmap(apm, handle)) {
+		dev_err(dev, "SET_CFG: unmap of handle 0x%x failed, leaking %u bytes at %pad\n",
+			handle, buf_size, &dma);
+		return rc ?: -EIO;
+	}
+
+free:
+	dma_unmap_single(dma_dev, dma, buf_size, DMA_BIDIRECTIONAL);
+	free_pages_exact(cpu, buf_size);
+
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6apm_set_cfg_oob);
