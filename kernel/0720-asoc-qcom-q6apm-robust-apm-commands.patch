+/*
+ * Response matching needs the DSP to echo whole tokens: send GET_SPF_STATE
+ * with every sequence bit set and accept an answer carrying fewer, which
+ * sets narrow_tokens.
+ */
+static void q6apm_check_token_echo(struct q6apm *apm)
+{
+	gpr_device_t *gdev = apm->gdev;
+	struct q6apm_txn *txn = &apm->txn;
+	u32 sent = U32_MAX ^ APM_TOKEN_ID_MASK, echo;
+	bool done;
+	int rc;
+
+	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(0,
+								APM_CMD_GET_SPF_STATE, sent);
+	if (IS_ERR(pkt))
+		return;
+	pkt->hdr.dest_domain = audioreach_gpr_dest_domain(gdev);
+
+	guard(mutex)(&apm->lock);
+
+	scoped_guard(spinlock_irqsave, &apm->txn_lock) {
+		memset(txn, 0, sizeof(*txn));
+		txn->token = sent;
+		txn->opcode = APM_CMD_GET_SPF_STATE;
+		txn->rsp_opcode = APM_CMD_RSP_GET_SPF_STATE;
+		txn->probe = true;
+		txn->active = true;
+	}
+
+	rc = gpr_send_pkt(gdev, pkt);
+	if (rc >= 0)
+		wait_event_timeout(apm->wait, q6apm_txn_done(apm), 5 * HZ);
+
+	scoped_guard(spinlock_irqsave, &apm->txn_lock) {
+		done = txn->done;
+		echo = txn->echo;
+		apm->narrow_tokens = done && echo != sent;
+		txn->active = false;
+	}
+
+	if (!done)
+		dev_warn(apm->dev, "no answer to the token echo check (%d)\n",
+			 rc < 0 ? rc : -ETIMEDOUT);
+	else if (apm->narrow_tokens)
+		dev_err(apm->dev, "DSP echoes token 0x%x as 0x%x\n", sent, echo);
+}
 
