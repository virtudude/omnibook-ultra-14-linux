+EXPORT_SYMBOL_GPL(audioreach_sp_required);
+
+/**
+ * audioreach_sp_session_begin() - start the SP setup of a WSA RX graph
+ * @graph: the graph about to be configured
+ *
+ * Lets its SP modules be configured, in the current mode.
+ */
+void audioreach_sp_session_begin(struct q6apm_graph *graph)
+{
+	graph->sp = (struct audioreach_sp_pass) {
+		.active = true,
+		.mode = READ_ONCE(sp_operation_mode),
+	};
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_session_begin);
+
+/**
+ * audioreach_sp_session_end() - finish the SP setup of a WSA RX graph
+ * @graph: the graph
+ * @rc: result of its configuration
+ *
+ * SP RX without SP VI (or the reverse) is never accepted, and when speaker
+ * protection is required both must be there.
+ *
+ * Return: @rc if it is an error, else 0 or a negative error code.
+ */
+int audioreach_sp_session_end(struct q6apm_graph *graph, int rc)
+{
+	struct audioreach_sp_pass *sp = &graph->sp;
+	struct device *dev = graph->dev;
+
+	sp->active = false;
+	if (rc)
+		return rc;
+
+	if (sp->rx_ok != sp->vi_ok) {
+		dev_err(dev, "SP: SP RX %s but SP VI %s; refusing a half-protected graph\n",
+			sp->rx_ok ? "configured" : "missing", sp->vi_ok ? "configured" : "missing");
+		return -EPERM;
+	}
+	if (READ_ONCE(sp_required) && !sp->rx_ok) {
