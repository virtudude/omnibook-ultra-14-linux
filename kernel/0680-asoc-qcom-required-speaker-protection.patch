+static int audioreach_sp_vi_send_channel_map(struct q6apm_graph *graph,
+					     const struct audioreach_module *module,
+					     u32 num_speakers)
+{
+	struct apm_module_sp_vi_channel_map_cfg *cm_cfg;
+	int cm_sz = APM_SP_VI_CH_MAP_CFG_PSIZE(num_speakers * 2);
+	struct gpr_pkt *pkt;
+	int rc;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(cm_sz, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
+		return PTR_ERR(pkt);
+
+	cm_cfg = (void *)pkt + GPR_HDR_SIZE + APM_CMD_HDR_SIZE;
+	cm_cfg->param_data.module_instance_id = module->instance_id;
+	cm_cfg->param_data.error_code = 0;
+	cm_cfg->param_data.param_id = PARAM_ID_SP_VI_CHANNEL_MAP_CFG;
+	cm_cfg->param_data.param_size = cm_sz - APM_MODULE_PARAM_DATA_SIZE;
+	cm_cfg->cfg.num_channels = num_speakers * 2;
+
+	rc = audioreach_sp_vi_fill_chan_info(graph->dev, cm_cfg->cfg.channel_mapping,
+					     num_speakers, true);
+	if (!rc)
+		rc = q6apm_send_cmd_sync(graph->apm, pkt, 0);
+	kfree(pkt);
+	if (rc)
+		dev_err(graph->dev, "SP VI channel map failed: %d\n", rc);
