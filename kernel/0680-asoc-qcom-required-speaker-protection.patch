 {
 	struct audioreach_graph_info *info;
@@ -62,6 +91,12 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	if (!info)
 		return ERR_PTR(-ENODEV);
 
