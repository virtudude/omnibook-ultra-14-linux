-		dev_info(dev, "SP channel %u: R0 %d.%03d ohms (Q24 %d), T0 %d.%03d degC (Q6 %d)\n",
-			 i, r0_int, r0_frac, new.r0_cali_q24[i],
+		dev_info(dev, "SP channel %u %s: R0 %d.%03d ohms (Q24 %d), T0 %d.%03d degC (Q6 %d)\n",
+			 i, name, r0_int, r0_frac, new.r0_cali_q24[i],
 			 new.t0_cali_q6[i] / 64,
 			 abs((new.t0_cali_q6[i] % 64) * 1000 / 64),
 			 new.t0_cali_q6[i]);
@@ -1864,6 +1905,56 @@ static void audioreach_arm_vi_calibration(void)
 	memset(sp_vi_r0.seen_states, 0, sizeof(sp_vi_r0.seen_states));
 }
 
+/*
+ * PARAM_ID_SP_VI_CHANNEL_MAP_CFG lists, in the order they arrive, which
+ * speaker's Vsense (2n + 1) or Isense (2n + 2) each 16-bit V/I channel is.
+ * Each 32-bit word of the WSA V/I capture carries one speaker, V in bits
+ * 31..16 and I in bits 15..0, so in memory a word is I then V. Word n is
+ * codec DMA lane n, which is speaker n.
+ */
+static void audioreach_sp_vi_fill_chan_info(u32 *chan, u32 num_speakers)
+{
+	unsigned int s;
+
+	for (s = 0; s < num_speakers; s++) {
+		chan[2 * s] = 2 * s + 2;
+		chan[2 * s + 1] = 2 * s + 1;
+	}
+}
+
+/*
+ * The static cfg blob can carry its own channel map. Send ours after it so
+ * the speaker order is the one the R0/T0 and the tuning records use.
+ */
+static int audioreach_sp_vi_send_channel_map(struct q6apm_graph *graph,
+					     const struct audioreach_module *module,
+					     u32 num_speakers)
+{
+	struct apm_module_sp_vi_channel_map_cfg *cm_cfg;
+	int cm_sz = APM_SP_VI_CH_MAP_CFG_PSIZE(num_speakers * 2);
+	struct gpr_pkt *pkt;
+	int rc;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(cm_sz, APM_CMD_SET_CFG, 0);
+	if (IS_ERR(pkt))
