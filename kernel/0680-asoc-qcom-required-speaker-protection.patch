From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Mon, 9 Nov 2026 23:29:54 -0500
Subject: [PATCH 9/10] ASoC: qcom: x1e80100: require speaker protection when the DT
 says so

With "qcom,speaker-protection-required" on the sound node:
- the WSA RX graph must configure both SP modules, or its prepare fails;
- WSA playback is refused while any 'WSA_AIF_VI Mixer' input of the
  link's macros is off, or when the link has no macro V/I DAI;
- WSA_CODEC_DMA_RX_1 playback is refused, as only the WSA RX0 graph
  goes through the speaker protection checks.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/x1e80100.c | 53 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index 746419a30ce7..a993db485708 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -274,6 +274,47 @@ static int x1e80100_snd_hw_map_channels(unsigned int *ch_map, int num)
 	return 0;
 }
 
+/* With SP required, no speaker may play without V/I feedback */
+static int x1e80100_check_vi_mixers(struct snd_soc_pcm_runtime *rtd)
+{
+	static const char * const inputs[] = { "WSA_SPKR_VI_1", "WSA_SPKR_VI_2" };
+	struct snd_ctl_elem_value *val __free(kfree) = kzalloc(sizeof(*val), GFP_KERNEL);
+	struct snd_soc_dai *codec_dai;
+	int i, j, macros = 0;
+
+	if (!val)
+		return -ENOMEM;
+
+	for_each_rtd_codec_dais(rtd, i, codec_dai) {
+		const char *prefix = codec_dai->component->name_prefix;
+		char name[SNDRV_CTL_ELEM_ID_NAME_MAXLEN];
+		struct snd_kcontrol *kctl;
+
+		if (strcmp(codec_dai->driver->name, "wsa_macro_vifeedback"))
+			continue;
+		macros++;
+
+		for (j = 0; j < ARRAY_SIZE(inputs); j++) {
+			snprintf(name, sizeof(name), "%s%sWSA_AIF_VI Mixer %s",
+				 prefix ?: "", prefix ? " " : "", inputs[j]);
+			kctl = snd_soc_card_get_kcontrol(rtd->card, name);
+			memset(val, 0, sizeof(*val));
+			if (!kctl || kctl->get(kctl, val) || !val->value.integer.value[0]) {
+				dev_err(rtd->dev, "speaker protection required: '%s' is off\n",
+					name);
+				return -EPERM;
+			}
+		}
+	}
+
+	if (!macros) {
+		dev_err(rtd->dev, "speaker protection required: no WSA macro V/I feedback on the link\n");
+		return -EPERM;
+	}
+
+	return 0;
+}
+
 static int x1e80100_snd_prepare(struct snd_pcm_substream *substream)
 {
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
@@ -286,6 +327,16 @@ static int x1e80100_snd_prepare(struct snd_pcm_substream *substream)
 	switch (cpu_dai->id) {
 	case WSA_CODEC_DMA_RX_0:
 	case WSA_CODEC_DMA_RX_1:
+		if (audioreach_sp_required()) {
+			/* Only the WSA RX0 graph is checked for speaker protection */
+			if (cpu_dai->id != WSA_CODEC_DMA_RX_0) {
+				dev_err(rtd->dev, "speaker protection required: speakers only through WSA_CODEC_DMA_RX_0\n");
+				return -EPERM;
+			}
+			ret = x1e80100_check_vi_mixers(rtd);
+			if (ret)
+				return ret;
+		}
 		ret = x1e80100_snd_hw_map_channels(rx_slot, channels);
 		if (ret)
 			return ret;
@@ -366,6 +417,8 @@ static int x1e80100_platform_probe(struct platform_device *pdev)
 
 	card->driver_name = of_device_get_match_data(dev);
 	x1e80100_add_be_ops(card);
+	audioreach_sp_set_required(of_property_read_bool(dev->of_node,
+							 "qcom,speaker-protection-required"));
 
 	return devm_snd_soc_register_card(dev, card);
 }
From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Tue, 10 Nov 2026 23:12:57 -0500
Subject: [PATCH 10/10] ASoC: qcom: q6apm: refuse graphs that tap another graph's SP
 VI subgraph

A topology can let a capture graph read from a subgraph of another
graph. Reading the SP VI subgraph of the WSA RX graph opens, and later
closes, a graph around the V/I feedback speaker protection depends on,
outside the pass that configures SP RX and SP VI together.

Refuse such a connection in the mixer put that sets the graph's source
module, and again at graph open, since the put changes the graph info
before its DAPM update.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/q6apm.c    | 35 +++++++++++++++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6apm.h    |  1 +
 sound/soc/qcom/qdsp6/topology.c | 10 ++++++++++
 3 files changed, 46 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index f032ec52fc1c..c1cdfe860f4d 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -42,6 +42,35 @@ int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 
 static void q6apm_put_audioreach_graph(struct kref *ref);
 
+/*
+ * Would @info read @src_iid from another graph's SP VI subgraph? Such a raw
+ * V/I tap is refused: that subgraph is configured together with SP RX.
+ */
+bool q6apm_is_sp_vi_tap(struct q6apm *apm, u32 src_iid, struct audioreach_graph_info *info)
+{
+	struct audioreach_container *container;
+	struct audioreach_module *src, *module;
+	struct audioreach_sub_graph *sg;
+
+	if (!src_iid)
+		return false;
+
+	src = idr_find(&apm->modules_idr, src_iid);
+	if (!src || !src->container || !src->container->sub_graph)
+		return false;
+
+	sg = src->container->sub_graph;
+	if (sg->info == info)
+		return false;
+
+	list_for_each_entry(container, &sg->container_list, node)
+		list_for_each_entry(module, &container->modules_list, node)
+			if (module->module_id == MODULE_ID_SPEAKER_PROTECTION_VI)
+				return true;
+
+	return false;
+}
+
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
 {
 	struct audioreach_graph_info *info;
@@ -62,6 +91,12 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	if (!info)
 		return ERR_PTR(-ENODEV);
 
+	if (q6apm_is_sp_vi_tap(apm, info->src_mod_inst_id, info)) {
+		dev_err(apm->dev, "SP: graph %u taps the V/I of another graph; refusing\n",
+			graph_id);
+		return ERR_PTR(-EPERM);
+	}
+
 	graph = kzalloc_obj(*graph);
 	if (!graph)
 		return ERR_PTR(-ENOMEM);
