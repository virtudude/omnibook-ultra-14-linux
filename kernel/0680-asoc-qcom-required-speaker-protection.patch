 	unsigned int i;
 
@@ -1587,16 +1602,40 @@ int audioreach_sp_register_speaker_map(struct thermal_zone_device * const *tzs,
 
 	guard(mutex)(&sp_speaker_map_lock);
 
-	for (i = 0; i < num; i++)
+	memset(&sp_speaker_map, 0, sizeof(sp_speaker_map));
+	for (i = 0; i < num; i++) {
 		sp_speaker_map.tz[i] = tzs[i];
-	for (; i < MAX_SP_VI_SPEAKERS; i++)
-		sp_speaker_map.tz[i] = NULL;
+		if (names && names[i])
+			strscpy(sp_speaker_map.name[i], names[i]);
+		else
+			snprintf(sp_speaker_map.name[i], sizeof(sp_speaker_map.name[i]),
+				 "spk%u", i);
+		if (lane_order)
+			pr_info("SP speaker %u %s: codec DMA lane %u\n",
+				i, sp_speaker_map.name[i], i);
