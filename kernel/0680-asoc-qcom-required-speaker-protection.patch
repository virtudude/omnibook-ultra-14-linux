+/*
+ * PARAM_ID_SP_VI_CHANNEL_MAP_CFG lists, in the order they arrive, which
+ * speaker's Vsense (2n + 1) or Isense (2n + 2) each 16-bit V/I channel is.
+ * Each 32-bit word of the WSA V/I capture carries one speaker, V in bits
+ * 31..16 and I in bits 15..0, so in memory a word is I then V. Word m is
+ * codec DMA lane m, which holds the speaker whose registered lane is m.
+ */
+static int audioreach_sp_vi_fill_chan_info(struct device *dev, u32 *chan,
+					   u32 num_speakers, bool log)
+{
+	char name[MAX_SP_VI_SPEAKERS][32];
+	u8 lane[MAX_SP_VI_SPEAKERS];
+	unsigned int s;
+
+	if (audioreach_sp_get_lanes(lane, name, num_speakers)) {
+		dev_err(dev, "SP speaker map does not match the %u-speaker VI graph\n",
+			num_speakers);
+		return -EINVAL;
+	}
+
+	for (s = 0; s < num_speakers; s++) {
+		chan[2 * lane[s]] = 2 * s + 2;
+		chan[2 * lane[s] + 1] = 2 * s + 1;
+		if (log)
+			dev_info(dev, "SP VI speaker %u %s: lane %u, I = ch %u, V = ch %u\n",
+				 s, name[s], lane[s], 2 * lane[s] + 1, 2 * lane[s] + 2);
+	}
+
+	return 0;
