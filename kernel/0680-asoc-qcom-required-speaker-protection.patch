+/*
+ * The SP speakers in codec DMA lane order, set by the machine driver for the
+ * card's lifetime: speaker n is lane n, its V/I capture word and its RX
+ * samples. The R0/T0 and T0 controls, the calibration results and the SP/VI
+ * tuning records follow this order.
+ */
 static struct {
 	struct thermal_zone_device	*tz[MAX_SP_VI_SPEAKERS];
+	char				 name[MAX_SP_VI_SPEAKERS][32];
 	unsigned int			 num;
+	bool				 lane_order;
 } sp_speaker_map;
 static DEFINE_MUTEX(sp_speaker_map_lock);
 
@@ -1577,8 +1584,16 @@ void audioreach_get_sp_vi_r0t0(long *vals, unsigned int count)
 	}
 }
 
+/**
+ * audioreach_sp_register_speaker_map() - set the SP speakers
+ * @tzs: each speaker's thermal zone, or NULL
+ * @names: each speaker's name, for the log
+ * @num: number of speakers, 0 to clear
+ * @lane_order: the speakers are in codec DMA lane order; SP runs only then
