+static const struct audioreach_module *
+audioreach_sg_find_module(const struct audioreach_module *ref, u32 iid)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+
+	if (!ref->container || !ref->container->sub_graph)
+		return NULL;
+	sg = ref->container->sub_graph;
+
+	list_for_each_entry(c, &sg->container_list, node)
+		list_for_each_entry(m, &c->modules_list, node)
+			if (m->instance_id == iid)
+				return m;
+
+	return NULL;
+}
+
+static bool audioreach_fed_by_mfc(const struct audioreach_module *module)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+
+	if (!module->container || !module->container->sub_graph)
+		return false;
+	sg = module->container->sub_graph;
+
+	list_for_each_entry(c, &sg->container_list, node)
+		list_for_each_entry(m, &c->modules_list, node)
+			if (m->module_id == MODULE_ID_MFC &&
+			    m->dst_mod_inst_id[0] == module->instance_id)
+				return true;
+
+	return false;
+}
+
+static u32 audioreach_next_module_id(const struct audioreach_module *module)
+{
+	const struct audioreach_module *next;
+
+	if (!module->dst_mod_inst_id[0])
+		return 0;
+	next = audioreach_sg_find_module(module, module->dst_mod_inst_id[0]);
+
+	return next ? next->module_id : 0;
+}
+
+/*
+ * The SP RX module works in speaker order, the codec DMA sink in lane order.
+ * The MFC in front of the SP module outputs the speakers in speaker order
+ * (each one under its lane's channel type), and an MFC after it puts them
+ * back in lane order by channel type.
+ */
+static int audioreach_sp_rx_mfc_cfg(struct device *dev,
+				    const struct audioreach_module_config *cfg,
+				    struct audioreach_module_config *out)
+{
+	char name[MAX_SP_VI_SPEAKERS][32];
+	u8 lane[MAX_SP_VI_SPEAKERS];
+	unsigned int s, n = cfg->num_channels;
+
+	if (n > MAX_SP_VI_SPEAKERS || audioreach_sp_get_lanes(lane, name, n)) {
+		dev_err(dev, "SP speaker map does not match the %u-channel SP RX graph\n", n);
+		return -EINVAL;
+	}
+
+	*out = *cfg;
+	for (s = 0; s < n; s++) {
