+/*
+ * One SP configuration pass (a WSA RX graph prepare): the mode and speaker
+ * map are snapshotted at its start so RX and VI are set up from the same
+ * values.
+ */
+static struct {
+	bool	active;
+	u32	mode;
+	u8	lane[MAX_SP_VI_SPEAKERS];
+	char	name[MAX_SP_VI_SPEAKERS][32];
+	unsigned int num;
+	bool	lanes_set;
+	bool	rx_ok;
+	bool	vi_ok;
+} sp_session;
+static DEFINE_MUTEX(sp_session_lock);
+static bool sp_required;
+
 /* SubGraph Config */
 struct apm_sub_graph_data {
 	struct apm_sub_graph_cfg sub_graph_cfg;
@@ -1639,6 +1657,19 @@ static int audioreach_sp_get_lanes(u8 *lane, char (*name)[32], unsigned int num)
 	if (!num || num > MAX_SP_VI_SPEAKERS)
 		return -EINVAL;
 
+	scoped_guard(mutex, &sp_session_lock) {
+		if (sp_session.active) {
+			if (!sp_session.lanes_set || sp_session.num != num)
+				return -EINVAL;
+			for (i = 0; i < num; i++) {
+				lane[i] = sp_session.lane[i];
+				if (name)
+					strscpy(name[i], sp_session.name[i]);
+			}
+			return 0;
+		}
+	}
+
 	guard(mutex)(&sp_speaker_map_lock);
 
 	if (!sp_speaker_map.lanes_set || sp_speaker_map.num != num)
@@ -1653,6 +1684,93 @@ static int audioreach_sp_get_lanes(u8 *lane, char (*name)[32], unsigned int num)
 	return 0;
 }
 
+void audioreach_sp_set_required(bool required)
+{
+	WRITE_ONCE(sp_required, required);
+	pr_info("SP: speaker protection %s on the WSA speakers\n",
+		required ? "required" : "optional");
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_set_required);
+
+bool audioreach_sp_required(void)
+{
+	return READ_ONCE(sp_required);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_required);
+
+/* Start a configuration pass: snapshot the mode and the speaker map */
+void audioreach_sp_session_begin(void)
+{
+	guard(mutex)(&sp_speaker_map_lock);
+	guard(mutex)(&sp_session_lock);
+
+	sp_session.mode = READ_ONCE(sp_operation_mode);
+	sp_session.num = sp_speaker_map.num;
+	sp_session.lanes_set = sp_speaker_map.lanes_set;
+	memcpy(sp_session.lane, sp_speaker_map.lane, sizeof(sp_session.lane));
+	memcpy(sp_session.name, sp_speaker_map.name, sizeof(sp_session.name));
