diff --git a/drivers/platform/arm64/hp-omnibook-ec.c b/drivers/platform/arm64/hp-omnibook-ec.c
new file mode 100644
index 000000000000..e786f99589c3
--- /dev/null
+++ b/drivers/platform/arm64/hp-omnibook-ec.c
@@ -0,0 +1,543 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * HP OmniBook (Snapdragon X2) embedded controller
+ *
+ * Copyright (c) 2026 Rahul Pon
+ * Copyright (c) 2026 virtudude
+ *
+ * Based on Rahul Pon's HP OmniBook 5 16 EC driver: both laptops' ACPI
+ * tables drive the EC through the same mailbox (HP's HQEX method). Wait for
+ * an idle status, write the command and sub-command, wait for completion,
+ * then read the 32-byte reply. The EC's interrupt line signals events, read
+ * from register 0x00 and acknowledged by writing 0 back.
+ */
+
+#include <linux/bits.h>
+#include <linux/cleanup.h>
+#include <linux/delay.h>
+#include <linux/hwmon.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/sparse-keymap.h>
+#include <linux/interrupt.h>
+#include <linux/leds.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+#include <linux/unaligned.h>
+
+#define HPEC_EVENT		0x00
+#define HPEC_REQUEST		0xed
+#define HPEC_REPLY		0xee
+#define HPEC_STATUS		0xef
+#define HPEC_REPLY_LEN		32
+
+#define HPEC_STATUS_IDLE	0x00
+#define HPEC_STATUS_DONE	0xe0
+#define HPEC_POLL_TRIES		20
+#define HPEC_POLL_US		5000
+
+#define HPEC_KBD		0x05
+#define HPEC_KBD_TIMEOUT_GET	0xfe
+#define HPEC_KBD_LEVEL_GET	0xff
+#define HPEC_LED		0x06
+#define HPEC_LED_GET		0xff
+/* LED states in byte 1 of the HPEC_LED_GET reply, one bit per EC LED from LED 8 */
+#define HPEC_LED_STATE(n)	BIT((n) - 0x08)
+#define HPEC_THERMISTOR		0x26
+#define HPEC_THERMISTOR_INVALID	0xff
+#define HPEC_FAN		0xbc
+#define HPEC_FAN_RPM		0x03
+#define HPEC_FN_LOCK		0xbd
+#define HPEC_FN_LOCK_GET	0x01
+/* Reply byte 0 of HPEC_FN_LOCK_GET in action-keys mode (media keys first) */
+#define HPEC_FN_LOCK_ACTION_KEYS 0x01
+
+#define HPEC_EVENT_CPU_HOT	0x0b
+#define HPEC_EVENT_KBD		0x0d
+#define HPEC_EVENT_SKIN_HOT	0x10
+#define HPEC_EVENT_KBD_KEY	0x1d
+#define HPEC_EVENT_FAN_STATUS	0x30
+#define HPEC_EVENT_FAN_SPEED	0x32
+#define HPEC_EVENT_THERMISTOR	0x36
+#define HPEC_EVENT_FN_LOCK	0x88
+
+/* Events read per interrupt before giving up on draining the register */
+#define HPEC_MAX_EVENTS		8
+
+/* HP's WMI hotkey codes for these EC events are the ones hp-wmi maps */
+static const struct key_entry hpec_keymap[] = {
+	{ KE_KEY, 0x11, { KEY_MICMUTE } },	/* F9, WMI 0x270 */
+	{ KE_KEY, 0x1e, { KEY_PROG2 } },	/* F11, WMI 0x21a8 */
+	{ KE_END, 0 }
+};
+
+/* Keyboard backlight timeout, in EC value order */
+static const char * const hpec_kbd_timeouts[] = { "30s", "3min", "always" };
+
+/* EC LEDs 8 and 9, which HP's mute LED WMI methods drive */
+static const struct {
+	const char *name;
+	u8 index;
+} hpec_leds[] = {
+	{ "platform::mute", 0x08 },
+	{ "platform::micmute", 0x09 },
+};
+
+/* HP's TZ31..TZ33; TZ34..TZ37 (thermistors 0x06, 0x04, 0x02, 0x01) are disabled */
+static const u8 hpec_thermistors[] = { 0x00, 0x0a, 0x05 };
+
+struct hpec;
+
+struct hpec_led {
+	struct led_classdev cdev;
+	struct hpec *ec;
+	u8 index;
+};
+
+struct hpec {
+	struct i2c_client *client;
+	struct mutex lock;	/* serializes EC transfers */
+	struct device *hwmon;
+	struct hpec_led leds[ARRAY_SIZE(hpec_leds)];
+	struct led_classdev kbd_led;
+	struct input_dev *input;
+};
+
+static int hpec_wait(struct hpec *ec, u8 status)
+{
+	int i, ret;
+
+	for (i = 0; i < HPEC_POLL_TRIES; i++) {
+		ret = i2c_smbus_read_byte_data(ec->client, HPEC_STATUS);
+		if (ret < 0)
+			return ret;
+		if (ret == status)
+			return 0;
+		fsleep(HPEC_POLL_US);
+	}
+
+	return -ETIMEDOUT;
+}
+
+static int hpec_command(struct hpec *ec, u8 cmd, u8 sub, u8 reply[HPEC_REPLY_LEN])
+{
+	u8 request[] = { cmd, sub };
+	int ret;
+
+	guard(mutex)(&ec->lock);
+
+	ret = hpec_wait(ec, HPEC_STATUS_IDLE);
+	if (ret)
+		return ret;
+
+	ret = i2c_smbus_write_i2c_block_data(ec->client, HPEC_REQUEST,
+					     sizeof(request), request);
+	if (ret)
+		return ret;
+
+	/*
+	 * Commands without a reply end here: the EC returns to idle without
+	 * its reply buffer being read, and HP's ACPI does not read it either.
+	 */
+	ret = hpec_wait(ec, HPEC_STATUS_DONE);
+	if (ret || !reply)
+		return ret;
+
+	ret = i2c_smbus_read_i2c_block_data(ec->client, HPEC_REPLY,
+					    HPEC_REPLY_LEN, reply);
+	if (ret < 0)
+		return ret;
+
+	return ret == HPEC_REPLY_LEN ? 0 : -EIO;
+}
+
+static int hpec_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			   u32 attr, int channel, long *val)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+	u8 reply[HPEC_REPLY_LEN];
+	int ret;
+
+	switch (type) {
+	case hwmon_fan:
+		ret = hpec_command(ec, HPEC_FAN, HPEC_FAN_RPM, reply);
+		if (ret)
+			return ret;
+		*val = get_unaligned_le16(reply);
+		return 0;
+	case hwmon_temp:
+		ret = hpec_command(ec, HPEC_THERMISTOR,
+				   hpec_thermistors[channel], reply);
+		if (ret)
+			return ret;
+		if (reply[0] == HPEC_THERMISTOR_INVALID)
+			return -ENODATA;
+		*val = reply[0] * 1000;
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static const char * const hpec_thermistor_labels[] = {
+	"EC thermistor 1", "EC thermistor 2", "EC thermistor 3",
+};
+
+static int hpec_hwmon_read_string(struct device *dev, enum hwmon_sensor_types type,
+				  u32 attr, int channel, const char **str)
+{
+	*str = hpec_thermistor_labels[channel];
+	return 0;
+}
+
+static const struct hwmon_ops hpec_hwmon_ops = {
+	.visible = 0444,
+	.read = hpec_hwmon_read,
+	.read_string = hpec_hwmon_read_string,
+};
+
+static const struct hwmon_channel_info * const hpec_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(chip, HWMON_C_REGISTER_TZ),
+	HWMON_CHANNEL_INFO(fan, HWMON_F_INPUT),
+	HWMON_CHANNEL_INFO(temp,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL,
+			   HWMON_T_INPUT | HWMON_T_LABEL),
+	NULL
+};
+
+static const struct hwmon_chip_info hpec_hwmon_chip = {
+	.ops = &hpec_hwmon_ops,
+	.info = hpec_hwmon_info,
+};
+
+static enum led_brightness hpec_led_get(struct led_classdev *cdev)
+{
+	struct hpec_led *led = container_of(cdev, struct hpec_led, cdev);
+	u8 reply[HPEC_REPLY_LEN];
+
+	if (hpec_command(led->ec, HPEC_LED, HPEC_LED_GET, reply))
+		return cdev->brightness;
+
+	return reply[1] & HPEC_LED_STATE(led->index) ? LED_ON : LED_OFF;
+}
+
+/*
+ * Only the backlight key changes the level, inside the EC: HP's ACPI has
+ * no command that sets it, so the LED has no set callback.
+ */
+static int hpec_kbd_level(struct hpec *ec)
+{
+	u8 reply[HPEC_REPLY_LEN];
+	int ret;
+
+	ret = hpec_command(ec, HPEC_KBD, HPEC_KBD_LEVEL_GET, reply);
+	if (ret)
+		return ret;
+
+	return min_t(u8, reply[0], ec->kbd_led.max_brightness);
+}
+
+static enum led_brightness hpec_kbd_led_get(struct led_classdev *cdev)
+{
+	struct hpec *ec = container_of(cdev, struct hpec, kbd_led);
+	int level = hpec_kbd_level(ec);
+
+	return level < 0 ? cdev->brightness : level;
+}
+
+static void hpec_handle_event(struct hpec *ec, u8 event)
+{
+	struct device *dev = &ec->client->dev;
+	const struct key_entry *key;
+	int level;
+
+	switch (event) {
+	case HPEC_EVENT_KBD:
+	case HPEC_EVENT_KBD_KEY:
+		/* HP's ACPI reads both the level and the timeout on these */
+		level = hpec_kbd_level(ec);
+		if (level >= 0)
+			led_classdev_notify_brightness_hw_changed(&ec->kbd_led, level);
+		sysfs_notify(&dev->kobj, NULL, "kbd_backlight_timeout");
+		return;
+	case HPEC_EVENT_FN_LOCK:
+		sysfs_notify(&dev->kobj, NULL, "fn_lock");
+		return;
+	case HPEC_EVENT_CPU_HOT:
+	case HPEC_EVENT_SKIN_HOT:
+		/* HP's ACPI asks the OS to hibernate on these */
+		dev_crit_ratelimited(dev, "EC reports a critical temperature (event %#x)\n",
+				     event);
+		return;
+	case HPEC_EVENT_FAN_STATUS:
+	case HPEC_EVENT_FAN_SPEED:
+		hwmon_notify_event(ec->hwmon, hwmon_fan, hwmon_fan_input, 0);
+		return;
+	case HPEC_EVENT_THERMISTOR ... HPEC_EVENT_THERMISTOR + ARRAY_SIZE(hpec_thermistors) - 1:
+		hwmon_notify_event(ec->hwmon, hwmon_temp, hwmon_temp_input,
+				   event - HPEC_EVENT_THERMISTOR);
+		return;
+	}
+
+	key = sparse_keymap_entry_from_scancode(ec->input, event);
+	if (key)
+		sparse_keymap_report_entry(ec->input, key, 1, true);
+	else
+		dev_dbg(dev, "unhandled EC event %#x\n", event);
+}
+
+static int hpec_read_event(struct hpec *ec)
+{
+	int event, ret;
+
+	guard(mutex)(&ec->lock);
+
+	event = i2c_smbus_read_byte_data(ec->client, HPEC_EVENT);
+	if (event <= 0)
+		return event;
+
+	ret = i2c_smbus_write_byte_data(ec->client, HPEC_EVENT, 0);
+
+	return ret ?: event;
+}
+
+/*
+ * The line is edge-triggered, so read until the EC reports no pending
+ * event: one left behind would otherwise wait for the next edge.
+ */
+static irqreturn_t hpec_irq(int irq, void *data)
+{
+	struct hpec *ec = data;
+	struct device *dev = &ec->client->dev;
+	unsigned int i;
+	int event;
+
+	for (i = 0; i < HPEC_MAX_EVENTS; i++) {
+		event = hpec_read_event(ec);
+		if (event < 0) {
+			dev_err_ratelimited(dev, "cannot read or acknowledge EC event: %d\n",
+					    event);
+			break;
+		}
+		if (!event)
+			break;
+
+		dev_dbg(dev, "EC event %#x\n", event);
+		hpec_handle_event(ec, event);
+	}
+
+	return i ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static ssize_t kbd_backlight_timeout_show(struct device *dev,
+					  struct device_attribute *attr, char *buf)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+	u8 reply[HPEC_REPLY_LEN];
+	int ret;
+
+	ret = hpec_command(ec, HPEC_KBD, HPEC_KBD_TIMEOUT_GET, reply);
+	if (ret)
+		return ret;
+
+	if (reply[0] >= ARRAY_SIZE(hpec_kbd_timeouts))
+		return sysfs_emit(buf, "%#x\n", reply[0]);
+
+	return sysfs_emit(buf, "%s\n", hpec_kbd_timeouts[reply[0]]);
+}
+
+static ssize_t kbd_backlight_timeout_store(struct device *dev,
+					   struct device_attribute *attr,
+					   const char *buf, size_t count)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+	int i, ret;
+
+	i = sysfs_match_string(hpec_kbd_timeouts, buf);
+	if (i < 0)
+		return i;
+
+	ret = hpec_command(ec, HPEC_KBD, i, NULL);
+
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(kbd_backlight_timeout);
+
+/* Left Shift+Fn switches the mode inside the EC; this reads it as HP's ACPI does */
+static ssize_t fn_lock_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+	u8 reply[HPEC_REPLY_LEN];
+	int ret;
+
+	ret = hpec_command(ec, HPEC_FN_LOCK, HPEC_FN_LOCK_GET, reply);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%d\n", reply[0] != HPEC_FN_LOCK_ACTION_KEYS);
+}
+static DEVICE_ATTR_RO(fn_lock);
+
+static struct attribute *hpec_attrs[] = {
+	&dev_attr_fn_lock.attr,
+	&dev_attr_kbd_backlight_timeout.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(hpec);
+
+static int hpec_register_leds(struct hpec *ec)
+{
+	struct device *dev = &ec->client->dev;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(hpec_leds); i++) {
+		struct hpec_led *led = &ec->leds[i];
+
+		led->ec = ec;
+		led->index = hpec_leds[i].index;
+		led->cdev.name = hpec_leds[i].name;
+		led->cdev.max_brightness = 1;
+		led->cdev.brightness_get = hpec_led_get;
+
+		ret = devm_led_classdev_register(dev, &led->cdev);
+		if (ret)
+			return ret;
+	}
+
+	ec->kbd_led.name = "platform::kbd_backlight";
+	ec->kbd_led.max_brightness = 2;
+	ec->kbd_led.flags = LED_BRIGHT_HW_CHANGED;
+	ec->kbd_led.brightness_get = hpec_kbd_led_get;
+
+	return devm_led_classdev_register(dev, &ec->kbd_led);
+}
+
+static int hpec_register_input(struct hpec *ec)
+{
+	struct device *dev = &ec->client->dev;
+	int ret;
+
+	ec->input = devm_input_allocate_device(dev);
+	if (!ec->input)
+		return -ENOMEM;
+
+	ec->input->name = "HP OmniBook EC hotkeys";
+	ec->input->phys = "hp-omnibook-ec/input0";
+	ec->input->id.bustype = BUS_I2C;
+
+	ret = sparse_keymap_setup(ec->input, hpec_keymap, NULL);
+	if (ret)
+		return ret;
+
+	return input_register_device(ec->input);
+}
+
+static int hpec_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	u8 reply[HPEC_REPLY_LEN];
+	struct hpec *ec;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA |
+						      I2C_FUNC_SMBUS_I2C_BLOCK))
+		return -ENODEV;
+
+	ec = devm_kzalloc(dev, sizeof(*ec), GFP_KERNEL);
+	if (!ec)
+		return -ENOMEM;
+
+	ec->client = client;
+	i2c_set_clientdata(client, ec);
+
+	ret = devm_mutex_init(dev, &ec->lock);
+	if (ret)
+		return ret;
+
+	ret = hpec_command(ec, HPEC_FAN, HPEC_FAN_RPM, reply);
+	if (ret)
+		return dev_err_probe(dev, ret, "EC does not answer\n");
+
+	ec->hwmon = devm_hwmon_device_register_with_info(dev, "hp_omnibook_ec", ec,
+							 &hpec_hwmon_chip, NULL);
+	if (IS_ERR(ec->hwmon))
+		return PTR_ERR(ec->hwmon);
+
+	ret = hpec_register_leds(ec);
+	if (ret)
+		return ret;
+
+	if (client->irq <= 0)
+		return 0;
+
+	ret = hpec_register_input(ec);
+	if (ret)
+		return ret;
+
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, hpec_irq,
+					IRQF_ONESHOT, "hp-omnibook-ec", ec);
+	if (ret)
+		return ret;
+
+	/* An event raised before the handler was installed has no edge left */
+	irq_wake_thread(client->irq, ec);
+
+	return 0;
+}
+
+/*
+ * The EC's events are not wakeup events: the lid and the keyboard wake the
+ * laptop, and fan and temperature changes must not. The line is masked
+ * while it is disabled, so events raised in suspend are read on resume.
+ */
+static int hpec_suspend(struct device *dev)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+
+	if (ec->client->irq > 0)
+		disable_irq(ec->client->irq);
+
+	return 0;
+}
+
+static int hpec_resume(struct device *dev)
+{
+	struct hpec *ec = dev_get_drvdata(dev);
+
+	if (ec->client->irq > 0) {
+		enable_irq(ec->client->irq);
+		irq_wake_thread(ec->client->irq, ec);
+	}
+
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(hpec_pm_ops, hpec_suspend, hpec_resume);
+
+static const struct of_device_id hpec_of_match[] = {
+	{ .compatible = "hp,omnibook-ultra-kg0xxx-ec" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hpec_of_match);
+
+static struct i2c_driver hpec_driver = {
+	.driver = {
+		.name = "hp-omnibook-ec",
+		.of_match_table = hpec_of_match,
+		.dev_groups = hpec_groups,
+		.pm = pm_sleep_ptr(&hpec_pm_ops),
+	},
+	.probe = hpec_probe,
+};
+module_i2c_driver(hpec_driver);
+
+MODULE_AUTHOR("virtudude <virtudude@protonmail.com>");
+MODULE_DESCRIPTION("HP OmniBook (Snapdragon X2) embedded controller");
+MODULE_LICENSE("GPL");
