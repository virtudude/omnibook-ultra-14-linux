From a022856bb54fde4fa0096252f21f6e7e0aa42ef9 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:03:28 -0500
Subject: [PATCH] ASoC: qcom: add a debug raw V/I tap behind the protected WSA
 RX graph

Speaker qualification needs the raw V/I sense data while speaker
protection runs as in normal use, but any graph tapping the SP VI
subgraph of another graph is refused.

Add the debug parameter snd_q6apm.sp_vi_tap_debug, off by default and
honoured only where speaker protection is required. With it the
x1e80100 driver adds a codec-less WSA_CODEC_DMA_TX_0 backend whose DAI
owns no graph, so a capture front end can read the V/I subgraph through
a splitter. The tap only runs while the WSA RX graph is open and its
last pass configured both SP modules, and is revoked when that graph
closes or fails.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/audioreach.c       | 41 ++++++++++++++++
 sound/soc/qcom/qdsp6/audioreach.h       |  3 ++
 sound/soc/qcom/qdsp6/q6apm-lpass-dais.c | 44 ++++++++++++++++-
 sound/soc/qcom/qdsp6/q6apm.c            |  6 ++-
 sound/soc/qcom/qdsp6/topology.c         |  3 +-
 sound/soc/qcom/x1e80100.c               | 63 +++++++++++++++++++++++++
 6 files changed, 155 insertions(+), 5 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/audioreach.c b/sound/soc/qcom/qdsp6/audioreach.c
index b28456adbf24..b5bda1270e8d 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -86,6 +86,25 @@ static bool sp_required;
 /* Speakers (speaker map order) whose SP RX input must be high-passed */
 static u32 sp_hpf_speakers;
 
+/*
+ * Debug only: let a capture graph tap raw V/I from the SP VI subgraph of the
+ * running WSA RX graph. Honoured only where SP is required, so SP RX, SP VI
+ * and the V/I guard still run as in normal use.
+ */
+static bool sp_vi_tap_debug;
+module_param(sp_vi_tap_debug, bool, 0444);
+MODULE_PARM_DESC(sp_vi_tap_debug,
+		 "Debug: allow a raw V/I capture tap behind the protected WSA RX graph");
+
+/* WSA RX graph open, and its last pass configured SP RX and SP VI */
+static bool sp_rx_protected;
+
+bool audioreach_sp_vi_tap_enabled(void)
+{
+	return READ_ONCE(sp_vi_tap_debug) && READ_ONCE(sp_required);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_vi_tap_enabled);
+
 /* SubGraph Config */
 struct apm_sub_graph_data {
 	struct apm_sub_graph_cfg sub_graph_cfg;
@@ -2062,9 +2081,28 @@ void audioreach_sp_session_begin(void)
 	sp_session.hpf_expected = 0;
 	sp_session.hpf_checked = 0;
 	sp_session.active = true;
+	sp_rx_protected = false;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_begin);
 
+/* The WSA RX graph is closing or was torn down */
+void audioreach_sp_rx_closed(void)
+{
+	guard(mutex)(&sp_session_lock);
+
+	sp_rx_protected = false;
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_rx_closed);
+
+/* May a raw V/I tap run now? Only behind a protected, open WSA RX graph */
+bool audioreach_sp_vi_tap_allowed(void)
+{
+	guard(mutex)(&sp_session_lock);
+
+	return sp_rx_protected && audioreach_sp_vi_tap_enabled();
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_vi_tap_allowed);
+
 /*
  * End a configuration pass. SP RX without SP VI (or the reverse) is never
  * accepted, and when speaker protection is required both must be there.
@@ -2095,6 +2133,9 @@ int audioreach_sp_session_end(struct device *dev)
 		return -EPERM;
 	}
 
+	scoped_guard(mutex, &sp_session_lock)
+		sp_rx_protected = rx && vi;
+
 	return 0;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_end);
diff --git a/sound/soc/qcom/qdsp6/audioreach.h b/sound/soc/qcom/qdsp6/audioreach.h
index 592ff35ef130..72d2f2c2438f 100644
--- a/sound/soc/qcom/qdsp6/audioreach.h
+++ b/sound/soc/qcom/qdsp6/audioreach.h
@@ -1178,6 +1178,9 @@ void audioreach_sp_set_r0t0_from_uefi(bool enable, u32 r0_min_uohm, u32 r0_max_u
 bool audioreach_sp_required(void);
 unsigned int audioreach_sp_num_speakers(void);
 void audioreach_sp_set_hpf_speakers(u32 speakers);
+bool audioreach_sp_vi_tap_enabled(void);
+bool audioreach_sp_vi_tap_allowed(void);
+void audioreach_sp_rx_closed(void);
 void audioreach_sp_session_begin(void);
 int audioreach_sp_session_end(struct device *dev);
 int audioreach_get_sp_vi_cal_state(long *vals, unsigned int count);
diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
index 2863cb0376d0..97101e7d30d0 100644
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -182,11 +182,26 @@ static int q6dma_hw_params(struct snd_pcm_substream *substream,
 	return 0;
 }
 
+/*
+ * The debug raw V/I tap owns no graph: it reads the SP VI subgraph of the
+ * WSA RX graph, so it only gets data while that graph runs protected.
+ */
+static bool q6apm_lpass_dai_is_vi_tap(struct snd_soc_dai *dai)
+{
+	return dai->id == WSA_CODEC_DMA_TX_0 && audioreach_sp_vi_tap_enabled();
+}
+
 static void q6apm_lpass_dai_shutdown(struct snd_pcm_substream *substream, struct snd_soc_dai *dai)
 {
 	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
 	int rc;
 
+	if (q6apm_lpass_dai_is_vi_tap(dai))
+		return;
+
+	if (dai->id == WSA_CODEC_DMA_RX_0)
+		audioreach_sp_rx_closed();
+
 	if (dai_data->is_port_started[dai->id]) {
 		rc = q6apm_graph_stop(dai_data->graph[dai->id]);
 		dai_data->is_port_started[dai->id] = false;
@@ -206,16 +221,26 @@ static int q6apm_lpass_dai_trigger(struct snd_pcm_substream *substream, int cmd,
 	struct q6apm_lpass_dai_data *dai_data = dev_get_drvdata(dai->dev);
 	int ret = 0;
 
+	if (q6apm_lpass_dai_is_vi_tap(dai)) {
+		if (cmd == SNDRV_PCM_TRIGGER_START && !audioreach_sp_vi_tap_allowed())
+			return -EPERM;
+		return 0;
+	}
+
 	switch (cmd) {
 	case SNDRV_PCM_TRIGGER_START:
 	case SNDRV_PCM_TRIGGER_RESUME:
 	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
 		if (!dai_data->is_port_started[dai->id]) {
 			ret = q6apm_graph_start(dai_data->graph[dai->id]);
-			if (ret < 0)
+			if (ret < 0) {
 				dev_err(dai->dev, "Failed to start APM port %d\n", dai->id);
-			else
+				/* The graph is gone; nothing may tap it until it is rebuilt */
+				if (dai->id == WSA_CODEC_DMA_RX_0)
+					audioreach_sp_rx_closed();
+			} else {
 				dai_data->is_port_started[dai->id] = true;
+			}
 		}
 		break;
 	default:
@@ -233,6 +258,9 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 	int graph_id = dai->id;
 	int rc;
 
+	if (q6apm_lpass_dai_is_vi_tap(dai))
+		return audioreach_sp_vi_tap_allowed() ? 0 : -EPERM;
+
 	if (dai_data->is_port_started[dai->id]) {
 		q6apm_graph_stop(dai_data->graph[dai->id]);
 		dai_data->is_port_started[dai->id] = false;
@@ -241,6 +269,8 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 
 	/* Torn down after a failure: build it afresh */
 	if (dai_data->graph[dai->id] && q6apm_graph_is_dead(dai_data->graph[dai->id])) {
+		if (dai->id == WSA_CODEC_DMA_RX_0)
+			audioreach_sp_rx_closed();
 		q6apm_graph_close(dai_data->graph[dai->id]);
 		dai_data->graph[dai->id] = NULL;
 	}
@@ -282,6 +312,8 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 	}
 	return 0;
 err:
+	if (dai->id == WSA_CODEC_DMA_RX_0)
+		audioreach_sp_rx_closed();
 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK) {
 		q6apm_graph_close(dai_data->graph[dai->id]);
 		dai_data->graph[dai->id] = NULL;
@@ -295,6 +327,14 @@ static int q6apm_lpass_dai_startup(struct snd_pcm_substream *substream, struct s
 	struct q6apm_graph *graph;
 	int graph_id = dai->id;
 
+	if (q6apm_lpass_dai_is_vi_tap(dai)) {
+		if (!audioreach_sp_vi_tap_allowed()) {
+			dev_err(dai->dev, "SP: no protected WSA RX graph running; refusing the V/I tap\n");
+			return -EPERM;
+		}
+		return 0;
+	}
+
 	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
 		graph = q6apm_graph_open(dai->dev, NULL, dai->dev, graph_id, substream->stream);
 		if (IS_ERR(graph)) {
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 96649f7a70e7..6602cb4f27ca 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -213,7 +213,8 @@ static int q6apm_reclaim_wedged_graph(struct q6apm *apm, struct audioreach_graph
 
 /*
  * Would @info read @src_iid from another graph's SP VI subgraph? Such a raw
- * V/I tap is refused: that subgraph is configured together with SP RX.
+ * V/I tap is only allowed for debugging, while the owning WSA RX graph runs
+ * protected.
  */
 bool q6apm_is_sp_vi_tap(struct q6apm *apm, u32 src_iid, struct audioreach_graph_info *info)
 {
@@ -273,7 +274,8 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	if (!info)
 		return ERR_PTR(-ENODEV);
 
-	if (q6apm_is_sp_vi_tap(apm, info->src_mod_inst_id, info)) {
+	if (q6apm_is_sp_vi_tap(apm, info->src_mod_inst_id, info) &&
+	    !audioreach_sp_vi_tap_allowed()) {
 		dev_err(apm->dev, "SP: graph %u taps the V/I of another graph; refusing\n",
 			graph_id);
 		return ERR_PTR(-EPERM);
diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index 5627a398ae5a..f524ce45e025 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -1484,7 +1484,8 @@ static int audioreach_put_audio_mixer(struct snd_kcontrol *kcontrol,
 		mutex_lock(&data->lock);
 		info = idr_find(&data->graph_info_idr, dapm_scontrol->graph_id);
 		mutex_unlock(&data->lock);
-		if (info && q6apm_is_sp_vi_tap(data, scontrol->module_instance_id, info)) {
+		if (info && q6apm_is_sp_vi_tap(data, scontrol->module_instance_id, info) &&
+		    !audioreach_sp_vi_tap_enabled()) {
 			dev_err(c->dev, "SP: graph %u may not tap the V/I of another graph\n",
 				dapm_scontrol->graph_id);
 			return -EPERM;
diff --git a/sound/soc/qcom/x1e80100.c b/sound/soc/qcom/x1e80100.c
index 109b74692924..7c087b0c93e8 100644
--- a/sound/soc/qcom/x1e80100.c
+++ b/sound/soc/qcom/x1e80100.c
@@ -435,6 +435,64 @@ static void x1e80100_add_be_ops(struct snd_soc_card *card)
 	}
 }
 
+/*
+ * Debug V/I tap: a codec-less BE that reads the V/I subgraph of the running
+ * WSA RX graph. The V/I codec DAIs stay on the WSA playback link.
+ */
+static int x1e80100_add_vi_tap_link(struct snd_soc_card *card)
+{
+	struct device *dev = card->dev;
+	struct snd_soc_dai_link *links, *rx = NULL, *tap;
+	struct snd_soc_dai_link_component *cpu, *platform;
+	int i;
+
+	for_each_card_prelinks(card, i, links) {
+		if (links->id == WSA_CODEC_DMA_TX_0) {
+			dev_err(dev, "V/I tap: the DT already has a WSA V/I capture link\n");
+			return -EINVAL;
+		}
+		if (links->id == WSA_CODEC_DMA_RX_0 && links->no_pcm)
+			rx = links;
+	}
+	if (!rx) {
+		dev_err(dev, "V/I tap: no WSA playback link\n");
+		return -EINVAL;
+	}
+
+	links = devm_kcalloc(dev, card->num_links + 1, sizeof(*links), GFP_KERNEL);
+	cpu = devm_kzalloc(dev, sizeof(*cpu), GFP_KERNEL);
+	platform = devm_kzalloc(dev, sizeof(*platform), GFP_KERNEL);
+	if (!links || !cpu || !platform)
+		return -ENOMEM;
+
+	memcpy(links, card->dai_link, card->num_links * sizeof(*links));
+	tap = &links[card->num_links];
+
+	cpu->of_node = rx->cpus->of_node;
+	cpu->dai_name = "WSA_CODEC_DMA_TX_0";
+	platform->of_node = rx->platforms->of_node;
+
+	tap->name = "WSA VI Tap";
+	tap->stream_name = tap->name;
+	tap->id = WSA_CODEC_DMA_TX_0;
+	tap->cpus = cpu;
+	tap->num_cpus = 1;
+	tap->codecs = &snd_soc_dummy_dlc;
+	tap->num_codecs = 1;
+	tap->platforms = platform;
+	tap->num_platforms = 1;
+	tap->no_pcm = 1;
+	tap->capture_only = 1;
+	tap->ignore_pmdown_time = 1;
+	tap->be_hw_params_fixup = x1e80100_be_hw_params_fixup;
+
+	card->dai_link = links;
+	card->num_links++;
+	dev_warn(dev, "debug: raw V/I tap link added\n");
+
+	return 0;
+}
+
 static int x1e80100_platform_probe(struct platform_device *pdev)
 {
 	struct snd_soc_card *card;
@@ -473,6 +531,11 @@ static int x1e80100_platform_probe(struct platform_device *pdev)
 	} else {
 		audioreach_sp_set_r0t0_from_uefi(false, 0, 0);
 	}
+	if (audioreach_sp_vi_tap_enabled()) {
+		ret = x1e80100_add_vi_tap_link(card);
+		if (ret)
+			return ret;
+	}
 
 	return devm_snd_soc_register_card(dev, card);
 }
