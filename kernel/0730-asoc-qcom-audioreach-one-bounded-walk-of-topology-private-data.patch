-	for (sz = 0; !found && (sz < le32_to_cpu(private->size)); ) {
-		const struct snd_soc_tplg_vendor_value_elem *mod_elem;
-		int tkn_count = 0;
-
-		mod_array = (struct snd_soc_tplg_vendor_array *)((u8 *)private->array + sz);
