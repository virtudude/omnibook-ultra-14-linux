-				break;
-			}
-			tkn_count++;
-			mod_elem++;
-		}
-	}
+	const struct snd_soc_tplg_vendor_array *arr;
+	u32 pos = 0, i;
+	int ret;
 
-	if (found)
-		return mod_array;
+	while ((ret = audioreach_tplg_next_array(priv, &pos, &arr)) > 0) {
+		if (!audioreach_tplg_is_value_array(arr))
+			continue;
+		for (i = 0; i < le32_to_cpu(arr->num_elems); i++)
+			if (le32_to_cpu(arr->value[i].token) == token)
