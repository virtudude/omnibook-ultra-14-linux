From c5154175b2888258120805d8ff3eea155edbe9f8 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:02:20 -0500
Subject: [PATCH] ASoC: qcom: audioreach: one bounded walk of topology private
 data

The readers of a widget's or control's private data trust its vendor
arrays: headers and elements are read unchecked, a signed offset is
advanced by the array's size and can overflow or leave the private
data, num_elems of 0 makes "<= num_elems - 1" loops overrun, mixer
controls read their first array without checking there is one, and a
cfg blob need not be a whole number of words.

Add audioreach_tplg_next_array(), the only walk of private data, which
bounds every array and its elements before returning it, and convert
the token finders, the control link parser, the cfg blob lookup and the
mixer widget and control code to it. A missing or malformed sub-graph,
container or module array now fails the widget.

Assisted-by: Claude:claude-opus-5-5
---
 sound/soc/qcom/qdsp6/topology.c | 312 +++++++++++++++++---------------
 1 file changed, 169 insertions(+), 143 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/topology.c b/sound/soc/qcom/qdsp6/topology.c
index a4276dd8b87b..aa27676bbe87 100644
--- a/sound/soc/qcom/qdsp6/topology.c
+++ b/sound/soc/qcom/qdsp6/topology.c
@@ -252,146 +252,159 @@ static struct audioreach_module *audioreach_tplg_alloc_module(struct q6apm *apm,
 	return mod;
 }
 
-static const struct snd_soc_tplg_vendor_array *
-audioreach_get_sg_array(const struct snd_soc_tplg_private *private)
+/*
+ * Return the vendor array at *@pos and advance *@pos past it, after bounds
+ * checking its header, extent and tuple elements against @priv. A module cfg
+ * blob's size excludes its audioreach_module_priv_data header.
+ * Returns 1 with *@array set, 0 at the end, -EINVAL on malformed data.
+ */
+static int audioreach_tplg_next_array(const struct snd_soc_tplg_private *priv, u32 *pos,
+				      const struct snd_soc_tplg_vendor_array **array)
 {
-	const struct snd_soc_tplg_vendor_array *sg_array = NULL;
-	bool found = false;
-	int sz;
-
-	for (sz = 0; !found && (sz < le32_to_cpu(private->size)); ) {
-		const struct snd_soc_tplg_vendor_value_elem *sg_elem;
-		int tkn_count = 0;
-
-		sg_array = (struct snd_soc_tplg_vendor_array *)((u8 *)private->array + sz);
-		sg_elem = sg_array->value;
-		sz = sz + le32_to_cpu(sg_array->size);
-		while (!found && tkn_count <= (le32_to_cpu(sg_array->num_elems) - 1)) {
-			switch (le32_to_cpu(sg_elem->token)) {
-			case AR_TKN_U32_SUB_GRAPH_INSTANCE_ID:
-				found = true;
-				break;
-			default:
-				break;
-			}
-			tkn_count++;
-			sg_elem++;
-		}
+	const struct snd_soc_tplg_vendor_array *arr;
+	u32 total = le32_to_cpu(priv->size);
+	u32 remain, size, type, elem_size;
+	u64 elems;
+
+	if (*pos >= total)
+		return 0;
+
+	remain = total - *pos;
+	if (remain < sizeof(*arr))
+		return -EINVAL;
+
+	arr = (const void *)(priv->data + *pos);
+	size = le32_to_cpu(arr->size);
+	type = le32_to_cpu(arr->type);
+
+	if (type == SND_SOC_AR_TPLG_MODULE_CFG_TYPE) {
+		if (!IS_ALIGNED(size, sizeof(__le32)) ||
+		    remain < sizeof(struct audioreach_module_priv_data) ||
+		    size > remain - sizeof(struct audioreach_module_priv_data))
+			return -EINVAL;
+		*pos += sizeof(struct audioreach_module_priv_data) + size;
+		*array = arr;
+		return 1;
 	}
 
-	if (found)
-		return sg_array;
+	if (size < sizeof(*arr) || size > remain)
+		return -EINVAL;
 
-	return NULL;
+	switch (type) {
+	case SND_SOC_TPLG_TUPLE_TYPE_UUID:
+		elem_size = sizeof(struct snd_soc_tplg_vendor_uuid_elem);
+		break;
+	case SND_SOC_TPLG_TUPLE_TYPE_STRING:
+		elem_size = sizeof(struct snd_soc_tplg_vendor_string_elem);
+		break;
+	case SND_SOC_TPLG_TUPLE_TYPE_BOOL:
+	case SND_SOC_TPLG_TUPLE_TYPE_BYTE:
+	case SND_SOC_TPLG_TUPLE_TYPE_WORD:
+	case SND_SOC_TPLG_TUPLE_TYPE_SHORT:
+		elem_size = sizeof(struct snd_soc_tplg_vendor_value_elem);
+		break;
+	default:
+		/* Unknown array type: only its extent can be checked */
+		elem_size = 0;
+		break;
+	}
+
+	elems = le32_to_cpu(arr->num_elems);
+	if (elem_size && (!elems || elems * elem_size > size - sizeof(*arr)))
+		return -EINVAL;
+
+	*pos += size;
+	*array = arr;
+	return 1;
 }
 
