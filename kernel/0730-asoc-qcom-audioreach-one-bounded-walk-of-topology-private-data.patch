-		sz = sz + le32_to_cpu(mod_array->size);
-		while (!found && tkn_count <= (le32_to_cpu(mod_array->num_elems) - 1)) {
-			switch (le32_to_cpu(mod_elem->token)) {
-			case AR_TKN_U32_MODULE_INSTANCE_ID:
-				found = true;
-				break;
