From 9001121c50c98c6f3901db287dfe8ac379c1c289 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Mon, 9 Nov 2026 19:21:04 -0500
Subject: [PATCH 1/4] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: add WSA
 speaker protection VI feedback

Mirror the glymur-crd speaker protection change: put the V/I sense DAIs
of the four WSA8845 speakers, the SoundWire VI ports and the WSA/WSA2
macro VI capture DAIs on the WSA Playback link, and give the speakers
'#sound-dai-cells = <1>' so the playback DAI is addressed explicitly.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/glymur-hp-omnibook-ultra-kg0xxx.dts  | 20 ++++++++++++-------
 1 file changed, 13 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index fec7c87d36f3..e6d9418bf886 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -248,10 +248,16 @@ wsa-dai-link {
 			link-name = "WSA Playback";
 
 			codec {
-				sound-dai = <&left_woofer>, <&left_tweeter>,
+				sound-dai = <&left_woofer 0>, <&left_tweeter 0>,
 					    <&swr0 0>, <&lpass_wsamacro 0>,
-					    <&right_woofer>, <&right_tweeter>,
-					    <&swr3 0>, <&lpass_wsa2macro 0>;
+					    <&left_woofer 1>, <&left_tweeter 1>,
+					    <&swr0 12>, <&swr0 13>,
+					    <&lpass_wsamacro 2>,
+					    <&right_woofer 0>, <&right_tweeter 0>,
+					    <&swr3 0>, <&lpass_wsa2macro 0>,
+					    <&right_woofer 1>, <&right_tweeter 1>,
+					    <&swr3 12>, <&swr3 13>,
+					    <&lpass_wsa2macro 2>;
 			};
 
 			cpu {
@@ -722,7 +728,7 @@ left_woofer: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferLeft";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
@@ -734,7 +740,7 @@ left_tweeter: speaker@0,1 {
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterLeft";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
@@ -750,7 +756,7 @@ right_woofer: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferRight";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
@@ -762,7 +768,7 @@ right_tweeter: speaker@0,1 {
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
-		#sound-dai-cells = <0>;
+		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterRight";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
From 986ecf0d76650d642a8c976b8dedebadd269dc1a Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Tue, 10 Nov 2026 23:15:16 -0500
Subject: [PATCH 2/4] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: fix the
 WSA speaker names

The two amplifiers on the WSA macro bus drive the woofers and the two on
WSA2 the tweeters, as the coil resistance on each amplifier's V/I sense
and HP's factory R0 data show. The second amplifier on the WSA bus was
named TweeterLeft and the first on WSA2 WooferRight. Swap the names,
labels and audio routing.

Assisted-by: Claude:claude-opus-5-5
---
 .../qcom/glymur-hp-omnibook-ultra-kg0xxx.dts  | 24 +++++++++----------
 1 file changed, 12 insertions(+), 12 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index e6d9418bf886..71ab81fd3026 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -222,8 +222,8 @@ sound {
 		model = "GLYMUR-HP-OmniBook-Ultra-14-kg0xxx";
 
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
-				"TweeterLeft IN", "WSA WSA_SPK2 OUT",
-				"WooferRight IN", "WSA2 WSA_SPK1 OUT",
+				"WooferRight IN", "WSA WSA_SPK2 OUT",
+				"TweeterLeft IN", "WSA2 WSA_SPK1 OUT",
 				"TweeterRight IN", "WSA2 WSA_SPK2 OUT",
 				"VA DMIC0", "vdd-micb",
 				"VA DMIC1", "vdd-micb";
@@ -248,14 +248,14 @@ wsa-dai-link {
 			link-name = "WSA Playback";
 
 			codec {
-				sound-dai = <&left_woofer 0>, <&left_tweeter 0>,
+				sound-dai = <&left_woofer 0>, <&right_woofer 0>,
 					    <&swr0 0>, <&lpass_wsamacro 0>,
-					    <&left_woofer 1>, <&left_tweeter 1>,
+					    <&left_woofer 1>, <&right_woofer 1>,
 					    <&swr0 12>, <&swr0 13>,
 					    <&lpass_wsamacro 2>,
-					    <&right_woofer 0>, <&right_tweeter 0>,
+					    <&left_tweeter 0>, <&right_tweeter 0>,
 					    <&swr3 0>, <&lpass_wsa2macro 0>,
-					    <&right_woofer 1>, <&right_tweeter 1>,
+					    <&left_tweeter 1>, <&right_tweeter 1>,
 					    <&swr3 12>, <&swr3 13>,
 					    <&lpass_wsa2macro 2>;
 			};
@@ -735,13 +735,13 @@ left_woofer: speaker@0,0 {
 		qcom,port-mapping = <1 2 3 7 12 14>;
 	};
 
-	/* WSA8845, left tweeter */
-	left_tweeter: speaker@0,1 {
+	/* WSA8845, right woofer: the second amp on the WSA macro bus */
+	right_woofer: speaker@0,1 {
 		compatible = "sdw20217020400";
 		reg = <0 1>;
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
-		sound-name-prefix = "TweeterLeft";
+		sound-name-prefix = "WooferRight";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
@@ -751,13 +751,13 @@ left_tweeter: speaker@0,1 {
 &swr3 {
 	status = "okay";
 
-	/* WSA8845, right woofer */
-	right_woofer: speaker@0,0 {
+	/* WSA8845, left tweeter: the first amp on the WSA2 macro bus */
+	left_tweeter: speaker@0,0 {
 		compatible = "sdw20217020400";
 		reg = <0 0>;
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
-		sound-name-prefix = "WooferRight";
+		sound-name-prefix = "TweeterLeft";
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
From 82c50370930365ce7d2514f952104d09e2814453 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Tue, 10 Nov 2026 23:15:24 -0500
Subject: [PATCH 3/4] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: require
 speaker protection

Describe the speaker protection setup of the four WSA8845 speakers:
their codec DMA lanes (0, 2, 1, 3 in link order, as the lanes alternate
between the WSA and WSA2 macros), required speaker protection with the
V/I guard on every amplifier, the high-pass on the tweeters, and the
factory R0/T0 in UEFI with an accepted R0 range of 5..10 ohm (factory
values are 7.0..8.2 ohm).

Assisted-by: Claude:claude-opus-5-5
---
 .../dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index 71ab81fd3026..67f82e631bad 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -221,6 +221,16 @@ sound {
 		compatible = "qcom,glymur-sndcard";
 		model = "GLYMUR-HP-OmniBook-Ultra-14-kg0xxx";
 
+		/*
+		 * Lanes alternate between the WSA and WSA2 macros, so lane
+		 * order is WooferLeft, TweeterLeft, WooferRight, TweeterRight.
+		 */
+		qcom,wsa-speaker-lanes = <0 2 1 3>;
+		qcom,speaker-protection-required;
+		qcom,uefi-speaker-calibration;
+		/* Factory R0 is 7.0..8.2 ohms on these speakers (HP Rtyp 6.8..7.8) */
+		qcom,speaker-r0-range-micro-ohms = <5000000 10000000>;
+
 		audio-routing = "WooferLeft IN", "WSA WSA_SPK1 OUT",
 				"WooferRight IN", "WSA WSA_SPK2 OUT",
 				"TweeterLeft IN", "WSA2 WSA_SPK1 OUT",
@@ -730,6 +740,7 @@ left_woofer: speaker@0,0 {
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferLeft";
+		qcom,vi-guard;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
@@ -742,6 +753,7 @@ right_woofer: speaker@0,1 {
 		reset-gpios = <&lpass_tlmm 12 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferRight";
+		qcom,vi-guard;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
@@ -758,6 +770,8 @@ left_tweeter: speaker@0,0 {
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterLeft";
+		qcom,vi-guard;
+		qcom,tweeter;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <1 2 3 7 12 14>;
@@ -770,6 +784,8 @@ right_tweeter: speaker@0,1 {
 		reset-gpios = <&lpass_tlmm 13 GPIO_ACTIVE_LOW>;
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "TweeterRight";
+		qcom,vi-guard;
+		qcom,tweeter;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
 		qcom,port-mapping = <4 5 6 7 13 15>;
From 8adb9e35848111ff6ce9a63fa4139cd7c3b9b8d1 Mon Sep 17 00:00:00 2001
From: virtudude <virtudude@protonmail.com>
Date: Wed, 11 Nov 2026 15:10:21 -0500
Subject: [PATCH 4/4] arm64: dts: qcom: glymur-hp-omnibook-ultra-kg0xxx: add the
 speaker operating point

Give each WSA8845 amplifier its operating point: a PA gain ceiling of
+7.5 dB (PA Volume 22) and the peak terminal voltage measured for
0 dBFS at that gain: 3.246 V (WooferLeft), 3.387 V (TweeterLeft),
3.283 V (WooferRight) and 3.234 V (TweeterRight). With speaker
protection required, the card then runs the speakers there instead of
at the default limits (about 0.7 V peak).

Assisted-by: Claude:claude-opus-5-5
---
 .../boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts     | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
index 67f82e631bad..ae2b063d4c13 100644
--- a/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-hp-omnibook-ultra-kg0xxx.dts
@@ -741,6 +741,8 @@ left_woofer: speaker@0,0 {
 		#sound-dai-cells = <1>;
 		sound-name-prefix = "WooferLeft";
 		qcom,vi-guard;
+		qcom,pa-gain-max-millidecibel = <7500>;
+		qcom,speaker-full-scale-microvolt = <3246000>;
 		vdd-1p8-supply = <&vreg_l15b_e0_1p8>;
 		vdd-io-supply = <&vreg_l18b_e0_1p2>;
