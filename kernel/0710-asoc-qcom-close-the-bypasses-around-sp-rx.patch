index 18584a15216c..f35cfe3d44b4 100644
--- a/sound/soc/qcom/qdsp6/audioreach.c
+++ b/sound/soc/qcom/qdsp6/audioreach.c
@@ -7,6 +7,7 @@
 #include <linux/slab.h>
 #include <linux/soc/qcom/apr.h>
 #include <linux/thermal.h>
+#include <linux/unaligned.h>
 #include <sound/soc.h>
 #include <sound/soc-dai.h>
 #include <sound/pcm.h>
@@ -64,6 +65,8 @@ static struct {
 static DEFINE_MUTEX(sp_speaker_map_lock);
 
 static bool sp_required;
+/* Speakers (speaker map order) whose SP RX input must be high-passed */
+static u32 sp_hpf_speakers;
 
 /* SubGraph Config */
 struct apm_sub_graph_data {
@@ -977,6 +980,34 @@ static int audioreach_gapless_set_media_format(struct q6apm_graph *graph,
 					 EARLY_EOS_DELAY_MS);
 }
 
+static bool audioreach_sp_isolated(void);
+
+/*
+ * Does the blob, parsed as the DSP parses an in-band SET_CFG payload (16-byte
+ * headers, payloads padded to 8 bytes), address only @iid?
+ */
+static bool audioreach_cfg_blob_own_iid(const u8 *p, u32 size, u32 iid)
+{
+	u32 pos = 0;
+
+	while (pos < size) {
+		u32 step;
+
+		if (size - pos < APM_MODULE_PARAM_DATA_SIZE ||
+		    get_unaligned_le32(p + pos) != iid)
+			return false;
+		step = get_unaligned_le32(p + pos + 8);
+		if (step > size - pos - APM_MODULE_PARAM_DATA_SIZE)
+			return false;
+		step = APM_MODULE_PARAM_DATA_SIZE + ALIGN(step, 8);
+		if (step > size - pos)
+			return false;
+		pos += step;
+	}
+
+	return pos == size;
+}
+
 static int audioreach_set_module_config(struct q6apm_graph *graph,
 					const struct audioreach_module *module,
 					const struct audioreach_module_config *cfg)
@@ -984,6 +1015,14 @@ static int audioreach_set_module_config(struct q6apm_graph *graph,
 	int size = le32_to_cpu(module->data->size);
 	void *p;
 
+	if (audioreach_sp_isolated() &&
+	    (size <= 0 || !audioreach_cfg_blob_own_iid((const u8 *)module->data->data, size,
+							module->instance_id))) {
+		dev_err(graph->dev, "module 0x%x cfg blob addresses other modules; refusing\n",
+			module->instance_id);
+		return -EINVAL;
+	}
+
 	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(size, APM_CMD_SET_CFG, 0);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
@@ -1654,18 +1693,44 @@ bool audioreach_sp_required(void)
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_required);
 
+void audioreach_sp_set_hpf_speakers(u32 speakers)
+{
+	WRITE_ONCE(sp_hpf_speakers, speakers);
+	if (speakers)
+		pr_info("SP: high-pass required in front of SP RX for speakers 0x%x\n", speakers);
+}
+EXPORT_SYMBOL_GPL(audioreach_sp_set_hpf_speakers);
+
+/* Raw cfg blobs may only address their own module */
+static bool audioreach_sp_isolated(void)
+{
+	return READ_ONCE(sp_required) || READ_ONCE(sp_hpf_speakers);
+}
+
+static int audioreach_sp_check_graph(struct q6apm_graph *graph);
+
 /**
  * audioreach_sp_session_begin() - start the SP setup of a WSA RX graph
  * @graph: the graph about to be configured
  *
- * Lets its SP modules be configured, in the current mode.
+ * Checks the graph's speaker protection shape, which only changes with the
+ * topology, then lets its SP modules be configured, in the current mode.
+ *
+ * Return: 0 or a negative error code.
  */
-void audioreach_sp_session_begin(struct q6apm_graph *graph)
+int audioreach_sp_session_begin(struct q6apm_graph *graph)
 {
+	int rc = audioreach_sp_check_graph(graph);
+
+	if (rc)
+		return rc;
+
 	graph->sp = (struct audioreach_sp_pass) {
 		.active = true,
 		.mode = READ_ONCE(sp_operation_mode),
 	};
+
+	return 0;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_begin);
 
@@ -1697,7 +1762,6 @@ int audioreach_sp_session_end(struct q6apm_graph *graph, int rc)
 		dev_err(dev, "SP: speaker protection is required and this graph has no SP RX/VI; refusing\n");
 		return -EPERM;
 	}
-
 	return 0;
 }
 EXPORT_SYMBOL_GPL(audioreach_sp_session_end);
@@ -2389,6 +2453,42 @@ static int audioreach_sp_cfg_walk(const u32 *word, u32 num_words, u32 iid,
 	return bytes;
 }
 
+/*
+ * Parameters the kernel sets itself. Where SP is required a blob may not set
+ * them, so it cannot override what the configuration pass checked.
+ */
+static bool audioreach_sp_kernel_owned(u32 pid)
+{
+	switch (pid) {
+	case PARAM_ID_SP_OP_MODE:
+	case 0x08001b40:			/* SP RX operation mode, v2 */
+	case PARAM_ID_SP_VI_OP_MODE_CFG:
+	case PARAM_ID_SP_TH_VI_R0T0_CFG:
+	case 0x080011f9:			/* TH VI factory test mode */
+	case 0x080011fb:			/* TH VI validation mode */
+	case PARAM_ID_SP_VI_EX_MODE_CFG:
+	case 0x08001200:			/* EX VI factory test mode */
+		return true;
+	}
+	return false;
+}
+
+/* The first kernel-owned parameter in packed records, 0 if none */
+static u32 audioreach_sp_blob_kernel_pid(const u8 *packed, u32 total)
+{
+	u32 pos = 0;
+
+	while (pos + APM_MODULE_PARAM_DATA_SIZE <= total) {
+		const struct apm_module_param_data *pd = (const void *)(packed + pos);
+
+		if (audioreach_sp_kernel_owned(pd->param_id))
+			return pd->param_id;
+		pos += APM_MODULE_PARAM_DATA_SIZE + ALIGN(pd->param_size, 8);
+	}
+
+	return 0;
+}
+
 static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *graph,
 							 const struct audioreach_module *module,
 							 const char *tag)
@@ -2407,9 +2507,18 @@ static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *gra
 	word = (const u32 *)module->data->data;
 	num_words = size / sizeof(u32);
 
-	/* Not laid out as parameter records, so send it as the topology built it */
-	if (size % sizeof(u32) || !num_words || word[0] != module->instance_id)
+	/*
+	 * Not parameter records: such a blob may address any module, so it is
+	 * sent as built, and never where SP or the high-pass is required.
+	 */
+	if (size % sizeof(u32) || !num_words || word[0] != module->instance_id) {
+		if (audioreach_sp_isolated()) {
+			dev_err(graph->dev, "%s cfg blob is not in parameter records; refusing\n",
+				tag);
+			return -EINVAL;
+		}
 		return audioreach_speaker_protection_send_chunk(graph, tag, word, size, 0);
+	}
 
 	total = audioreach_sp_cfg_walk(word, num_words, module->instance_id, 0,
 				       NULL, NULL, U32_MAX);
@@ -2422,6 +2531,20 @@ static int audioreach_speaker_protection_send_static_cfg(struct q6apm_graph *gra
 	if (!packed)
 		return -ENOMEM;
 
+	if (audioreach_sp_isolated()) {
+		u32 pid;
+
+		if (audioreach_sp_cfg_walk(word, num_words, module->instance_id, 0,
+					   NULL, packed, U32_MAX) != total)
+			return -EINVAL;
+		pid = audioreach_sp_blob_kernel_pid(packed, total);
+		if (pid) {
+			dev_err(graph->dev, "%s cfg blob sets 0x%08x, which the kernel owns; refusing\n",
+				tag, pid);
+			return -EINVAL;
+		}
+	}
+
 	while (pos < num_words && !rc) {
 		int bytes = audioreach_sp_cfg_walk(word, num_words, module->instance_id,
 						   pos, &pos, packed,
@@ -2448,6 +2571,340 @@ static int audioreach_speaker_protection_vi_static_cfg(struct q6apm_graph *graph
 	return audioreach_speaker_protection_send_static_cfg(graph, module, "VI");
 }
 
+/*
+ * Count every connection into @module in its graph (module outputs and the
+ * front end link) and return the last feeding module.
+ */
+static unsigned int audioreach_graph_feeders(const struct audioreach_module *module,
+					     const struct audioreach_module **feeder)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	unsigned int n = 0, pn;
+
+	*feeder = NULL;
+	if (!module->container || !module->container->sub_graph ||
+	    !module->container->sub_graph->info)
+		return UINT_MAX;
+	sg = module->container->sub_graph;
+	if (sg->info->dst_mod_inst_id == module->instance_id)
+		n++;
+
+	list_for_each_entry(sg, &module->container->sub_graph->info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				u32 nports = min_t(u32, m->max_op_port, AR_MAX_MOD_LINKS);
+
+				for (pn = 0; pn < nports; pn++)
+					if (m->dst_mod_inst_id[pn] == module->instance_id) {
+						n++;
+						*feeder = m;
+					}
+			}
+
+	return n;
+}
+
+static const struct audioreach_module *
+audioreach_graph_find_module(const struct audioreach_module *ref, u32 iid)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+
+	if (!ref->container || !ref->container->sub_graph ||
+	    !ref->container->sub_graph->info)
+		return NULL;
+
+	list_for_each_entry(sg, &ref->container->sub_graph->info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node)
+				if (m->instance_id == iid)
+					return m;
+
+	return NULL;
+}
+
+/* The module @module's output goes to, if it has exactly one output */
+static const struct audioreach_module *
+audioreach_only_successor(const struct audioreach_module *module)
+{
+	const struct audioreach_module *next = NULL;
+	unsigned int pn, n = 0;
+
+	for (pn = 0; pn < min_t(u32, module->max_op_port, AR_MAX_MOD_LINKS); pn++) {
+		if (!module->dst_mod_inst_id[pn])
+			continue;
+		n++;
+		next = audioreach_graph_find_module(module, module->dst_mod_inst_id[pn]);
+	}
+
+	return n == 1 ? next : NULL;
+}
+
+#define AR_LPAIF_INTF_TYPE_WSA	2
+#define AR_CODEC_INTF_IDX_RX0	1
+
+/* Is @sink the graph's only codec DMA sink, and the WSA RX0 (speaker) one? */
+static bool audioreach_is_only_speaker_sink(const struct audioreach_module *sink)
+{
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	const struct audioreach_module *m;
+	unsigned int n = 0;
+
+	if (sink->module_id != MODULE_ID_CODEC_DMA_SINK ||
+	    sink->hw_interface_type != AR_LPAIF_INTF_TYPE_WSA ||
+	    sink->hw_interface_idx != AR_CODEC_INTF_IDX_RX0 ||
+	    !sink->container || !sink->container->sub_graph ||
+	    !sink->container->sub_graph->info)
+		return false;
+
+	list_for_each_entry(sg, &sink->container->sub_graph->info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node)
+				if (m->module_id == MODULE_ID_CODEC_DMA_SINK)
+					n++;
+
+	return n == 1;
+}
+
+static bool audioreach_module_has_blob(const struct audioreach_module *module)
+{
+	return module->data && module->data->size;
+}
+
+/*
+ * The only shape SP RX runs in: MFC -> [MSIIR ->] SP -> MFC -> ... -> the
+ * WSA RX0 codec DMA sink, the graph's only codec DMA sink, where each link
+ * is the only output of one module and the only input of the next, so
+ * nothing reaches the speakers around SP or around the high-pass. From the
+ * MSIIR (or SP) on, every module has a single input port, which its
+ * predecessor already holds, so no other graph can connect into the chain
+ * downstream of the high-pass. The MFCs next to SP carry no cfg blob, so
+ * they cannot remix the speakers, and where SP or the high-pass is
+ * required only data logging follows the second one. Returns the MSIIR,
+ * NULL without one, or an ERR_PTR.
+ */
+static const struct audioreach_module *
+audioreach_sp_rx_chain(const struct audioreach_module *sp)
+{
+	const struct audioreach_module *f, *m, *next, *hpf = NULL;
+	int hops;
+
+	if (sp->max_ip_port != 1 || audioreach_graph_feeders(sp, &f) != 1 || !f)
+		return ERR_PTR(-EINVAL);
+	if (f->module_id == MODULE_ID_MSIIR) {
+		if (f->max_ip_port != 1 || audioreach_only_successor(f) != sp)
+			return ERR_PTR(-EINVAL);
+		hpf = f;
+		if (audioreach_graph_feeders(hpf, &f) != 1 || !f)
+			return ERR_PTR(-EINVAL);
+	}
+	if (f->module_id != MODULE_ID_MFC || audioreach_module_has_blob(f) ||
+	    audioreach_only_successor(f) != (hpf ? hpf : sp))
+		return ERR_PTR(-EINVAL);
+
+	next = audioreach_only_successor(sp);
+	if (!next || next->module_id != MODULE_ID_MFC || audioreach_module_has_blob(next))
+		return ERR_PTR(-EINVAL);
+
+	for (m = sp, hops = 0; hops < 16; hops++, m = next) {
+		next = audioreach_only_successor(m);
+		if (!next || next->max_ip_port != 1 ||
+		    audioreach_graph_feeders(next, &f) != 1 || f != m)
+			return ERR_PTR(-EINVAL);
+		if (next->module_id == MODULE_ID_CODEC_DMA_SINK)
+			return audioreach_is_only_speaker_sink(next) ? hpf : ERR_PTR(-EINVAL);
+		if (audioreach_sp_isolated() && m != sp &&
+		    next->module_id != MODULE_ID_DATA_LOGGING)
+			return ERR_PTR(-EINVAL);
+	}
+
+	return ERR_PTR(-EINVAL);
+}
+
+#define PARAM_ID_MSIIR_TUNING_FILTER_ENABLE		0x08001020
+#define PARAM_ID_MSIIR_TUNING_FILTER_CONFIG_PARAMS	0x08001022
+
+/* Every channel type but the woofers' FL and FR; bit 0 is reserved */
+#define AR_TWEETER_HPF_MASK \
+	(GENMASK_ULL(63, 1) & ~(BIT_ULL(PCM_CHANNEL_FL) | BIT_ULL(PCM_CHANNEL_FR)))
+
+struct ar_msiir_filter_enable {
+	u32 num_cfg;
+	u32 mask_lsb;
+	u32 mask_msb;
+	u32 enable;
+} __packed;
+
+struct ar_msiir_filter_config {
+	u32 num_cfg;
+	u32 mask_lsb;
+	u32 mask_msb;
+	u16 reserved;
+	u16 num_stages;
+	s32 coeffs[2][5];
+	s16 shift[2];
+} __packed;
+
+static const struct ar_msiir_filter_enable ar_tweeter_hpf_enable = {
+	.num_cfg = 1,
+	.mask_lsb = lower_32_bits(AR_TWEETER_HPF_MASK),
+	.mask_msb = upper_32_bits(AR_TWEETER_HPF_MASK),
+	.enable = 1,
+};
+
+/*
+ * The tweeter high-pass qualified with speaker protection: a 4th order
+ * Linkwitz-Riley high-pass at 1.5 kHz for 48 kHz, as two Butterworth
+ * biquads (b0, b1, b2, a1, a2 in Q30 with shift 2).
+ */
+static const struct ar_msiir_filter_config ar_tweeter_hpf = {
+	.num_cfg = 1,
+	.mask_lsb = lower_32_bits(AR_TWEETER_HPF_MASK),
+	.mask_msb = upper_32_bits(AR_TWEETER_HPF_MASK),
+	.num_stages = 2,
+	.coeffs = {
+		{ 934510558, -1869021116, 934510558, -1850890572, 813409838 },
+		{ 934510558, -1869021116, 934510558, -1850890572, 813409838 },
+	},
+	.shift = { 2, 2 },
+};
+
+/* Is @module's blob exactly the qualified tweeter high-pass, record by record? */
+static bool audioreach_msiir_is_tweeter_hpf(const struct audioreach_module *module)
+{
+	static const u32 module_on = 1;
+	static const struct {
+		u32 param_id;
+		const void *data;
+		u32 size;
+	} want[] = {
+		{ PARAM_ID_MODULE_ENABLE, &module_on, sizeof(module_on) },
+		{ PARAM_ID_MSIIR_TUNING_FILTER_ENABLE, &ar_tweeter_hpf_enable,
+		  sizeof(ar_tweeter_hpf_enable) },
+		{ PARAM_ID_MSIIR_TUNING_FILTER_CONFIG_PARAMS, &ar_tweeter_hpf,
+		  sizeof(ar_tweeter_hpf) },
+	};
+	u32 num_words, pos = 0;
+	const u32 *word;
+	unsigned int i;
+
+	if (!audioreach_module_has_blob(module) ||
+	    le32_to_cpu(module->data->size) % sizeof(u32))
+		return false;
+	word = (const u32 *)module->data->data;
+	num_words = le32_to_cpu(module->data->size) / sizeof(u32);
+
+	for (i = 0; i < ARRAY_SIZE(want); i++) {
+		u32 words = DIV_ROUND_UP(want[i].size, sizeof(u32));
+
+		if (num_words - pos < 4 + words || word[pos] != module->instance_id ||
+		    word[pos + 1] != want[i].param_id || word[pos + 2] != want[i].size ||
+		    memcmp(&word[pos + 4], want[i].data, want[i].size))
+			return false;
+		pos += 4 + words;
+	}
+
+	return pos == num_words;
+}
+
+/*
+ * The high-pass in front of SP RX runs at its qualified rate and filters the
+ * channel type of every speaker the machine driver lists: the tweeters.
+ */
+static int audioreach_sp_rx_hpf(struct q6apm_graph *graph,
+				const struct audioreach_module *module,
+				const struct audioreach_module_config *cfg)
+{
+	u32 need = READ_ONCE(sp_hpf_speakers);
+	unsigned int s;
+	int rc;
+
+	if (cfg->sample_rate != 48000) {
+		dev_err(graph->dev, "SP HPF: qualified at 48 kHz only, not %u Hz\n",
+			cfg->sample_rate);
+		return -EINVAL;
+	}
+
+	for (s = 0; s < MAX_SP_VI_SPEAKERS; s++) {
+		u8 type = s < cfg->num_channels ? cfg->channel_map[s] : 0;
+
+		if (!(need & BIT(s)))
+			continue;
+		if (!type || type >= 64 || !(AR_TWEETER_HPF_MASK & BIT_ULL(type))) {
+			dev_err(graph->dev, "SP HPF: speaker %u (channel type %u) is not high-passed\n",
+				s, type);
+			return -EINVAL;
+		}
+		dev_dbg(graph->dev, "SP HPF speaker %u: channel type %u, high-passed\n", s, type);
+	}
+
+	rc = audioreach_speaker_protection_send_static_cfg(graph, module, "SP HPF");
+	if (rc)
+		dev_err(graph->dev, "SP HPF setup failed: %d\n", rc);
+
+	return rc;
+}
+
+/*
+ * One SP RX and one SP VI, and SP RX in its chain, behind the qualified
+ * high-pass where speakers need one. None of this changes until the
+ * topology is loaded again, so a graph passes it once.
+ */
+static int audioreach_sp_check_graph(struct q6apm_graph *graph)
+{
+	const struct audioreach_module *rx = NULL, *hpf, *m;
+	struct audioreach_graph_info *info = graph->info;
+	const struct audioreach_sub_graph *sg;
+	const struct audioreach_container *c;
+	unsigned int nrx = 0, nvi = 0;
+	struct device *dev = graph->dev;
+
+	if (info->sp_checked)
+		return 0;
+
+	list_for_each_entry(sg, &info->sg_list, node)
+		list_for_each_entry(c, &sg->container_list, node)
+			list_for_each_entry(m, &c->modules_list, node) {
+				if (m->module_id == MODULE_ID_SPEAKER_PROTECTION) {
+					nrx++;
+					rx = m;
+				} else if (m->module_id == MODULE_ID_SPEAKER_PROTECTION_VI) {
+					nvi++;
+				}
+			}
+
+	if (nrx || nvi) {
+		if (nrx != 1 || nvi != 1) {
+			dev_err(dev, "SP: graph %d has %u SP RX and %u SP VI modules, needs one of each; refusing\n",
+				info->id, nrx, nvi);
+			return -EPERM;
+		}
+
+		hpf = audioreach_sp_rx_chain(rx);
+		if (IS_ERR(hpf)) {
+			dev_err(dev, "SP RX: SP must sit in MFC -> [MSIIR ->] SP -> MFC -> ... -> codec DMA, one link each; refusing\n");
+			return -EPERM;
+		}
+		if (READ_ONCE(sp_hpf_speakers) && !hpf) {
