+			    get_unaligned_le32(p + 12) != 1)
+				return -EINVAL;
+			en_mask = get_unaligned_le32(p + 4) |
+				  (u64)get_unaligned_le32(p + 8) << 32;
+			en_seen = true;
+			break;
+		case PARAM_ID_MSIIR_TUNING_FILTER_CONFIG_PARAMS:
+			if (cfg_seen || psize < 16 || get_unaligned_le32(p) != 1)
+				return -EINVAL;
+			cfg_mask = get_unaligned_le32(p + 4) |
+				   (u64)get_unaligned_le32(p + 8) << 32;
+			nst = get_unaligned_le16(p + 14);
+			if (nst < 2 || nst > AR_MSIIR_MAX_STAGES ||
+			    psize != 16 + nst * 5 * sizeof(s32) + ALIGN(nst * sizeof(s16), 4))
+				return -EINVAL;
+			for (s = 0; s < nst; s++) {
+				s32 c[5];
+				int k;
+
+				const u8 *shift = p + 16 + nst * 5 * sizeof(s32) + s * sizeof(s16);
+
+				for (k = 0; k < 5; k++)
+					c[k] = get_unaligned_le32(p + 16 +
+								  (s * 5 + k) * sizeof(s32));
+				if (!audioreach_msiir_stage_is_hp(c, get_unaligned_le16(shift)))
+					return -EINVAL;
+			}
+			cfg_seen = true;
+			break;
+		default:
+			return -EINVAL;
+		}
+
+		pos += 4 + DIV_ROUND_UP(psize, sizeof(u32));
+		while (pos < num_words && !word[pos])
+			pos++;
+	}
+
+	if (!module_on || !en_seen || !cfg_seen || en_mask != cfg_mask ||
+	    !(cfg_mask & ~BIT_ULL(0)) || (cfg_mask & BIT_ULL(0)))
+		return -EINVAL;
