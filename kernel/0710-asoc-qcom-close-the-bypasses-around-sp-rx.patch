+/*
+ * Does the blob, parsed as the DSP parses an in-band SET_CFG payload (16-byte
+ * headers, payloads padded to 8 bytes), address only @iid?
+ */
+static bool audioreach_cfg_blob_own_iid(const u8 *p, u32 size, u32 iid)
+{
+	u32 pos = 0;
+
+	while (pos < size) {
+		u32 step;
+
+		if (size - pos < APM_MODULE_PARAM_DATA_SIZE ||
+		    get_unaligned_le32(p + pos) != iid)
+			return false;
+		step = get_unaligned_le32(p + pos + 8);
+		if (step > size - pos - APM_MODULE_PARAM_DATA_SIZE)
+			return false;
+		step = APM_MODULE_PARAM_DATA_SIZE + ALIGN(step, 8);
+		if (step > size - pos)
+			return false;
+		pos += step;
+	}
+
+	return pos == size;
+}
