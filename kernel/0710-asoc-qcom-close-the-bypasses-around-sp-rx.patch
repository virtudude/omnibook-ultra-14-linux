+#define PARAM_ID_MSIIR_TUNING_FILTER_ENABLE		0x08001020
+#define PARAM_ID_MSIIR_TUNING_FILTER_CONFIG_PARAMS	0x08001022
+#define AR_MSIIR_Q30_ONE				((s64)BIT_ULL(30))
+#define AR_MSIIR_MAX_STAGES				20
+
+/* cos/sin of 1 and 2 x 2 pi 500 Hz / 48 kHz in Q30 */
+static const s64 ar_msiir_cs500[2][2] = {
+	{ 1071442860, 70226075 },
+	{ 1064555814, 140151432 },
+};
+
+/* |c0 + c1 z^-1 + c2 z^-2|^2 at 500 Hz, coefficients in Q30, result in Q44 */
+static s64 audioreach_msiir_mag2_500(s64 c0, s64 c1, s64 c2)
+{
+	s64 re = c0 + ((c1 * ar_msiir_cs500[0][0] + c2 * ar_msiir_cs500[1][0]) >> 30);
+	s64 im = (c1 * ar_msiir_cs500[0][1] + c2 * ar_msiir_cs500[1][1]) >> 30;
+
+	re >>= 8;
+	im >>= 8;
+	return re * re + im * im;
+}
+
+/*
+ * A stable high-pass: zero at DC (b0 + b1 + b2 == 0), unity gain at Nyquist
+ * within 1 %, shift 2 (all five in Q30), at least 10 dB down at 500 Hz at
+ * 48 kHz.
+ */
+static bool audioreach_msiir_stage_is_hp(const s32 *c, s16 shift)
+{
+	s64 b0 = c[0], b1 = c[1], b2 = c[2], a1 = c[3], a2 = c[4];
+	s64 num_nyq = b0 - b1 + b2, den_nyq = AR_MSIIR_Q30_ONE - a1 + a2;
+
+	if (shift != 2 || b0 <= 0 || b0 + b1 + b2 != 0)
+		return false;
+	if (a2 >= AR_MSIIR_Q30_ONE || a2 <= -AR_MSIIR_Q30_ONE ||
+	    abs(a1) >= AR_MSIIR_Q30_ONE + a2)
+		return false;
+	if (den_nyq <= 0 || abs(num_nyq - den_nyq) * 100 > den_nyq)
+		return false;
+
+	return audioreach_msiir_mag2_500(b0, b1, b2) * 10 <=
+	       audioreach_msiir_mag2_500(AR_MSIIR_Q30_ONE, a1, a2);
+}
+
+/*
+ * Only one canonical MSIIR blob form is accepted: module enable (1), MSIIR
+ * enable and MSIIR config exactly once, each with one entry and the same
+ * non-empty channel mask, enabled, and 2..20 stages that all pass
+ * audioreach_msiir_stage_is_hp(). The DSP keeps only the last payload of
+ * each parameter and walks entries by their own sizes, so anything else
+ * could leave the kernel and the DSP reading different filters.
+ */
+static int audioreach_msiir_hpf_scan(const struct audioreach_module *module, u64 *mask)
+{
+	bool module_on = false, en_seen = false, cfg_seen = false;
+	u64 en_mask = 0, cfg_mask = 0;
+	const u32 *word;
+	u32 num_words, pos = 0;
+
+	if (!module->data || !module->data->size ||
+	    le32_to_cpu(module->data->size) % sizeof(u32))
+		return -EINVAL;
+	word = (const u32 *)module->data->data;
+	num_words = le32_to_cpu(module->data->size) / sizeof(u32);
+
+	while (pos < num_words) {
+		u32 pid, psize, nst, s;
+		const u8 *p;
+
+		if (num_words - pos < 4 || word[pos] != module->instance_id)
+			return -EINVAL;
+		pid = word[pos + 1];
+		psize = word[pos + 2];
+		if (psize > (num_words - pos - 4) * sizeof(u32))
+			return -EINVAL;
+		p = (const u8 *)&word[pos + 4];
+
+		switch (pid) {
+		case PARAM_ID_MODULE_ENABLE:
+			if (module_on || psize != sizeof(u32) || get_unaligned_le32(p) != 1)
+				return -EINVAL;
+			module_on = true;
+			break;
+		case PARAM_ID_MSIIR_TUNING_FILTER_ENABLE:
