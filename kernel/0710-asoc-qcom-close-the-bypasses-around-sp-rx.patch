+/*
+ * Parameters the kernel sets itself. Where SP is required a blob may not set
+ * them, so it cannot override what the configuration pass checked.
+ */
+static bool audioreach_sp_kernel_owned(u32 pid)
+{
+	switch (pid) {
+	case PARAM_ID_SP_OP_MODE:
+	case 0x08001b40:			/* SP RX operation mode, v2 */
+	case PARAM_ID_SP_VI_OP_MODE_CFG:
+	case PARAM_ID_SP_TH_VI_R0T0_CFG:
+	case 0x080011f9:			/* TH VI factory test mode */
+	case 0x080011fb:			/* TH VI validation mode */
+	case PARAM_ID_SP_VI_EX_MODE_CFG:
+	case 0x08001200:			/* EX VI factory test mode */
+		return true;
+	}
+	return false;
+}
+
+/* The first kernel-owned parameter in packed records, 0 if none */
+static u32 audioreach_sp_blob_kernel_pid(const u8 *packed, u32 total)
+{
+	u32 pos = 0;
+
+	while (pos + APM_MODULE_PARAM_DATA_SIZE <= total) {
+		const struct apm_module_param_data *pd = (const void *)(packed + pos);
+
+		if (audioreach_sp_kernel_owned(pd->param_id))
+			return pd->param_id;
+		pos += APM_MODULE_PARAM_DATA_SIZE + ALIGN(pd->param_size, 8);
+	}
+
+	return 0;
+}
