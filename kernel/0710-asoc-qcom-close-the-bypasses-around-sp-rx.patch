+/*
+ * Each speaker reaches this MSIIR under its codec DMA lane's channel type.
+ * When the machine driver lists speakers that need the high-pass (the
+ * tweeters), the blob must high-pass exactly those; with no list the filter
+ * is only reported.
+ */
+static int audioreach_sp_rx_hpf(struct q6apm_graph *graph,
+				const struct audioreach_module *module,
+				const struct audioreach_module_config *cfg)
+{
+	char name[MAX_SP_VI_SPEAKERS][32];
+	u8 lane[MAX_SP_VI_SPEAKERS];
+	u32 need = READ_ONCE(sp_hpf_speakers);
+	unsigned int s, n = cfg->num_channels;
+	u64 mask;
+	int rc;
+
+	if (n > MAX_SP_VI_SPEAKERS || audioreach_sp_get_lanes(lane, name, n)) {
+		dev_err(graph->dev, "SP HPF: no speaker lane map for %u speakers\n", n);
+		return -EINVAL;
+	}
+	if (need & ~GENMASK(n - 1, 0)) {
+		dev_err(graph->dev, "SP HPF: speakers 0x%x not in this %u-speaker graph\n",
+			need, n);
+		return -EINVAL;
+	}
+	if (cfg->sample_rate != 48000) {
+		dev_err(graph->dev, "SP HPF: checked at 48 kHz only, not %u Hz\n",
+			cfg->sample_rate);
+		return -EINVAL;
+	}
+
+	if (audioreach_msiir_hpf_scan(module, &mask)) {
+		dev_err(graph->dev, "SP HPF: MSIIR 0x%x cfg blob missing, malformed or not a high-pass\n",
+			module->instance_id);
+		return -EINVAL;
+	}
+
+	for (s = 0; s < n; s++) {
+		u8 type = cfg->channel_map[lane[s]];
+		bool filtered = type && type < 64 && (mask & BIT_ULL(type));
+
+		if (need && !!(need & BIT(s)) != filtered) {
+			dev_err(graph->dev, "SP HPF: speaker %u %s (lane %u, channel type %u) is %s\n",
+				s, name[s], lane[s], type,
+				filtered ? "high-passed but not listed" :
+					   "listed but not high-passed");
+			return -EINVAL;
+		}
+		dev_info(graph->dev, "SP HPF speaker %u %s: lane %u, channel type %u, %s\n",
+			 s, name[s], lane[s], type, filtered ? "high-passed" : "full band");
+	}
+
+	rc = audioreach_speaker_protection_send_static_cfg(graph, module, "SP HPF");
+	if (!rc)
+		rc = audioreach_module_enable(graph, module, true);
+	if (rc) {
+		dev_err(graph->dev, "SP HPF setup failed: %d\n", rc);
+		return rc;
+	}
+
+	return audioreach_sp_session_note_hpf(graph->dev, false, module->instance_id);
 }
 
